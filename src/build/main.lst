4068+ 5EDA              ; --- CORREGIDO (el comentario historico "tabla de tipo de loseta
4069+ 5EDA              ; compartida $8E88" era una hipotesis antigua equivocada -- no existe
4070+ 5EDA              ; tal tabla en esa direccion): limpia (RES 7) las 72 posiciones de
4071+ 5EDA              ; TABLA_CODIGOS_TECLA (bit 7 = marca "tecla usada" superpuesta a su
4072+ 5EDA              ; contenido normal) y reinicia PUNTERO_ESCRITURA_TECLA al
4073+ 5EDA              ; INICIO de TABLA_TECLAS_MSX (madmix1_body.asm) -- HALLAZGO: no es un
4074+ 5EDA              ; buffer scratch, es el DESTINO REAL de la redefinicion: hay
4075+ 5EDA              ; exactamente 6 acciones redefinibles = 6 pares fila/mascara = 12
4076+ 5EDA              ; bytes = el tamano exacto de TABLA_TECLAS_MSX, asi que el submenu
4077+ 5EDA              ; sobreescribe en caliente la tabla que usa LEER_TECLADO. ---
4078+ 5EDA              REINICIAR_TECLAS_USADAS:                     ; $5EDA
4079+ 5EDA 21 88 8E         LD HL, TABLA_TECLAS_MSX     ; puntero de escritura: el propio inicio de la tabla real de control
4080+ 5EDD 22 74 5F         LD (PUNTERO_ESCRITURA_TECLA), HL
4081+ 5EE0 21 2C 5F         LD HL, TABLA_CODIGOS_TECLA  ; 72 entradas, bit 7 = "tecla usada"
4082+ 5EE3 06 48            LD B, 72                    ; 72 entradas a limpiar
4083+ 5EE5              .BUCLE_LIMPIAR_MARCAS:
4084+ 5EE5 CB BE            RES 7, (HL)
4085+ 5EE7 23               INC HL
4086+ 5EE8 10 FB            DJNZ .BUCLE_LIMPIAR_MARCAS
4087+ 5EEA C9               RET
4088+ 5EEB
4089+ 5EEB              ; --- Recorre el teclado (matriz $AA/$A9, filas $F0-$F8) buscando la
4090+ 5EEB              ; primera tecla NUEVA pulsada (bit7 de su entrada en TABLA_CODIGOS_TECLA
4091+ 5EEB              ; a 0): escribe el par fila/mascara real en TABLA_TECLAS_MSX (via
4092+ 5EEB              ; PUNTERO_ESCRITURA_TECLA, ver REINICIAR_TECLAS_USADAS), marca la
4093+ 5EEB              ; entrada como usada y guarda su valor (codigo de caracter o
4094+ 5EEB              ; especial) en CODIGO_TECLA_ACTUAL. ---
4095+ 5EEB              ESPERAR_TECLA_NUEVA:                    ; $5EEB
4096+ 5EEB 2A 74 5F         LD HL, (PUNTERO_ESCRITURA_TECLA)
