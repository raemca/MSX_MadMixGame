 396+ 2CA0
 397+ 2CA0              ; ==============================================================
 398+ 2CA0              ;  MOTOR DE COLISION/MOVIMIENTO (0x2CA0-0x335C) -- el "bucle
 399+ 2CA0              ;  principal" del juego. Despachador de 16 entradas segun el tipo
 400+ 2CA0              ;  de loseta hacia la que se mueve el comecocos (tabla de punteros
 401+ 2CA0              ;  en 0x2E3C), con un manejador dedicado por tipo: flechas (fuerzan
 402+ 2CA0              ;  direccion), varios tipos de pared/pasillo (marcan loseta
 403+ 2CA0              ;  "comida", activan HUD, llaman a los 2 manejadores de item
 404+ 2CA0              ;  especial de 0x5478-0x5904 y a MOTOR_ACTORES), pista de tanque/avion
 405+ 2CA0              ;  (itera la tabla de posiciones activas en $2C2E) y un manejador de "tipo
 406+ 2CA0              ;  9" que hace un bucle de 12 llamadas a MOTOR_ACTORES (candidato a
 407+ 2CA0              ;  "bola de poder comida -> todos los fantasmas vulnerables a la
 408+ 2CA0              ;  vez"). Las etiquetas internas (antes ML_XXXX = direccion real en
 409+ 2CA0              ;  hex) se renombraron a nombres descriptivos -- ver FINDINGS.md para
 410+ 2CA0              ;  el mapeo completo nombre nuevo -> direccion original, util para
 411+ 2CA0              ;  cruzar con el desensamblado.
 412+ 2CA0              ; ==============================================================
 413+ 2CA0              ; --- Decide la direccion a usar este frame (B) y la deja en ($2C10)
 414+ 2CA0              ; para el resto del motor: si el ciclador de niveles de muestra esta
 415+ 2CA0              ; activo ((INDICE_CICLO_NIVELES)!=0, ver GESTIONAR_CICLO_NIVELES) usa la direccion ya
 416+ 2CA0              ; precalculada en D (guion de demo); si no, lee input real
 417+ 2CA0              ; (LEER_ENTRADA, $8E3C). ---
 418+ 2CA0              MOTOR_MOVIMIENTO_COLISION:
 419+ 2CA0 3A 10 2C         LD A, (DIRECCION_DE_MOVIMIENTO)          ; direccion del frame anterior (se restaura mas
 420+ 2CA3 F5               PUSH AF                  ; abajo con POP BC si el chequeo de loseta falla)
 421+ 2CA4 3A CA 60         LD A, (INDICE_CICLO_NIVELES)
 422+ 2CA7 A7               AND A
 423+ 2CA8 28 03            JR Z, SALTAR_A_LEER_ENTRADA            ; modo normal -> lee input de verdad
 424+ 2CAA 7A               LD A, D                    ; modo demo/ciclador -> usa la direccion del guion
 425+ 2CAB 18 03            JR PROCESAR_DIRECCION
 426+ 2CAD              SALTAR_A_LEER_ENTRADA:
 427+ 2CAD CD 3C 8E         CALL LEER_ENTRADA               ; JT_LEER_ENTRADA (colision) = LEER_ENTRADA: A = bitmask de direccion
 428+ 2CB0              PROCESAR_DIRECCION:
 429+ 2CB0 32 15 2C         LD (DIRECCION_SIN_PROCESAR), A             ; guarda la direccion "cruda" de este frame
 430+ 2CB3 47               LD B, A                    ; B = direccion cruda (fallback si la nueva no es valida)
 431+ 2CB4 E6 10            AND $10                     ; bit 4: candidato a "hay input de direccion" (0=no)
 432+ 2CB6 21 1C 2C         LD HL, FLAG_DIRECCION_NUEVA
 433+ 2CB9 0E 00            LD C, 0
 434+ 2CBB 28 09            JR Z, LIMPIAR_FLAG_DIRECCION              ; sin input nuevo -> C=0 (fuerza mantener direccion previa mas abajo)
 435+ 2CBD 7E               LD A, (HL)
 436+ 2CBE A7               AND A
 437+ 2CBF 20 07            JR NZ, COPIAR_FLAG_DIRECCION              ; ($2C1C) ya estaba a 1 -> lo deja igual, solo actualiza ($2C1D)
 438+ 2CC1 0E 01            LD C, 1
 439+ 2CC3 71               LD (HL), C                   ; primera vez que se detecta input tras soltar -> arma el flag ($2C1C)=1
 440+ 2CC4 18 02            JR COPIAR_FLAG_DIRECCION
 441+ 2CC6              LIMPIAR_FLAG_DIRECCION:
 442+ 2CC6 36 00            LD (HL), 0                  ; sin input -> desarma el flag ($2C1C)
 443+ 2CC8              COPIAR_FLAG_DIRECCION:
 444+ 2CC8 23               INC HL
 445+ 2CC9 71               LD (HL), C                     ; ($2C1D) = copia del flag de arriba (candidato: "flanco de pulsacion",
 446+ 2CCA                                                   ; usado mas abajo para decidir si se acepta la nueva direccion)
 447+ 2CCA 78               LD A, B
 448+ 2CCB ED 4B 16 2C      LD BC, (POSICION_ACTUAL_CAMARA)                    ; posicion de camara actual
 449+ 2CCF CD B6 8C         CALL MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA                          ; MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA: HL=direccion VRAM, A=offset dentro de loseta
 450+ 2CD2 C1               POP BC                                ; recupera direccion del frame anterior (guardada al entrar)
 451+ 2CD3 E6 0F            AND $0F
 452+ 2CD5 4F               LD C, A                                ; C = alineamiento sub-loseta actual (0-15)
 453+ 2CD6 3A 1A 2C         LD A, (DIRECCION_FORZADA)                            ; override de "direccion sticky" (activado por CONSULTAR_LOSETA_LIBRE_DIRECCION/
 454+ 2CD9 A7               AND A                                      ; los manejadores de flecha -- fuerza una mascara concreta
 455+ 2CDA 28 01            JR Z, CALCULAR_MASCARA_ALINEAMIENTO                               ; en vez de la calculada por alineamiento real)
 456+ 2CDC 4F               LD C, A
 457+ 2CDD              CALCULAR_MASCARA_ALINEAMIENTO:
 458+ 2CDD D5               PUSH DE                                       ; DE = direccion candidata (bitmask) que se esta evaluando
 459+ 2CDE 7B               LD A, E
 460+ 2CDF 1E 0F            LD E, $0F
 461+ 2CE1 E6 03            AND $03
 462+ 2CE3 28 02            JR Z, COMPROBAR_ALINEAMIENTO_Y                                  ; alineado en X (E&3=0) -> mascara completa en ese eje
 463+ 2CE5 1E 03            LD E, $03                                        ; no alineado en X -> solo se permite seguir en X
 464+ 2CE7              COMPROBAR_ALINEAMIENTO_Y:
 465+ 2CE7 7A               LD A, D
 466+ 2CE8 E6 03            AND $03
 467+ 2CEA 28 02            JR Z, APLICAR_MASCARA_ALINEAMIENTO                                     ; alineado en Y -> nada que restringir por Y
 468+ 2CEC 1E 0C            LD E, $0C                                           ; no alineado en Y -> solo se permite seguir en Y
 469+ 2CEE                                                                        ; (si tampoco estaba alineado en X, esta linea
 470+ 2CEE                                                                        ; pisa la mascara de arriba: da prioridad al eje Y)
 471+ 2CEE              APLICAR_MASCARA_ALINEAMIENTO:
 472+ 2CEE 79               LD A, C
 473+ 2CEF A3               AND E                                                 ; aplica la mascara de alineamiento a la direccion candidata
 474+ 2CF0 20 01            JR NZ, FIJAR_DIRECCION_FINAL                                          ; sigue siendo valida -> se queda con ella
 475+ 2CF2 78               LD A, B                                                   ; invalida (giro no permitido aqui) -> vuelve a la
 476+ 2CF3                                                                              ; direccion del frame anterior (B)
 477+ 2CF3              FIJAR_DIRECCION_FINAL:
 478+ 2CF3 4F               LD C, A
 479+ 2CF4 32 10 2C         LD (DIRECCION_DE_MOVIMIENTO), A                                              ; direccion final de este frame, ya decidida
 480+ 2CF7 CD 64 2E         CALL CONSULTAR_PROXIMA_LOSETA_EN_ESTA_DIRECCION        ; $2E64 -- consulta el TIPO de loseta un paso mas alla en esa direccion
 481+ 2CFA 20 08            JR NZ, CALCULAR_INDICE_TIPO_LOSETA                ; tipo especial (!=0) detectado con la direccion elegida -> sigue
 482+ 2CFC 78               LD A, B                        ; tipo=0 (sin efecto especial: pasillo/pared normal, ver tabla de
 483+ 2CFD 4F               LD C, A                          ; tipos) -> repite la consulta con la direccion del frame anterior
 484+ 2CFE 32 10 2C         LD (DIRECCION_DE_MOVIMIENTO), A                     ; (B) por si esa SI acierta con una loseta especial (el tipo real
 485+ 2D01 CD 64 2E         CALL CONSULTAR_PROXIMA_LOSETA_EN_ESTA_DIRECCION        ; $2E64  de bloqueo/paso libre no se decide aqui, ver nota mas abajo)
 486+ 2D04              CALCULAR_INDICE_TIPO_LOSETA:
 487+ 2D04 87               ADD A, A                  ; A = tipo*2 (indice de palabra en TABLA_MANEJADORES_LOSETA)
 488+ 2D05 E5               PUSH HL                     ; guarda direccion VRAM de MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA
 489+ 2D06 6F               LD L, A
 490+ 2D07 3A 0F 2C         LD A, (MODO_ESPECIAL_ACTIVO)                ; temporizador de "modo especial" activo (mismo que consulta
 491+ 2D0A A7               AND A                          ; BUCLE_PRINCIPAL_JUEGO en madmix1.asm) -- si esta a 0, se usa el tipo real
 492+ 2D0B 28 02            JR Z, OBTENER_MANEJADOR_LOSETA                   ; calculado arriba; si no, se fuerza tipo 0 (sin efecto) abajo,
 493+ 2D0D 2E 00            LD L, $00                        ; porque mientras dura un modo especial (bola de poder/hipopotamo/
 494+ 2D0F                                                     ; etc.) el dispatch normal de loseta queda suspendido
 495+ 2D0F              OBTENER_MANEJADOR_LOSETA:
 496+ 2D0F 7D               LD A, L
 497+ 2D10 21 3C 2E         LD HL, TABLA_MANEJADORES_LOSETA     ; $2E3C
 498+ 2D13 85               ADD A, L
 499+ 2D14 6F               LD L, A
 500+ 2D15 7C               LD A, H
 501+ 2D16 CE 00            ADC A, $00
 502+ 2D18 67               LD H, A
 503+ 2D19 5E               LD E, (HL)
 504+ 2D1A 23               INC HL
 505+ 2D1B 56               LD D, (HL)
 506+ 2D1C D5               PUSH DE
 507+ 2D1D DD E1            POP IX                    ; IX = manejador real (o HNDLR_SUELO_NORMAL/no-op si el modo especial lo forzo)
 508+ 2D1F 79               LD A, C
 509+ 2D20 E6 0F            AND $0F
 510+ 2D22 41               LD B, C
 511+ 2D23 21 38 2C         LD HL, TABLA_CLASE_ALINEAMIENTO  ; RESUELTO: clasifica la posicion sub-loseta (nibble bajo de
 512+ 2D26 85               ADD A, L                      ; la direccion) en 5 clases (0-4); C alimenta despues
 513+ 2D27 6F               LD L, A                        ; BUCLE_SUBTABLA_DIRECCION (selector de sprite del comecocos)
 514+ 2D28 4E               LD C, (HL)
