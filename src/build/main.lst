2285+ 545F              ; --- MAPEAR_COORDENADA_A_DIRECCION ($545F) -- CONFIRMADO: formula identica a
2286+ 545F              ; MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA del motor principal (fila*32+columna, base de
2287+ 545F              ; buffer de nivel), aplicada aqui a BC en vez de a la posicion de
2288+ 545F              ; camara. Va ANTES del cargador de nivel en memoria real
2289+ 545F              ; (0x545F < 0x5904), por eso se transcribe aqui y no despues.
2290+ 545F              ;
2291+ 545F              ; BUG CORREGIDO (ver madmix1.asm MAPEAR_LOSETA_A_GRAFICO y FINDINGS.md): la
2292+ 545F              ; v1.0 original tenia $FC60 aqui -- uno de los 5 sitios del bug del
2293+ 545F              ; contador de bolitas del nivel 13. Fix de la v2.0 aplicado:
2294+ 545F              ; $FC60 -> $FC50. ---
2295+ 545F              MAPEAR_COORDENADA_A_DIRECCION:
2296+ 545F 78               LD A, B
2297+ 5460 E6 7C            AND $7C
2298+ 5462 0F               RRCA
2299+ 5463 0F               RRCA
2300+ 5464 47               LD B, A
2301+ 5465 79               LD A, C
2302+ 5466 E6 7C            AND $7C
2303+ 5468 07               RLCA
2304+ 5469 CB 18            RR B
2305+ 546B 1F               RRA
2306+ 546C CB 18            RR B
2307+ 546E 1F               RRA
2308+ 546F CB 18            RR B
2309+ 5471 1F               RRA
2310+ 5472 4F               LD C, A
2311+ 5473 21 50 FC         LD HL, $FC50            ; BUG CORREGIDO: $FC60 en la v1.0 original, ver comentario arriba
2312+ 5476 09               ADD HL, BC
2313+ 5477 C9               RET
2314+ 5478
2315+ 5478              ; ==============================================================
2316+ 5478              ;  SUBSISTEMA DE ACTIVACION DE ITEMS ESPECIALES (0x5478-0x5904)
2317+ 5478              ;  Desensamblado completo con Z80Dasm (sin desincronizar en ningun
2318+ 5478              ;  punto -- todo el rango es codigo+datos coherentes, conectados
2319+ 5478              ;  por CALL/JP reales). Documentado primero en sesion anterior (ver
2320+ 5478              ;  FINDINGS.md), transcrito aqui. Dos instancias casi identicas de
2321+ 5478              ;  un manejador (una por tipo de item), cada una con: contador de
2322+ 5478              ;  entradas leido de un offset del registro de nivel, tabla de
2323+ 5478              ;  posiciones activas, tabla de frames de animacion, y la logica
2324+ 5478              ;  de activacion (llama a MOTOR_ACTORES en $8440 al detectar
2325+ 5478              ;  coincidencia de posicion).
2326+ 5478              ; ==============================================================
2327+ 5478
2328+ 5478              GENERAR_ALEATORIO:                          ; $5478 -- generador pseudoaleatorio
2329+ 5478 E5               PUSH HL
2330+ 5479 2A 22 2C         LD HL, (SEMILLA_ALEATORIA)
2331+ 547C ED 5F            LD A, R
2332+ 547E 0F               RRCA
2333+ 547F 8D               ADC A, L
2334+ 5480 AE               XOR (HL)
2335+ 5481 6F               LD L, A
2336+ 5482 22 22 2C         LD (SEMILLA_ALEATORIA), HL
2337+ 5485 E1               POP HL
2338+ 5486 C9               RET
2339+ 5487
2340+ 5487              ; --- TABLA_ANIMACION_MARICOCO: 20 bytes, mismo mecanismo confirmado que
2341+ 5487              ; TABLA_ANIMACION_PELMAZOIDE (indexada por HNDLR_MARICOCO como
2342+ 5487              ; direccion(1-4)*4+fase(0-3)) pero SIN autorreferencia -- tabla
2343+ 5487              ; directa, sin puntero previo. Offset 0-3 nunca se lee (direccion
2344+ 5487              ; nunca vale 0). Un unico sprite fijo por direccion (sin animacion de
2345+ 5487              ; 2 fotogramas como en TABLA_ANIMACION_PELMAZOIDE): derecha=$27,
2346+ 5487              ; izquierda=$A7 ($27 con bit7, volteo horizontal -- mismo patron,
2347+ 5487              ; reutiliza el sprite de la derecha), abajo=$25, arriba=$26. ---
2348+ 5487              TABLA_ANIMACION_MARICOCO:                 ; $5487
2349+ 5487 27 27 27 27      DB $27,$27,$27,$27               ; offset 0-3: nunca se lee (direccion nunca vale 0)
2350+ 548B 27 27 27 27      DB $27,$27,$27,$27               ; offset 4-7: DERECHA (direccion=1)
2351+ 548F A7 A7 A7 A7      DB $A7,$A7,$A7,$A7               ; offset 8-11: IZQUIERDA (direccion=2) -- $27 con bit7
2352+ 5493 25 25 25 25      DB $25,$25,$25,$25               ; offset 12-15: ABAJO (direccion=3)
2353+ 5497 26 26 26 26      DB $26,$26,$26,$26               ; offset 16-19: ARRIBA (direccion=4)
2354+ 549B
2355+ 549B              TABLA_ITEMS_MARICOCO:                      ; $549B -- tabla activa tipo 1 (2 entradas x 7 bytes,
2356+ 549B                  ; formato [X,Y,modo/plantado,dir,subX,subY,fase], mismo que
2357+ 549B                  ; TABLA_ITEMS_PELMAZOIDE/TABLA_ITEMS_REGPUNANTOSO -- valores de
2358+ 549B                  ; compilacion, se reinicializan en INICIALIZAR_ITEMS_NIVEL)
2359+ 549B 20 10 01 01      DB 32,16,1,1,0,0,1  ; X,Y=semilla(sobrescrita) modo/plantado=1 dir=1 subX,subY=0 fase=1
2359+ 549F 00 00 01
2360+ 54A2 20 10 01 01      DB 32,16,1,1,0,0,1
2360+ 54A6 00 00 01
2361+ 54A9
2362+ 54A9              ; --- Manejador tipo 1 = MARIQUITA (CONFIRMADO: sprites $27/$25/$26 =
2363+ 54A9              ; SPR39_MARIQUITA_DER/SPR37_MARIQUITA_ABAJO/SPR38_MARIQUITA_ARRIBA del
2364+ 54A9              ; catalogo ya identificado por el usuario -- coincide con "mariquita
2365+ 54A9              ; reponia bolas" ya documentado). El contador de entradas (B) sale de
2366+ 54A9              ; ($2BFC) = offset 9 del registro de nivel copiado a RAM de trabajo
2367+ 54A9              ; (candidato fuerte: "numero de items tipo 1 en este nivel"). Por cada
2368+ 54A9              ; entrada activa: si su posicion y la de la camara estan ambas
2369+ 54A9              ; alineadas a loseta, comprueba si la loseta que hay debajo (tras
2370+ 54A9              ; limpiar el bit 7 "comida") es una de suelo_sin_bola_1/2/3 (indices
2371+ 54A9              ; 63-65 = bolita ya comida) -- candidato fuerte a "aparecer solo sobre
2372+ 54A9              ; huecos de bolitas ya comidas" (bonus tipo fruta de Pac-Man). Con
2373+ 54A9              ; MOTOR_MOVIMIENTO_ITEM valida la posicion/direccion, dibuja el item con
2374+ 54A9              ; MOTOR_ACTORES, y fija (IX+2)=1 -- lo que a partir de ahi hace que
2375+ 54A9              ; MOTOR_MOVIMIENTO_ITEM/CONSULTAR_LOSETA_LIBRE_DIRECCION dejen de recalcularle direccion (queda
2376+ 54A9              ; "plantado" en su sitio en vez de perseguir nada). Si el item esta
2377+ 54A9              ; visible en camara Y estaba sobre una loseta ya comida, decrementa el
2378+ 54A9              ; contador de fin de nivel ($2C08) y encola un efecto via APILAR_PETICION_REDIBUJADO. ---
2379+ 54A9              HNDLR_MARICOCO:
2380+ 54A9 3A FC 2B         LD A, (REGISTRO_NIVEL_CONTADOR_MARICOCOS)
2381+ 54AC A7               AND A
2382+ 54AD C8               RET Z
2383+ 54AE 47               LD B, A
2384+ 54AF DD 21 9B 54      LD IX, TABLA_ITEMS_MARICOCO
2385+ 54B3              BUCLE_MARICOCO:
2386+ 54B3 C5               PUSH BC
