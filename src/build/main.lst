1135+ 8961              ;  0x8961-0x899F -- CONFIRMADO byte a byte (llenaba un hueco DS),
1136+ 8961              ;  y RE-CONFIRMADO contra el volcado de RAM en vivo en su
1137+ 8961              ;  direccion ESTATICA (ver FINDINGS.md). Rellena EXACTO hasta
1138+ 8961              ;  WAIT_VBLANK (0x89A0), sin ningun resto.
1139+ 8961              ; --------------------------------------------------------------
1140+ 8961
1141+ 8961              ; CONSULTAR_COLOR_VDP: A = valor con datos en bits 3-6 -> extrae esos
1142+ 8961              ; 4 bits (AND $78 + RRCA x3, equivale a (A AND $78) rotado a bits
1143+ 8961              ; 0-3), los usa como indice 0-15 en TABLA_COLORES_VDP, y devuelve en A
1144+ 8961              ; el valor de tabla OR $10. RESUELTO (ver OBTENER_COLOR_VDP,
1145+ 8961              ; madmix_scr_body.asm, mismo mecanismo componiendo 2 consultas): la
1146+ 8961              ; tabla NO son bits de direccion (hipotesis anterior descartada), son
1147+ 8961              ; 16 colores VDP (0-15) -- esta version simple devuelve solo el color
1148+ 8961              ; de fondo (nibble bajo) de un byte de color SCREEN2, con el bit 4
1149+ 8961              ; forzado via OR $10.
1150+ 8961              CONSULTAR_COLOR_VDP:
1151+ 8961 21 78 89         LD HL, TABLA_COLORES_VDP
1152+ 8964 E6 78            AND $78                ; aisla los 4 bits de indice de color (bits 3-6)
1153+ 8966 0F               RRCA
1154+ 8967 0F               RRCA
1155+ 8968 0F               RRCA                    ; los rota a bits 0-3 (indice 0-15 dentro de la tabla)
1156+ 8969 85               ADD A, L
1157+ 896A 6F               LD L, A
1158+ 896B 7C               LD A, H
1159+ 896C CE 00            ADC A, $00               ; propaga el acarreo del ADD anterior hacia H
1160+ 896E 67               LD H, A
1161+ 896F 7E               LD A, (HL)
1162+ 8970 F6 10            OR $10                    ; fuerza el bit 4 del resultado (ver cabecera de la rutina)
1163+ 8972 C9               RET
1164+ 8973
1165+ 8973 00 00 00 00      DB $00, $00, $00, $00, $00      ; 5 bytes ($8973-$8977) sin consumidor conocido (sin JP/CALL/aritmetica de etiqueta que los referencie) -- HIPOTESIS: relleno de alineacion, ya que TABLA_COLORES_VDP arranca justo despues en $8978, multiplo exacto de 8
1165+ 8977 00
