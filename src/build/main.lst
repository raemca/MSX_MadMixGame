1701+ 511C              ; ==============================================================
1702+ 511C              ;  ZONA $511C-$545F: tabla de tipos de item + tablas auxiliares +
1703+ 511C              ;  la rutina HNDLR_PELMAZOIDE (llamada desde el bucle principal) + los dos
1704+ 511C              ;  helpers $5278/$53A2 que faltaban del subsistema de activacion
1705+ 511C              ;  de items (llamados desde HNDLR_MARICOCO/HNDLR_REGPUNANTOSO e ACTUALIZAR_DESTELLO_ITEMS).
1706+ 511C              ;  Desensamblado completo con Z80Dasm, sin desincronizar en ningun
1707+ 511C              ;  punto desde HNDLR_PELMAZOIDE hasta el RET final en $545E (justo antes de
1708+ 511C              ;  MAPEAR_COORDENADA_A_DIRECCION en $545F).
1709+ 511C              ; ==============================================================
1710+ 511C
1711+ 511C              ; --- TABLA_ITEMS_PELMAZOIDE: tabla activa de items TIPO 3 (8 entradas de
1712+ 511C              ; 7 bytes -- estructura CONFIRMADA identica, cruzando MOTOR_MOVIMIENTO_ITEM/
1713+ 511C              ; CALCULAR_POSICION_VRAM_ITEM/INICIALIZAR_ITEMS_NIVEL, a TABLA_ITEMS_MARICOCO/TABLA_ITEMS_REGPUNANTOSO mas abajo en
1714+ 511C              ; este mismo fichero):
1715+ 511C              ;   offset 0: posicion X (loseta entera)
1716+ 511C              ;   offset 1: posicion Y (loseta entera)
1717+ 511C              ;   offset 2: modo/comportamiento -- 0 = persiguiendo activamente
1718+ 511C              ;             (UNICO valor real usado por items tipo 3, ver
1719+ 511C              ;             TABLA_ANIMACION_PELMAZOIDE mas abajo); 1/2 = "plantado", solo
1720+ 511C              ;             usados por TABLA_ITEMS_MARICOCO/TABLA_ITEMS_REGPUNANTOSO respectivamente,
1721+ 511C              ;             NUNCA por esta tabla (INICIALIZAR_ITEMS_NIVEL no lo toca -- se queda
1722+ 511C              ;             siempre a 0)
1723+ 511C              ;   offset 3: codigo de direccion de movimiento en curso (1/2/3/4 =
1724+ 511C              ;             derecha/izquierda/abajo/arriba, 0 = ninguna)
1725+ 511C              ;   offset 4: subposicion X (parte fraccional del movimiento paso a paso)
1726+ 511C              ;   offset 5: subposicion Y (parte fraccional)
1727+ 511C              ;   offset 6: fase de animacion (0-3, rotativa -- incrementada cada vez
1728+ 511C              ;             que HNDLR_PELMAZOIDE procesa esta entrada). CORRECCION de una
1729+ 511C              ;             ronda anterior: esto NO es un "tipo de item 0-3", es
1730+ 511C              ;             simplemente la fase de animacion inicial de cada
1731+ 511C              ;             entrada (para que los 8 items no animen sincronizados)
1732+ 511C              ; INICIALIZAR_ITEMS_NIVEL reinicializa cada nivel SOLO los offsets 0/1/4/5
1733+ 511C              ; (posicion), dejando intactos modo/direccion/fase -- los valores de
1734+ 511C              ; posicion de compilacion de abajo (X=$10 o $20, Y=$10 siempre) se
1735+ 511C              ; sobrescriben siempre, sin efecto real. ---
1736+ 511C              TABLA_ITEMS_PELMAZOIDE:                ; $511C
1737+ 511C 20 10 00 01      DB $20,$10,$00,$01,$00,$00,$01  ; X,Y=semilla(sobrescrita) modo=0 dir=1 subX,subY=0 fase=1
1737+ 5120 00 00 01
1738+ 5123 10 10 00 01      DB $10,$10,$00,$01,$00,$00,$02  ; fase=2
1738+ 5127 00 00 02
1739+ 512A 10 10 00 01      DB $10,$10,$00,$01,$00,$00,$03  ; fase=3
1739+ 512E 00 00 03
1740+ 5131 10 10 00 01      DB $10,$10,$00,$01,$00,$00,$01  ; fase=1
1740+ 5135 00 00 01
1741+ 5138 10 10 00 01      DB $10,$10,$00,$01,$00,$00,$02  ; fase=2
1741+ 513C 00 00 02
1742+ 513F 10 10 00 01      DB $10,$10,$00,$01,$00,$00,$01  ; fase=1
1742+ 5143 00 00 01
1743+ 5146 10 10 00 01      DB $10,$10,$00,$01,$00,$00,$00  ; fase=0
1743+ 514A 00 00 00
1744+ 514D 10 10 00 01      DB $10,$10,$00,$01,$00,$00,$01  ; fase=1
1744+ 5151 00 00 01
1745+ 5154
1746+ 5154              ; --- $5154-$51FD (170 bytes): 2 tablas auxiliares + un hueco sin
1747+ 5154              ; explicar entre ambas, consultadas por MOTOR_MOVIMIENTO_ITEM/HNDLR_PELMAZOIDE al
1748+ 5154              ; mover items tipo 3.
1749+ 5154              ;
1750+ 5154              ; TABLA_ANIMACION_PELMAZOIDE ($5154, 32 bytes): RESUELTA POR COMPLETO.
1751+ 5154              ; HNDLR_PELMAZOIDE la indexa con "((IX+2) AND $0F)*2" (offset2 de
1752+ 5154              ; TABLA_ITEMS_PELMAZOIDE es siempre 0 en la practica, unico valor real
1753+ 5154              ; usado -- ver arriba), obtiene DE = palabra 0 = $5156 -- un puntero
1754+ 5154              ; AUTORREFERENCIAL real, no un accidente: apunta 2 bytes mas adelante,
1755+ 5154              ; DENTRO de esta misma tabla. Luego calcula
1756+ 5154              ; direccion(1-4, codigo compacto que devuelve MOTOR_MOVIMIENTO_ITEM)*4+fase(0-3)
1757+ 5154              ; y lo SUMA a DE para leer el sprite final. Es decir: esta tabla NO es
1758+ 5154              ; "16 punteros, uno por modo" -- es UN puntero a si misma seguido de
1759+ 5154              ; los datos reales de sprite (4 direcciones x 2 fotogramas), mismo
1760+ 5154              ; mecanismo (confirmado identico) que usa TABLA_ANIMACION_MARICOCO de
1761+ 5154              ; HNDLR_MARICOCO mas abajo (esa sin autorreferencia, tabla aparte).
1762+ 5154              ;
1763+ 5154              ; CONFIRMA EL VOLTEO HORIZONTAL (bit7) SIN TRAZADO EN VIVO: el grupo
1764+ 5154              ; "izquierda" ($9B,$9C) es EXACTAMENTE el grupo "derecha" ($1B,$1C)
1765+ 5154              ; con el bit7 puesto -- no existe sprite propio para la izquierda, se
1766+ 5154              ; reutiliza el de la derecha reflejado (ver "AND $80" tras leer el
1767+ 5154              ; byte, en HNDLR_PELMAZOIDE). Mismo fenomeno ya documentado para los
1768+ 5154              ; sprites de personajes (antes "candidato, aparcado, requiere trazado
1769+ 5154              ; en vivo") -- aqui queda confirmado por simple analisis estatico.
1770+ 5154              ;
1771+ 5154              ; IDENTIDAD CONFIRMADA: $1B/$1C/$1D/$1E/$1F/$20 = SPR27_FANTASMA_DER_1,
1772+ 5154              ; SPR28_FANTASMA_DER_2, SPR29_FANTASMA_ABAJO_1, SPR30_FANTASMA_ABAJO_2,
1773+ 5154              ; SPR31_FANTASMA_ARRIBA_1, SPR32_FANTASMA_ARRIBA_2 del catalogo ya
1774+ 5154              ; identificado por el usuario (madmix1_body.asm) -- TABLA_ITEMS_PELMAZOIDE/
1775+ 5154              ; HNDLR_PELMAZOIDE es la IA de movimiento de los fantasmas del juego.
1776+ 5154              ;
1777+ 5154              ; Cola de 20 bytes SIN CONSUMIDOR CONOCIDO: los ultimos 10 bytes de
1778+ 5154              ; esta tabla (offset 22-31, direccion*4+fase nunca llega ahi -- maximo
1779+ 5154              ; indice real es offset 21) mas los 10 bytes siguientes ($5174-$517D,
1780+ 5154              ; `$A2,$A2,$23,$23,$24,$24,$1F,$1F,$20,$20`). Candidatos a DATOS DE
1781+ 5154              ; SPRITE HUERFANOS, no a codigo: se probo desensamblar estos ultimos
1782+ 5154              ; 10 bytes como Z80 (decodifican completos, sin instruccion a medias,
1783+ 5154              ; en `AND D`/`AND D`/`INC HL`/`INC HL`/`INC H`/`INC H`/`RRA`/`RRA`/
1784+ 5154              ; `JR NZ,+32`) pero la secuencia no tiene ningun sentido funcional
1785+ 5154              ; (instrucciones duplicadas seguidas sin proposito, a diferencia del
1786+ 5154              ; codigo muerto real ya confirmado en este proyecto). En cambio, SI
1787+ 5154              ; encajan con la convencion de "pares de bytes repetidos = 2
1788+ 5154              ; fotogramas" que usan `TABLA_ANIMACION_PELMAZOIDE`/`TABLA_ANIMACION_MARICOCO`/`TABLA_ANIMACION_REGPUNANTOSO` --
1789+ 5154              ; y `$1F`/`$20` coinciden exactos con los sprites de "arriba" ya
1790+ 5154              ; usados arriba, `$A2`=`$22` con bit7 (mismo patron de volteo
1791+ 5154              ; horizontal). Ninguna referencia real encontrada en el codigo.
1792+ 5154              ;
1793+ 5154              ; TABLA_ELECCION_DIRECCION ($517E, 128 bytes = 16 bloques de 8): DATO
1794+ 5154              ; puro (solo se lee con "LD A,(HL)", ningun JP/JR/CALL apunta aqui).
1795+ 5154              ; Indexada por MOTOR_MOVIMIENTO_ITEM como
1796+ 5154              ; "(bitmask de direcciones libres)<<3 | (prevdir)<<1 | (bit aleatorio)"
1797+ 5154              ; -> devuelve el codigo de direccion final elegido (1/2/4/8, ver
1798+ 5154              ; MOTOR_MOVIMIENTO_ITEM.ELEGIR_DIRECCION_ALEATORIA). ESTRUCTURA COMPLETA DECODIFICADA (correccion
1799+ 5154              ; de una ronda anterior, que la daba por "gate binario de alineamiento"
1800+ 5154              ; -- en realidad son 2 bits que codifican la direccion EN CURSO antes
1801+ 5154              ; de decidir, via TABLA_CLASE_ALINEAMIENTO[(IX+3)]): cada uno de los 16
1802+ 5154              ; bloques corresponde a una combinacion de "direcciones libres"
1803+ 5154              ; (indice de bloque = bitmask $01/$02/$04/$08 = derecha/izquierda/
1804+ 5154              ; abajo/arriba), y dentro de cada bloque los 8 bytes se agrupan en 4
1805+ 5154              ; pares (2 bytes = mismo resultado, el bit aleatorio solo desempata):
1806+ 5154              ; par0=si NO habia direccion previa o iba a la derecha, par1=si iba a
1807+ 5154              ; la izquierda, par2=si iba abajo, par3=si iba arriba. Confirma que es
1808+ 5154              ; una tabla de "mantener direccion si se puede, si no elegir otra de
1809+ 5154              ; las libres" (sesgo de continuidad de movimiento) -- cuando solo hay
1810+ 5154              ; una direccion libre, los 8 bytes del bloque son identicos (esa
1811+ 5154              ; unica direccion) sea cual sea la direccion previa. ---
1812+ 5154              TABLA_ANIMACION_PELMAZOIDE:
1813+ 5154 56 51            DB $56,$51                      ; offset 0-1: puntero autorreferencial = $5156 (offset 2 de aqui mismo)
1814+ 5156 1B 1B 1C 1C      DB $1B,$1B,$1C,$1C               ; offset 2-5: NUNCA se lee (direccion nunca vale 0) -- duplica "derecha"
1815+ 515A 1B 1B 1C 1C      DB $1B,$1B,$1C,$1C               ; offset 6-9: DERECHA (direccion=1) -- sprites $1B,$1C
1816+ 515E 9B 9B 9C 9C      DB $9B,$9B,$9C,$9C               ; offset 10-13: IZQUIERDA (direccion=2) -- $1B,$1C con bit7 (volteo horizontal)
1817+ 5162 1D 1D 1E 1E      DB $1D,$1D,$1E,$1E               ; offset 14-17: ABAJO (direccion=3) -- sprites $1D,$1E
1818+ 5166 1F 1F 20 20      DB $1F,$1F,$20,$20               ; offset 18-21: ARRIBA (direccion=4) -- sprites $1F,$20 -- ULTIMO offset real alcanzable
1819+ 516A 21 21 22 22      DB $21,$21,$22,$22               ; offset 22-25: cola sin usar, fuera de rango indexable
1820+ 516E 21 21 22 22      DB $21,$21,$22,$22               ; offset 26-29: cola sin usar, repite el patron anterior
1821+ 5172 A1 A1            DB $A1,$A1                       ; offset 30-31: cola sin usar ($21 con bit7)
1822+ 5174 A2 A2 23 23      DB $A2,$A2,$23,$23,$24,$24,$1F,$1F,$20,$20                          ; $5174-$517D: candidato a sprite huerfano (dato, no codigo -- ver cabecera de seccion)
1822+ 5178 24 24 1F 1F
1822+ 517C 20 20
1823+ 517E              TABLA_ELECCION_DIRECCION:
1824+ 517E 01 01 01 01      DB $01,$01,$01,$01,$01,$01,$01,$01  ; libres=ninguna (0000) -- sin libres, siempre intenta derecha por defecto
1824+ 5182 01 01 01 01
1825+ 5186 01 01 01 01      DB $01,$01,$01,$01,$01,$01,$01,$01  ; libres=derecha (0001)
1825+ 518A 01 01 01 01
