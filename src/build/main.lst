 833+ 2EB7              ; --- manejadores por tipo de loseta (indexados desde TABLA_MANEJADORES_LOSETA,
 834+ 2EB7              ; nombrados por su direccion real -- ver nota de la tabla arriba).
 835+ 2EB7              ; El indice de despacho ES el valor de tipo de CONSULTAR_TIPO_LOSETA (sin
 836+ 2EB7              ; desplazamiento, confirmado en la llamada real de mas arriba:
 837+ 2EB7              ; "A=tipo; ADD A,A; HL=TABLA_MANEJADORES_LOSETA; ADD A,L..."). Mapeo
 838+ 2EB7              ; tipo->loseta real confirmado cruzando TABLA_TIPOS_LOSETA (madmix1.asm) con
 839+ 2EB7              ; el catalogo de data/tiles/*.til:
 840+ 2EB7              ;   0 = pared/suelo normal (0-44) + variantes decorativas sin
 841+ 2EB7              ;       manejo propio (67,69,71,72,74-77,80,81,84-90); tambien
 842+ 2EB7              ;       comparten este manejador los tipos 8 y 9 (ver mas abajo).
 843+ 2EB7              ;   1 = suelo_con_bola_1/2/3 (bolita normal)      -> HNDLR_BOLITA_NORMAL
 844+ 2EB7              ;   2 = suelo_con_bola_clavada_1/2/3 (bola fija)  -> HNDLR_BOLITA_CLAVADA
 845+ 2EB7              ;   3-6 = flecha_arriba/abajo/izquierda/derecha   -> HNDLR_AUTOCOCO_ARRIBA/2F50/2F88/2FC0
 846+ 2EB7              ;   7 = pista_tanque_vertical                     -> HNDLR_PISTA_COCOTANQUE
 847+ 2EB7              ;   8,9 = linea_electrica_puerta_fantasmas_a/b    -> HNDLR_SUELO_NORMAL (generico, sin logica propia)
 848+ 2EB7              ;   10 = pista_avion_recto/remate_izq/remate_der  -> HNDLR_PISTA_COCONAVE
 849+ 2EB7              ;   11 = item_suelo_sin_confirmar                 -> HNDLR_ITEM_SUELO
 850+ 2EB7              ;   12 = item_bola_de_poder                       -> HNDLR_BOLA_PODER
 851+ 2EB7              ;   13 = item_hipopotamo                          -> HNDLR_HIPODOSO
 852+ 2EB7              ;   14 = item_herramienta                         -> HNDLR_EXCAVATOFONO
 853+ 2EB7              ;   15,16 = suelo_sin_bola_*/muro_ladrillo_suelto/loseta_solida_negra -> HNDLR_SUELO_SIN_BOLA (ya documentado)
 854+ 2EB7              ;   17,18,19 = variantes de trampilla_transicion  -> HNDLR_TRAMPILLA_ABIERTA_DERECHA/HNDLR_TRAMPILLA_ABIERTA_IZQUIERDA/HNDLR_TRAMPILLA_CERRADA
 855+ 2EB7              ; ---
 856+ 2EB7              ; --- HNDLR_SUELO_NORMAL (tipos 0, 8 y 9 -- pared/suelo normal y las 2
 857+ 2EB7              ; losetas de "linea electrica" de la puerta de fantasmas, sin lógica
 858+ 2EB7              ; propia): caso general, sin efecto de juego. Unico caso especial:
 859+ 2EB7              ; si el parametro de entrada vale $09 salta a la cola compartida
