  50+ 103B 78               LD A, B
  51+ 103C B1               OR C
  52+ 103D 20 F7            JR NZ, .BUCLE_VOLCAR_PATRON_PORTADA          ; 6144 bytes: bitmap completo de la portada
  53+ 103F 3E 01            LD A, 1                      ; 1 = color de borde/fondo (indice de paleta, ver PALETA_COLORES_PORTADA)
  54+ 1041 47               LD B, A
  55+ 1042 0E 07            LD C, 7                      ; 7 = numero de registro del VDP (R7 = color de borde/texto)
  56+ 1044 78               LD A, B
  57+ 1045 D3 99            OUT ($99), A                 ; escribe el valor de color al puerto de datos del VDP
  58+ 1047 79               LD A, C
  59+ 1048 F6 80            OR $80                       ; bit7 = comando "escribir registro" del VDP
  60+ 104A D3 99            OUT ($99), A                  ; registro 7 del VDP (borde/fondo) = 1
  61+ 104C
  62+ 104C              ; --- descompresion de la tabla de color (768 grupos de 8 lineas) ---
  63+ 104C 01 00 03         LD BC, 768                    ; 768 grupos de color a descomprimir (bucle externo)
  64+ 104F 11 00 20         LD DE, $2000                  ; VRAM $2000 = tabla de color
