# file opened: main.asm
   1  0000              ; ============================================================
   2  0000              ;  Mad Mix Game (Topo Soft, 1987) - MSX1
   3  0000              ;  main.asm -- pasada UNICA de ensamblado que unifica madmix1_body.asm
   4  0000              ;  y madmix_scr_body.asm en un solo espacio de simbolos, para que las
   5  0000              ;  llamadas/punteros cruzados entre ambos usen etiquetas reales en vez
   6  0000              ;  de direcciones hex literales. Genera:
   7  0000              ;   - build/disk/MADMIX1.BIN y build/cas/MADMIX1.BIN (motor del
   8  0000              ;     juego): dos copias IDENTICAS del mismo SAVEBIN -- es EXACTAMENTE
   9  0000              ;     el mismo binario en ambas ediciones (verificado, ver
  10  0000              ;     FINDINGS.md), pero cada carpeta se mantiene autocontenida (todo
  11  0000              ;     lo que hace falta para generar su .dsk/.cas vive dentro de ella,
  12  0000              ;     sin tener que ir a buscar nada a build/ a secas).
  13  0000              ;   - build/disk/MADMIX.SCR, build/disk/MADMIX0.BIN -- especificos de
  14  0000              ;     la version de disco.
  15  0000              ;   - build/cas/madmix_cas_scr.bin (contenido logico de MADMIX.SCR,
  16  0000              ;     SIN cabecera BLOAD -- la cinta carga esto directo en $1000, sin
  17  0000              ;     el paso de reubicacion que si hace el disco), build/cas/TEST.BIN,
  18  0000              ;     build/cas/LOAD.BIN -- especificos de la version de cinta.
  19  0000              ;  load_disk/madmix0_body.asm (el "relocador" de disco, 58 bytes) y
  20  0000              ;  load_cas/*_body.asm (cargador de cinta) se incluyen mas abajo,
  21  0000              ;  compartiendo este mismo espacio de simbolos -- pueden referenciar
  22  0000              ;  DIBUJAR_PORTADA/START en vez de $1000/$8400 literales.
  23  0000              ;  Ver FINDINGS.md para el detalle completo de esta unificacion.
  24  0000              ; Ingeniería inversa, herramientas y documentación de este proyecto: Rafael Eduardo Martín Candial (raemca@hotmail.com)
  25  0000              ; ============================================================
  26  0000
  27  0000                  DEVICE NOSLOT64K
  28  0000
  29  0000              ; --- MADMIX1.BIN: direcciones estaticas $8400+, igual que siempre ---
  30  0000                  ORG $83F9
  31  83F9 FE               DB $FE                     ; cabecera de fichero .BIN de MSX
  32  83FA 00 84 A0 DD      DW START, END_OF_FILE_M1-1, START
  32  83FE 00 84
  33  8400
  34  8400                  INCLUDE "madmix1_body.asm"
# file opened: madmix1_body.asm
