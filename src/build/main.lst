1746+ 8C34              ; --- REDIBUJAR_PANTALLA_COMPLETA_BUFFER_VRAM (JT_REDIBUJAR_PANTALLA_COMPLETA_BUFFER_VRAM): redibuja la camara -- bucle de $24
1747+ 8C34              ; (36) pasos (.BUCLE_REDIBUJADO_CAMARA), una llamada a DIBUJAR_FILA_LOSETAS_BUFFER_VRAM por paso,
1748+ 8C34              ; avanzando una fila cada vez (INC H) -- y, si quedan vidas
1749+ 8C34              ; (($2C27)!=0), dibuja el icono de vida
1750+ 8C34              ; (ICONO_VIDA_EXTRA, ver FINDINGS.md) una vez por vida restante
1751+ 8C34              ; (.BUCLE_ICONOS_VIDA/LDIRVM_INVERTIDO), desplazando $18 px por icono. De paso
1752+ 8C34              ; limpia BUFFER_DIGITOS_PUNTUACION a "000000" y redibuja el marcador
1753+ 8C34              ; (CALL DIBUJAR_MARCADOR_PUNTOS) antes del bucle de vidas. ---
1754+ 8C34              REDIBUJAR_PANTALLA_COMPLETA_BUFFER_VRAM:
1755+ 8C34 06 24            LD     B,36                   ; contador del bucle externo: 36 franjas de camara
1756+ 8C36 11 04 DE         LD     DE,BUFFER_LOSETAS_TRABAJO  ; destino base en el lienzo
1757+ 8C39 D9               EXX                           ; banco alternativo
1758+ 8C3A 2A 02 2C         LD     HL,(REGISTRO_NIVEL_POSICION_COMECOCOS)
1759+ 8C3D D9               EXX                           ; vuelve al banco principal
1760+ 8C3E              .BUCLE_REDIBUJADO_CAMARA:
1761+ 8C3E C5               PUSH   BC
1762+ 8C3F D9               EXX                           ; banco alternativo
1763+ 8C40 E5               PUSH   HL
1764+ 8C41 D9               EXX                           ; vuelve al banco principal
1765+ 8C42 D5               PUSH   DE
1766+ 8C43 CD 5A 8A         CALL   DIBUJAR_FILA_LOSETAS_BUFFER_VRAM
1767+ 8C46 E1               POP    HL
1768+ 8C47 01 80 00         LD     BC,128                 ; paso de destino: 4 filas de 32 bytes
1769+ 8C4A 09               ADD    HL,BC
1770+ 8C4B EB               EX     DE,HL
1771+ 8C4C D9               EXX                           ; banco alternativo
1772+ 8C4D E1               POP    HL
1773+ 8C4E 24               INC    H                      ; avanza pagina del banco alternativo
1774+ 8C4F D9               EXX                           ; vuelve al banco principal
1775+ 8C50 C1               POP    BC
1776+ 8C51 10 EB            DJNZ   .BUCLE_REDIBUJADO_CAMARA
1777+ 8C53 21 00 00         LD     HL,0                   ; delta=0: solo redibuja el marcador, no suma puntos
1778+ 8C56 CD 70 8D         CALL   DIBUJAR_MARCADOR_PUNTOS
1779+ 8C59 21 48 16         LD     HL,$1648               ; zona VRAM de los iconos de vida (coincide con D/E mas abajo)
1780+ 8C5C E5               PUSH   HL
1781+ 8C5D 3E FF            LD     A,$FF                  ; byte de relleno (blanco/vacio)
1782+ 8C5F 01 60 00         LD     BC,96                  ; recuento de bytes a rellenar
1783+ 8C62 CD 31 89         CALL   FILVRM              ; equivalente a la rutina FILVRM del BIOS de MSX
1784+ 8C65 E1               POP    HL
1785+ 8C66 24               INC    H                      ; siguiente pagina VRAM
1786+ 8C67 01 60 00         LD     BC,96                  ; recuento de bytes a rellenar
1787+ 8C6A CD 31 89         CALL   FILVRM              ; equivalente a la rutina FILVRM del BIOS de MSX
1788+ 8C6D 3A 27 2C         LD     A,(VIDAS_RESTANTES)
1789+ 8C70 A7               AND    A                      ; prueba si es cero
1790+ 8C71 C8               RET    Z                      ; sin vidas: no dibuja iconos
1791+ 8C72 47               LD     B,A                    ; contador del bucle: una vuelta por vida restante
1792+ 8C73 1E 48            LD     E,$48                  ; byte bajo de la direccion VRAM del primer icono (junto con D, forma $1648)
1793+ 8C75              .BUCLE_ICONOS_VIDA:
1794+ 8C75 C5               PUSH   BC
1795+ 8C76 16 16            LD     D,$16                  ; byte alto de la direccion VRAM del icono
1796+ 8C78 21 C3 92         LD     HL,$92C3               ; origen grafico del icono (ICONO_VIDA_EXTRA, ver FINDINGS.md)
1797+ 8C7B 01 10 00         LD     BC,16                  ; recuento de bytes: primera banda del icono
1798+ 8C7E CD A3 8C         CALL   LDIRVM_INVERTIDO
1799+ 8C81 14               INC    D                      ; siguiente banda VRAM (+256)
1800+ 8C82 01 10 00         LD     BC,16                  ; recuento de bytes: segunda banda del icono
1801+ 8C85 CD A3 8C         CALL   LDIRVM_INVERTIDO
1802+ 8C88 3E 18            LD     A,24                   ; paso horizontal entre iconos, en pixels
1803+ 8C8A 83               ADD    A,E
1804+ 8C8B 5F               LD     E,A                    ; avanza al siguiente icono
1805+ 8C8C C1               POP    BC
1806+ 8C8D 10 E6            DJNZ   .BUCLE_ICONOS_VIDA
1807+ 8C8F 21 E9 8D         LD     HL,BUFFER_DIGITOS_PUNTUACION  ; buffer de digitos ASCII del marcador (6 bytes)
1808+ 8C92 36 30            LD     (HL),$30               ; ASCII '0' (48), primer digito
1809+ 8C94 11 EA 8D         LD     DE,BUFFER_DIGITOS_PUNTUACION+1
1810+ 8C97 01 05 00         LD     BC,5                   ; recuento: copia el '0' a los otros 5 digitos
1811+ 8C9A ED B0            LDIR
1812+ 8C9C 21 00 00         LD     HL,0                   ; delta=0: solo redibuja el marcador, no suma puntos
1813+ 8C9F CD 70 8D         CALL   DIBUJAR_MARCADOR_PUNTOS
1814+ 8CA2 C9               RET
1815+ 8CA3              ; --- Vuelca BC bytes desde HL a VRAM (destino en DE, via SETVRAM)
1816+ 8CA3              ; invirtiendo cada byte (CPL) antes de escribirlo -- mismo
1817+ 8CA3              ; "modo invertido" que DIBUJAR_TEXTO_INVERTIDO_VRAM. Usada por .BUCLE_ICONOS_VIDA para dibujar el
1818+ 8CA3              ; icono de vida (ICONO_VIDA_EXTRA, ver FINDINGS.md), 16 bytes por
1819+ 8CA3              ; banda en 2 bandas. ---
1820+ 8CA3              LDIRVM_INVERTIDO:
1821+ 8CA3 F3               DI
1822+ 8CA4 EB               EX     DE,HL
1823+ 8CA5 CD 54 89         CALL   SETVRAM
1824+ 8CA8 EB               EX     DE,HL
1825+ 8CA9              LDIRVM_INVERTIDO_LOOP:
1826+ 8CA9 7E               LD     A,(HL)
1827+ 8CAA 2F               CPL
1828+ 8CAB D3 98            OUT    ($98),A
1829+ 8CAD 23               INC    HL
1830+ 8CAE 0B               DEC    BC
1831+ 8CAF 78               LD     A,B
1832+ 8CB0 B1               OR     C
1833+ 8CB1 C2 A9 8C         JP     NZ,LDIRVM_INVERTIDO_LOOP
1834+ 8CB4 FB               EI
1835+ 8CB5 C9               RET
1836+ 8CB6
1837+ 8CB6
1838+ 8CB6              ; ==============================================================
1839+ 8CB6              ;  SCROLL POR SOFTWARE  (0x8CB6 / 0x8CDA / 0x8D1B originales,
1840+ 8CB6              ;  confirmados -- en ESE orden de direcciones)
1841+ 8CB6              ; ==============================================================
1842+ 8CB6              ; NOTA: "PLAYER_POS" (variable inventada, nunca confirmada contra
1843+ 8CB6              ; el binario original) se quito de aqui -- estaba colocada justo
1844+ 8CB6              ; antes de MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA y lo desplazaba 2 bytes de su
1845+ 8CB6              ; direccion real confirmada (0x8CB6), rompiendo el byte-exact sin
1846+ 8CB6              ; que nadie lo notara hasta verificarlo con --sym. Si de verdad
1847+ 8CB6              ; existe una variable de posicion del jugador, hay que localizarla
1848+ 8CB6              ; por desensamblado antes de volver a colocarla en algun sitio.
1849+ 8CB6
1850+ 8CB6              ; MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA (0x8CB6) -- CONFIRMADO y transcrito completo.
1851+ 8CB6              ; HL=($2C02) es la posicion del comecocos/camara; B,C son un
1852+ 8CB6              ; desplazamiento (fila,columna) relativo. El patron AND $7C +
1853+ 8CB6              ; rotaciones es el modismo clasico Z80/MSX para "direccion = base
1854+ 8CB6              ; + fila*32 + columna" -- el 32 (ancho de la matriz de nivel en
1855+ 8CB6              ; losetas) sale de estas constantes, no es una suposicion. Ver
1856+ 8CB6              ; FINDINGS.md: confirma que el usuario contÃ³ bien (25 losetas
1857+ 8CB6              ; visibles + 7 del pasillo de vuelta = 32).
1858+ 8CB6              ;
1859+ 8CB6              ; BUG CORREGIDO (ver MAPEAR_LOSETA_A_GRAFICO mas arriba, 0x8BC9, y FINDINGS.md):
1860+ 8CB6              ; la v1.0 original tenia $FC60 aqui tambien (0x8CD4) -- mismo bug del
1861+ 8CB6              ; buffer de nivel demasiado pequeno para el cuerpo del nivel 14,
1862+ 8CB6              ; mismo fix de la v2.0 aplicado: $FC60 -> $FC50.
1863+ 8CB6              MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA:
1864+ 8CB6 F5               PUSH AF
1865+ 8CB7 C5               PUSH BC
1866+ 8CB8 2A 02 2C         LD HL, (REGISTRO_NIVEL_POSICION_COMECOCOS)  ; posicion actual de camara
1867+ 8CBB 54               LD D, H
1868+ 8CBC 5D               LD E, L
1869+ 8CBD 7C               LD A, H
1870+ 8CBE 80               ADD A, B                ; suma el desplazamiento de fila (B) a la coordenada H
1871+ 8CBF E6 7C            AND $7C                 ; mascara de bits de fila
1872+ 8CC1 0F               RRCA
1873+ 8CC2 0F               RRCA
1874+ 8CC3 47               LD B, A
1875+ 8CC4 7D               LD A, L
1876+ 8CC5 81               ADD A, C                ; suma el desplazamiento de columna (C) a la coordenada L
1877+ 8CC6 E6 7C            AND $7C                 ; mascara de bits de columna
1878+ 8CC8 07               RLCA
1879+ 8CC9 CB 18            RR B
1880+ 8CCB 1F               RRA
1881+ 8CCC CB 18            RR B
1882+ 8CCE 1F               RRA
1883+ 8CCF CB 18            RR B
1884+ 8CD1 1F               RRA
1885+ 8CD2 4F               LD C, A                 ; BC = indice combinado fila*32+columna
1886+ 8CD3 21 50 FC         LD HL, $FC50            ; BUG CORREGIDO: $FC60 en la v1.0 original, ver comentario arriba -- buffer del nivel activo
1887+ 8CD6 09               ADD HL, BC               ; HL = direccion absoluta de la loseta
1888+ 8CD7 C1               POP BC
1889+ 8CD8 F1               POP AF
1890+ 8CD9 C9               RET
1891+ 8CDA
1892+ 8CDA              ; ==============================================================
1893+ 8CDA              ;  0x8CDA-0x8EC4 -- CORREGIDOS/COMPLETADOS CONSULTAR_TIPO_LOSETA y
1894+ 8CDA              ;  REDIBUJAR_LOSETA_BUFFER_VRAM (los stubs anteriores no coincidian con el codigo
1895+ 8CDA              ;  real), mas la cola de redibujado diferido (QUEUE_*, sin nombre
1896+ 8CDA              ;  previo), JT_DIBUJAR_MARCADOR_PUNTOS (DIBUJAR_MARCADOR_PUNTOS, marcador de puntuacion) y
1897+ 8CDA              ;  JT_LEER_ENTRADA (LEER_ENTRADA, lectura de teclado/joystick).
1898+ 8CDA              ;   - CONSULTAR_TIPO_LOSETA: CORREGIDO -- el stub decia "sumar A a HL
1899+ 8CDA              ;     con acarreo" sobre el bloque reservado ($8EC4); el real usa
1900+ 8CDA              ;     base TABLA_TIPOS_LOSETA ($8EC7, +3 respecto al bloque reservado) y
1901+ 8CDA              ;     enmascara el resultado con AND $1F, no solo lee el byte tal cual.
1902+ 8CDA              ;   - APILAR_PETICION_REDIBUJADO/VACIAR_COLA_REDIBUJADO/.DESPACHAR_ENTRADA_COLA: cola de
1903+ 8CDA              ;     peticiones de redibujado diferido. APILAR_PETICION_REDIBUJADO (CORREGIDO:
1904+ 8CDA              ;     llamadores localizados en madmix_scr.asm -- HNDLR_MARICOCO/
1905+ 8CDA              ;     HNDLR_REGPUNANTOSO, al regenerar una bolita ya comida) apila
1906+ 8CDA              ;     (C,B,A) en un buffer circular en RAM ($8D61-$8D6F, $FF =
1907+ 8CDA              ;     vacio) via el puntero $8D5F.
1908+ 8CDA              ;     VACIAR_COLA_REDIBUJADO es la rutina real detras de "CALL $8CFF"
1909+ 8CDA              ;     en GESTIONAR_FRAME: cada frame vacia la cola llamando a
1910+ 8CDA              ;     REDIBUJAR_LOSETA_BUFFER_VRAM(C,B,A) por cada entrada, hasta el centinela.
1911+ 8CDA              ;   - REDIBUJAR_LOSETA_BUFFER_VRAM: CORREGIDO -- el stub anterior decia "copia de
1912+ 8CDA              ;     franja 2x16, origen GRAFICOS_LOSETAS, destino SCREEN_SHADOW"; el
1913+ 8CDA              ;     real usa la posicion de camara ($2C02) + los parametros
1914+ 8CDA              ;     (B,C) de la cola para calcular una direccion en BUFFER_LOSETAS_TRABAJO, y
1915+ 8CDA              ;     copia 16 bytes (2x LDI) desde GRAFICOS_LOSETAS (base $B940, ver
1916+ 8CDA              ;     LD BC,$B940 -- confirma el nombre) en un bucle de $10 pasos.
1917+ 8CDA              ;   - DIBUJAR_MARCADOR_PUNTOS (JT_DIBUJAR_MARCADOR_PUNTOS, $8D70): dibuja el marcador. Si el
1918+ 8CDA              ;     acumulado ($2C29) llega a $2710 (10000), en vez de seguir
1919+ 8CDA              ;     contando muestra el texto TEXTO_BESTIA ("BESTIA") -- un
1920+ 8CDA              ;     "premio" de texto en vez de numero. Si ($60CA) esta activo
1921+ 8CDA              ;     (probable flag de modo demo) muestra TEXTO_DEMO (" DEMO ")
1922+ 8CDA              ;     en su lugar. Si no, calcula los digitos por resta repetida
1923+ 8CDA              ;     contra DIVISORES_PUNTUACION (1000/100/10) y los dibuja via
1924+ 8CDA              ;     DIBUJAR_TEXTO_INVERTIDO_VRAM, que interpreta cada byte como indice de caracter
1925+ 8CDA              ;     en una tabla de fuente en $935B (parece coincidir con ASCII
1926+ 8CDA              ;     para letras, sin confirmar el resto de la tabla).
1927+ 8CDA              ;   - LEER_ENTRADA (JT_LEER_ENTRADA, $8E3C): lee FLAG_ENTRADA_BLOQUEADA
1928+ 8CDA              ;     ($8EC6, byte "libre" del bloque reservado justo antes de
1929+ 8CDA              ;     TABLA_TIPOS_LOSETA, reutilizado como flag -- confirmado por valor: la
1930+ 8CDA              ;     ROM tiene $00 ahi) y, si no esta activo, hace un escaneo de
1931+ 8CDA              ;     teclado (OUT $AA / IN $A9, el metodo estandar MSX de matriz de
1932+ 8CDA              ;     teclado) sobre 5 filas comparando contra una tabla de mascaras
1933+ 8CDA              ;     en $8E88, y luego lee el joystick por el puerto del PSG
1934+ 8CDA              ;     (OUT $A0 / IN $A2) decodificando los bits en E via SET 0-4 --
1935+ 8CDA              ;     coincide con el mismo patron de extraccion de bits usado en
1936+ 8CDA              ;     CONSULTAR_COLOR_VDP/TABLA_COLORES_VDP (bits 3-6 -> indice 0-15),
1937+ 8CDA              ;     reutilizado aqui para decodificar direccion, no color. El
1938+ 8CDA              ;     resultado combinado se guarda en
1939+ 8CDA              ;     ACUMULADOR_ENTRADA ($8EC4, mismo bloque reservado) via
1940+ 8CDA              ;     OR/LD (HL),A.
1941+ 8CDA              ; ==============================================================
1942+ 8CDA              CONSULTAR_TIPO_LOSETA:
1943+ 8CDA E5               PUSH   HL
1944+ 8CDB D5               PUSH   DE
1945+ 8CDC 7E               LD     A,(HL)                 ; A = byte crudo de loseta
1946+ 8CDD E6 7F            AND    $7F                    ; descarta el bit 7
1947+ 8CDF 21 C7 8E         LD     HL,TABLA_TIPOS_LOSETA
1948+ 8CE2 85               ADD    A,L                    ; HL = TABLA_TIPOS_LOSETA + indice
1949+ 8CE3 6F               LD     L,A
1950+ 8CE4 7C               LD     A,H
1951+ 8CE5 CE 00            ADC    A,0                    ; propaga el acarreo
1952+ 8CE7 67               LD     H,A
1953+ 8CE8 7E               LD     A,(HL)                 ; A = tipo de loseta
1954+ 8CE9 E6 1F            AND    $1F                    ; mascara final del tipo (5 bits)
1955+ 8CEB D1               POP    DE
1956+ 8CEC E1               POP    HL
1957+ 8CED C9               RET
1958+ 8CEE              APILAR_PETICION_REDIBUJADO:
1959+ 8CEE E5               PUSH   HL
1960+ 8CEF 2A 5F 8D         LD     HL,($8D5F)             ; puntero de escritura de la cola circular
1961+ 8CF2 71               LD     (HL),C                 ; primer byte de la entrada (fila)
1962+ 8CF3 23               INC    HL
1963+ 8CF4 70               LD     (HL),B                 ; segundo byte de la entrada (columna)
1964+ 8CF5 23               INC    HL
1965+ 8CF6 77               LD     (HL),A                 ; tercer byte de la entrada
1966+ 8CF7 23               INC    HL
1967+ 8CF8 36 FF            LD     (HL),$FF               ; nuevo centinela de fin de cola
1968+ 8CFA 22 5F 8D         LD     ($8D5F),HL             ; guarda el puntero avanzado
1969+ 8CFD E1               POP    HL
1970+ 8CFE C9               RET
1971+ 8CFF              VACIAR_COLA_REDIBUJADO:
1972+ 8CFF 21 61 8D         LD     HL,$8D61               ; inicio del buffer circular de la cola
1973+ 8D02              .BUCLE_VACIAR_COLA:
1974+ 8D02 7E               LD     A,(HL)
1975+ 8D03 FE FF            CP     $FF                    ; centinela de fin de cola
1976+ 8D05 20 09            JR     NZ,.DESPACHAR_ENTRADA_COLA
1977+ 8D07 21 61 8D         LD     HL,$8D61               ; cola vacia: reinicia el puntero de escritura al principio
1978+ 8D0A 36 FF            LD     (HL),$FF
1979+ 8D0C 22 5F 8D         LD     ($8D5F),HL
1980+ 8D0F C9               RET
1981+ 8D10              .DESPACHAR_ENTRADA_COLA:
1982+ 8D10 4F               LD     C,A                    ; primer byte de la entrada
1983+ 8D11 23               INC    HL
1984+ 8D12 46               LD     B,(HL)                 ; segundo byte de la entrada
1985+ 8D13 23               INC    HL
1986+ 8D14 7E               LD     A,(HL)                 ; tercer byte de la entrada
1987+ 8D15 23               INC    HL
1988+ 8D16 CD 1B 8D         CALL   REDIBUJAR_LOSETA_BUFFER_VRAM
1989+ 8D19 18 E7            JR     .BUCLE_VACIAR_COLA
1990+ 8D1B              REDIBUJAR_LOSETA_BUFFER_VRAM:
1991+ 8D1B E5               PUSH   HL
1992+ 8D1C D5               PUSH   DE
1993+ 8D1D F5               PUSH   AF
1994+ 8D1E 2A 02 2C         LD     HL,(REGISTRO_NIVEL_POSICION_COMECOCOS)
1995+ 8D21 7C               LD     A,H
1996+ 8D22 E6 03            AND    $03                    ; mascara de bits de la coordenada H
1997+ 8D24 67               LD     H,A
1998+ 8D25 7D               LD     A,L
1999+ 8D26 E6 02            AND    $02                    ; mascara de bits de la coordenada L
2000+ 8D28 CB 1C            RR     H
2001+ 8D2A 1F               RRA
2002+ 8D2B 6F               LD     L,A
2003+ 8D2C 78               LD     A,B                    ; fila de la entrada de la cola
2004+ 8D2D 87               ADD    A,A
2005+ 8D2E 84               ADD    A,H
2006+ 8D2F 67               LD     H,A
2007+ 8D30 79               LD     A,C                    ; columna de la entrada de la cola
2008+ 8D31 87               ADD    A,A
2009+ 8D32 85               ADD    A,L
2010+ 8D33 6F               LD     L,A                    ; HL = indice combinado en el lienzo
2011+ 8D34 01 04 DE         LD     BC,BUFFER_LOSETAS_TRABAJO
2012+ 8D37 09               ADD    HL,BC                  ; HL = direccion destino en el lienzo
2013+ 8D38 EB               EX     DE,HL
2014+ 8D39 F1               POP    AF                     ; recupera el tercer byte de la entrada (tipo de loseta)
2015+ 8D3A E6 7F            AND    $7F                    ; descarta el bit 7
2016+ 8D3C 2E 00            LD     L,0                    ; semilla del calculo de indice grafico
2017+ 8D3E 1F               RRA
2018+ 8D3F CB 1D            RR     L
2019+ 8D41 1F               RRA
2020+ 8D42 CB 1D            RR     L
2021+ 8D44 1F               RRA
2022+ 8D45 CB 1D            RR     L
2023+ 8D47 67               LD     H,A
2024+ 8D48 01 40 B9         LD     BC,GRAFICOS_LOSETAS            ; base de los graficos de loseta
2025+ 8D4B 09               ADD    HL,BC                  ; HL = direccion grafica origen
2026+ 8D4C 06 10            LD     B,16                   ; contador del bucle: 16 filas de la loseta
2027+ 8D4E              .BUCLE_FILA_LOSETA:
2028+ 8D4E C5               PUSH   BC
2029+ 8D4F ED A0            LDI                           ; copia 2 bytes por fila (el ancho real de la loseta)
2030+ 8D51 ED A0            LDI
2031+ 8D53 01 1E 00         LD     BC,30                  ; paso de destino: 30+2=32, ancho de fila del lienzo
2032+ 8D56 EB               EX     DE,HL
2033+ 8D57 09               ADD    HL,BC
2034+ 8D58 EB               EX     DE,HL
2035+ 8D59 C1               POP    BC
2036+ 8D5A 10 F2            DJNZ   .BUCLE_FILA_LOSETA
2037+ 8D5C D1               POP    DE
2038+ 8D5D E1               POP    HL
2039+ 8D5E C9               RET
2040+ 8D5F
2041+ 8D5F              ; $8D5F/$8D60 (puntero de APILAR_PETICION_REDIBUJADO, 2 bytes) y $8D61-$8D6F (el
2042+ 8D5F              ; buffer circular de la cola, 15 bytes) -- estado inicial real en
2043+ 8D5F              ; el .BIN: puntero a 0 y buffer todo $FF (cola vacia). NOP/RST 38h
2044+ 8D5F              ; son simplemente como se desensamblan los bytes $00/$FF sueltos,
2045+ 8D5F              ; no hay codigo real aqui.
2046+ 8D5F 00               NOP
2047+ 8D60 00               NOP
2048+ 8D61 FF               RST    38H
2049+ 8D62 FF               RST    38H
2050+ 8D63 FF               RST    38H
2051+ 8D64 FF               RST    38H
2052+ 8D65 FF               RST    38H
2053+ 8D66 FF               RST    38H
2054+ 8D67 FF               RST    38H
2055+ 8D68 FF               RST    38H
2056+ 8D69 FF               RST    38H
2057+ 8D6A FF               RST    38H
2058+ 8D6B FF               RST    38H
2059+ 8D6C FF               RST    38H
2060+ 8D6D FF               RST    38H
2061+ 8D6E FF               RST    38H
2062+ 8D6F FF               RST    38H
2063+ 8D70              ; --- Dibuja el marcador de puntos (JT_DIBUJAR_MARCADOR_PUNTOS). Si ($60CA) esta activo
2064+ 8D70              ; (modo demo, ver TAIL_* en madmix_scr.asm) muestra TEXTO_DEMO
2065+ 8D70              ; (" DEMO ") en vez del numero. Si no, suma DE a la puntuacion
2066+ 8D70              ; acumulada ($2C29); si llega a $2710 (10000) muestra TEXTO_BESTIA
2067+ 8D70              ; ("BESTIA") en vez de seguir contando; si no, convierte el numero a
2068+ 8D70              ; digitos ASCII (DIBUJAR_MARCADOR_PUNTOS_DIGITOS) sobre BUFFER_DIGITOS_PUNTUACION. Dibuja
2069+ 8D70              ; el resultado con DIBUJAR_TEXTO_INVERTIDO_VRAM en la posicion fija de pantalla $16B0. ---
2070+ 8D70              DIBUJAR_MARCADOR_PUNTOS:
2071+ 8D70 F5               PUSH   AF
2072+ 8D71 E5               PUSH   HL                     ; HL de entrada = delta a sumar a la puntuacion (0 = solo redibujar)
2073+ 8D72 D5               PUSH   DE
2074+ 8D73 C5               PUSH   BC
2075+ 8D74 DD E5            PUSH   IX
2076+ 8D76 3A CA 60         LD     A,($60CA)              ; flag de modo demo (probable)
2077+ 8D79 A7               AND    A                      ; prueba si esta activo
2078+ 8D7A DD 21 F7 8D      LD     IX,TEXTO_DEMO
2079+ 8D7E 20 1F            JR     NZ,DIBUJAR_MARCADOR_PUNTOS_COMMON  ; en demo: muestra " DEMO " en vez del numero
2080+ 8D80 EB               EX     DE,HL                  ; DE = delta de entrada
2081+ 8D81 2A 29 2C         LD     HL,(PUNTUACION)
2082+ 8D84 19               ADD    HL,DE                  ; suma el delta a la puntuacion acumulada
2083+ 8D85 22 29 2C         LD     (PUNTUACION),HL
2084+ 8D88 7C               LD     A,H
2085+ 8D89 11 10 27         LD     DE,10000               ; umbral del premio "BESTIA"
2086+ 8D8C ED 52            SBC    HL,DE                  ; compara la puntuacion contra 10000
2087+ 8D8E DD 21 F0 8D      LD     IX,TEXTO_BESTIA
2088+ 8D92 30 0B            JR     NC,DIBUJAR_MARCADOR_PUNTOS_COMMON  ; si llega o supera 10000: muestra "BESTIA" en vez de seguir contando
2089+ 8D94 19               ADD    HL,DE                  ; deshace la resta (HL = puntuacion real, por debajo del umbral)
2090+ 8D95 11 E9 8D         LD     DE,BUFFER_DIGITOS_PUNTUACION
2091+ 8D98 CD AC 8D         CALL   DIBUJAR_MARCADOR_PUNTOS_DIGITOS  ; convierte la puntuacion a digitos ASCII
2092+ 8D9B DD 21 E9 8D      LD     IX,BUFFER_DIGITOS_PUNTUACION
2093+ 8D9F              DIBUJAR_MARCADOR_PUNTOS_COMMON:
2094+ 8D9F 21 B0 16         LD     HL,$16B0               ; posicion fija en pantalla del marcador
2095+ 8DA2 CD FE 8D         CALL   DIBUJAR_TEXTO_INVERTIDO_VRAM
2096+ 8DA5 DD E1            POP    IX
2097+ 8DA7 C1               POP    BC
2098+ 8DA8 D1               POP    DE
2099+ 8DA9 E1               POP    HL
2100+ 8DAA F1               POP    AF
2101+ 8DAB C9               RET
2102+ 8DAC              ; --- Convierte la puntuacion (HL) en digitos ASCII escritos en el
2103+ 8DAC              ; buffer (DE, normalmente BUFFER_DIGITOS_PUNTUACION): resta repetida contra
2104+ 8DAC              ; DIVISORES_PUNTUACION (1000,100,10, ver mas abajo) para los primeros 3
2105+ 8DAC              ; digitos via .EMITIR_DIGITO, y el resto (0-9, ya en L) para el
2106+ 8DAC              ; ultimo. Algoritmo clasico de extraccion de digitos por resta. ---
2107+ 8DAC              DIBUJAR_MARCADOR_PUNTOS_DIGITOS:
2108+ 8DAC D5               PUSH   DE                     ; guarda DE de entrada (puntero destino) para pasarlo al banco alternativo
2109+ 8DAD D9               EXX                           ; banco alternativo
2110+ 8DAE D1               POP    DE                     ; DE (alternativo) = puntero destino, usado luego por .EMITIR_DIGITO
2111+ 8DAF D9               EXX                           ; vuelve al banco principal
2112+ 8DB0 DD 21 E3 8D      LD     IX,DIVISORES_PUNTUACION
2113+ 8DB4 11 00 00         LD     DE,0                   ; offset inicial en el buffer destino (via banco alternativo)
2114+ 8DB7              .BUCLE_DIVISORES:
2115+ 8DB7 AF               XOR    A                      ; A=0: contador de digito para este divisor
2116+ 8DB8 DD 4E 00         LD     C,(IX+$00)             ; byte bajo del divisor actual
2117+ 8DBB DD 46 01         LD     B,(IX+$01)             ; byte alto del divisor actual
2118+ 8DBE DD 23            INC    IX                     ; avanza al siguiente divisor
2119+ 8DC0 DD 23            INC    IX
2120+ 8DC2              .BUCLE_RESTA_DIGITO:
2121+ 8DC2 3C               INC    A                      ; cuenta un intento de resta mas
2122+ 8DC3 ED 42            SBC    HL,BC                  ; resta el divisor
2123+ 8DC5 30 FB            JR     NC,.BUCLE_RESTA_DIGITO ; sin acarreo: todavia cabe otra resta
2124+ 8DC7 3D               DEC    A                      ; corrige el intento que ya se paso (dio acarreo)
2125+ 8DC8 CD D7 8D         CALL   .EMITIR_DIGITO
2126+ 8DCB 09               ADD    HL,BC                  ; deshace la ultima resta fallida
2127+ 8DCC 78               LD     A,B
2128+ 8DCD B1               OR     C                      ; comprueba si el divisor actual era 10 (el ultimo)
2129+ 8DCE FE 0A            CP     10
2130+ 8DD0 20 E5            JR     NZ,.BUCLE_DIVISORES    ; si no era 10, sigue con el siguiente divisor
2131+ 8DD2 7D               LD     A,L                    ; ultimo digito: el resto ya cabe directo en L (0-9)
2132+ 8DD3 CD D7 8D         CALL   .EMITIR_DIGITO
2133+ 8DD6 C9               RET
2134+ 8DD7              ; --- Escribe un digito (A, 0-9) como caracter ASCII ("+$30") en la
2135+ 8DD7              ; siguiente posicion libre del buffer (puntero en el juego de
2136+ 8DD7              ; registros alterno, EXX, avanzado con INC E cada vez). ---
2137+ 8DD7              .EMITIR_DIGITO:
2138+ 8DD7 E5               PUSH   HL
2139+ 8DD8 D9               EXX                           ; banco alternativo
2140+ 8DD9 D5               PUSH   DE                     ; guarda el puntero destino (alternativo)
2141+ 8DDA D9               EXX                           ; vuelve al banco principal
2142+ 8DDB E1               POP    HL                     ; HL = puntero destino
2143+ 8DDC 19               ADD    HL,DE                  ; HL += offset acumulado
2144+ 8DDD C6 30            ADD    A,$30                  ; convierte el digito (0-9) a caracter ASCII ('0'-'9')
2145+ 8DDF 77               LD     (HL),A
2146+ 8DE0 E1               POP    HL
2147+ 8DE1 1C               INC    E                      ; avanza el offset para el siguiente digito
2148+ 8DE2 C9               RET
2149+ 8DE3              ; 0x8DE3-0x8DFD (27 bytes): NO es codigo -- el desensamblado lineal
2150+ 8DE3              ; se desincroniza aqui (confirmado: las bytes $30,$30 del relleno
2151+ 8DE3              ; de digitos decodifican por casualidad como "JR NC,+48" y
2152+ 8DE3              ; caen sobre etiquetas reales de mas abajo, puro azar de valores).
2153+ 8DE3              ; Es una zona de datos real, con 3 partes:
2154+ 8DE3              ;  - DIVISORES_PUNTUACION ($8DE3): 3 palabras (1000,100,10) usadas por
2155+ 8DE3              ;    DIBUJAR_MARCADOR_PUNTOS_DIGITOS para extraer digitos decimales de la
2156+ 8DE3              ;    puntuacion por resta repetida (algoritmo clasico).
2157+ 8DE3              ;  - BUFFER_DIGITOS_PUNTUACION ($8DE9): 6 bytes ASCII inicializados a
2158+ 8DE3              ;    "000000", donde .EMITIR_DIGITO escribe cada digito calculado;
2159+ 8DE3              ;    terminados en $FF (indice de fin de lista para DIBUJAR_TEXTO_INVERTIDO_VRAM).
2160+ 8DE3              ;    REDIBUJAR_PANTALLA_COMPLETA_BUFFER_VRAM (bloque anterior, $8C34) reinicia este buffer
2161+ 8DE3              ;    a "000000" con un LDIR antes de cada redibujado si hay que
2162+ 8DE3              ;    limpiarlo.
2163+ 8DE3              ;  - Dos textos alternativos al marcador numerico, tambien listas
2164+ 8DE3              ;    de indices terminadas en $FF, usados por DIBUJAR_MARCADOR_PUNTOS segun el
2165+ 8DE3              ;    caso: TEXTO_BESTIA ($8DF0, "BESTIA") se usa cuando la
2166+ 8DE3              ;    puntuacion acumulada llega a $2710 (10000) en vez de seguir
2167+ 8DE3              ;    contando -- un "premio" de texto en vez de numero. TEXTO_DEMO
2168+ 8DE3              ;    ($8DF7, " DEMO ") se usa cuando ($60CA) es distinto de cero,
2169+ 8DE3              ;    consistente con un flag de modo demostracion (ver TAIL_* en
2170+ 8DE3              ;    madmix_scr.asm). Los indices coinciden con el codigo ASCII de
2171+ 8DE3              ;    cada letra porque, aparentemente, la tabla de fuente en
2172+ 8DE3              ;    $935B (ver DIBUJAR_TEXTO_INVERTIDO_VRAM mas abajo) esta indexada igual que ASCII
2173+ 8DE3              ;    para ese rango de caracteres -- no confirmado en detalle.
2174+ 8DE3              DIVISORES_PUNTUACION:
2175+ 8DE3 E8 03 64 00      DB $E8,$03,$64,$00,$0A,$00
2175+ 8DE7 0A 00
2176+ 8DE9              BUFFER_DIGITOS_PUNTUACION:
2177+ 8DE9 30 30 30 30      DB "000000",$FF
2177+ 8DED 30 30 FF
2178+ 8DF0              TEXTO_BESTIA:
2179+ 8DF0 42 45 53 54      DB "BESTIA",$FF
2179+ 8DF4 49 41 FF
2180+ 8DF7              TEXTO_DEMO:
2181+ 8DF7 20 44 45 4D      DB " DEMO ",$FF
2181+ 8DFB 4F 20 FF
2182+ 8DFE              ; --- Dibuja una cadena de texto: IX apunta a una lista de codigos de
2183+ 8DFE              ; caracter terminada en $FF (formato de TEXTO_FASE/TEXTO_READY/
2184+ 8DFE              ; TEXTO_BESTIA/etc, ver mas abajo). Por cada codigo calcula la
2185+ 8DFE              ; direccion real del glifo ($925B + codigo*8, formula confirmada --
2186+ 8DFE              ; ver TABLA_FUENTE_CARACTERES/ICONO_VIDA_EXTRA en FINDINGS.md) y vuelca sus
2187+ 8DFE              ; 8 filas a VRAM (via SETVRAM, $8954), invirtiendo cada byte (CPL,
2188+ 8DFE              ; mismo truco "negado" que el icono de vida) y escribiendolo dos
2189+ 8DFE              ; veces por fila -- avanza el cursor 8 columnas por caracter hasta
2190+ 8DFE              ; leer el $FF de fin de cadena. ---
2191+ 8DFE              DIBUJAR_TEXTO_INVERTIDO_VRAM:
2192+ 8DFE EB               EX     DE,HL                  ; DE = puntero a la lista de codigos de caracter (parametro de entrada en HL)
2193+ 8DFF              DIBUJAR_TEXTO_INVERTIDO_VRAM_LOOP:
2194+ 8DFF DD 7E 00         LD     A,(IX+$00)             ; A = codigo de caracter actual
2195+ 8E02 DD 23            INC    IX
2196+ 8E04 FE FF            CP     $FF                    ; centinela de fin de cadena
2197+ 8E06 C8               RET    Z
2198+ 8E07 D5               PUSH   DE                     ; guarda la posicion VRAM del cursor
2199+ 8E08 6F               LD     L,A
2200+ 8E09 26 00            LD     H,0                    ; HL = codigo (extendido a 16 bits)
2201+ 8E0B 29               ADD    HL,HL
2202+ 8E0C 29               ADD    HL,HL
2203+ 8E0D 29               ADD    HL,HL                  ; HL = codigo*8
2204+ 8E0E 25               DEC    H                      ; HL -= 256
2205+ 8E0F 01 5B 93         LD     BC,$935B               ; base de la formula de glifo (8 bytes antes de TABLA_FUENTE_CARACTERES)
2206+ 8E12 09               ADD    HL,BC                  ; HL = direccion del glifo ($925B + codigo*8)
2207+ 8E13 06 08            LD     B,8                    ; contador del bucle: 8 filas del caracter
2208+ 8E15 F3               DI
2209+ 8E16              .BUCLE_FILAS_CARACTER:
2210+ 8E16 EB               EX     DE,HL                  ; DE = direccion del glifo (temporalmente)
2211+ 8E17 CD 54 89         CALL   SETVRAM                ; posiciona el puntero VRAM en el cursor (en DE)
2212+ 8E1A EB               EX     DE,HL                  ; recupera HL = direccion del glifo
2213+ 8E1B              .DIBUJAR_FILA_CARACTER:
2214+ 8E1B 7E               LD     A,(HL)                 ; A = byte de fuente de esta fila
2215+ 8E1C 2F               CPL                           ; invierte el byte (modo invertido)
2216+ 8E1D D3 98            OUT    ($98),A                ; escribe el byte invertido a VRAM
2217+ 8E1F 00               NOP
2218+ 8E20 00               NOP
2219+ 8E21 00               NOP
2220+ 8E22 1C               INC    E                      ; avanza a la siguiente columna VRAM
2221+ 8E23 D3 98            OUT    ($98),A                ; vuelve a escribir el mismo byte (columna duplicada)
2222+ 8E25 1C               INC    E
2223+ 8E26 23               INC    HL                     ; siguiente byte de fuente (fila siguiente)
2224+ 8E27 7B               LD     A,E
2225+ 8E28 E6 06            AND    $06                    ; mascara de bits para decidir si hace falta envolver de franja VRAM
2226+ 8E2A C2 32 8E         JP     NZ,.FIN_FILA
2227+ 8E2D 7B               LD     A,E
2228+ 8E2E D6 08            SUB    8                      ; retrocede la columna 8 posiciones
2229+ 8E30 5F               LD     E,A
2230+ 8E31 14               INC    D                      ; avanza a la siguiente franja/tercio de VRAM
2231+ 8E32              .FIN_FILA:
2232+ 8E32 10 E2            DJNZ   .BUCLE_FILAS_CARACTER
2233+ 8E34 FB               EI
2234+ 8E35 D1               POP    DE                     ; recupera la posicion VRAM del cursor
2235+ 8E36 7B               LD     A,E
2236+ 8E37 C6 08            ADD    A,8                    ; avanza el cursor 8 columnas para el siguiente caracter
2237+ 8E39 5F               LD     E,A
2238+ 8E3A 18 C3            JR     DIBUJAR_TEXTO_INVERTIDO_VRAM_LOOP
2239+ 8E3C              ; --- Lectura de teclado/joystick (JT_LEER_ENTRADA). Puerta de bloqueo en
2240+ 8E3C              ; FLAG_ENTRADA_BLOQUEADA (bit 0 -- si esta activo, RET inmediato; ver
2241+ 8E3C              ; PREPARAR_INICIO_NIVEL/BUSCAR_COLUMNA_HUD, que lo activa mientras dura
2242+ 8E3C              ; la animacion de busqueda del HUD). El parametro A decide si limpiar
2243+ 8E3C              ; ACUMULADOR_ENTRADA ($8EC4, byte "libre" del bloque reservado justo
2244+ 8E3C              ; antes de TABLA_TIPOS_LOSETA) antes de leer (A=0, lectura fresca) o acumular
2245+ 8E3C              ; sobre el valor ya existente
2246+ 8E3C              ; (A!=0, permite ir juntando bits de varias llamadas seguidas -- ver
2247+ 8E3C              ; los AND $3F/AND $06 que comprueban bits concretos en otros sitios).
2248+ 8E3C              ; Segun (MODO_ENTRADA) despacha a:
2249+ 8E3C              ;  - LEER_TECLADO (si MODO_ENTRADA=0): escanea la matriz de
2250+ 8E3C              ;    teclado estandar (5 pares puerto/mascara de TABLA_TECLAS_MSX:
2251+ 8E3C              ;    arriba/abajo/izquierda/derecha/disparo) mas 1 prueba extra de
2252+ 8E3C              ;    puerto (COMPROBAR_PAUSA, mismo mecanismo -- CONFIRMADO: las 6
2253+ 8E3C              ;    acciones redefinibles del menu son "PAUSA/FUEGO/ARRIBA/ABAJO/
2254+ 8E3C              ;    IZQUIERDA/DERECHA", asi que esta 6a prueba compartida es la
2255+ 8E3C              ;    tecla de PAUSA, leida siempre por teclado incluso en modo
2256+ 8E3C              ;    joystick), componiendo bit a bit en E (RL E, desplaza un 1 o un
2257+ 8E3C              ;    0 segun COMPROBAR_TECLA_MSX) hasta 6 bits.
2258+ 8E3C              ;  - LEER_JOYSTICK (si MODO_ENTRADA!=0): lee el joystick por el puerto
2259+ 8E3C              ;    del PSG, y tambien cae en COMPROBAR_PAUSA para la misma 6a
2260+ 8E3C              ;    prueba compartida.
2261+ 8E3C              ; NOTA: la polaridad de MODO_ENTRADA aqui (0 -> escaneo de teclado)
2262+ 8E3C              ; parece invertida respecto a como quedo etiquetado en
2263+ 8E3C              ; madmix_scr_body.asm -- CONFIRMADO con los valores reales: TI_5C60
2264+ 8E3C              ; (opcion de menu "1 TECLADO") escribe MODO_ENTRADA=1, TI_5C70
2265+ 8E3C              ; ("2 JOYSTICK") escribe MODO_ENTRADA=0 -- exactamente al reves de lo
2266+ 8E3C              ; que interpreta este despachador (1 -> joystick, 0 -> teclado).
2267+ 8E3C              ; Pendiente verificar en vivo si es un bug real del original o si
2268+ 8E3C              ; algun otro sitio sin localizar vuelve a tocar la variable entre la
2269+ 8E3C              ; seleccion del menu y la partida. ---
2270+ 8E3C              LEER_ENTRADA:
2271+ 8E3C 21 C6 8E         LD     HL,FLAG_ENTRADA_BLOQUEADA
2272+ 8E3F CB 46            BIT    0,(HL)
2273+ 8E41 C0               RET    NZ
2274+ 8E42 21 C4 8E         LD     HL,ACUMULADOR_ENTRADA
2275+ 8E45 A7               AND    A
2276+ 8E46 20 01            JR     NZ,.CONTINUAR_TRAS_LIMPIAR_ACUMULADOR
2277+ 8E48 77               LD     (HL),A
2278+ 8E49              .CONTINUAR_TRAS_LIMPIAR_ACUMULADOR:
2279+ 8E49 3A 27 84         LD     A,(MODO_ENTRADA)
2280+ 8E4C A7               AND    A
2281+ 8E4D 28 03            JR     Z,LEER_TECLADO
2282+ 8E4F C3 94 8E         JP     LEER_JOYSTICK
2283+ 8E52              ; --- ESCANEAR_FILAS_TECLADO: bucle generico y REUTILIZABLE de escaneo
2284+ 8E52              ; de matriz de teclado -- IX=tabla de B parejas (fila,mascara), E=0 al
2285+ 8E52              ; entrar, devuelve en E los B bits leidos (desplazados con RL, 1=tecla
2286+ 8E52              ; pulsada). CONFIRMADO compartido: ademas de LEER_TECLADO (5 teclas de
2287+ 8E52              ; control + PAUSA en COMPROBAR_PAUSA), lo llama directo TAIL_FONT_ROUTINE
2288+ 8E52              ; (madmix_scr_body.asm, con su propia tabla TAIL_UNK_5C93 de 6 parejas,
2289+ 8E52              ; todas fila $F0) para leer el menu principal -- pese a su nombre
2290+ 8E52              ; ("FONT"), en realidad es el lector de teclas del menu (su resultado
2291+ 8E52              ; en E se comprueba bit a bit justo despues de la llamada). ---
2292+ 8E52              LEER_TECLADO:
2293+ 8E52 DD 21 88 8E      LD     IX,TABLA_TECLAS_MSX
2294+ 8E56 1E 00            LD     E,$00
2295+ 8E58 06 05            LD     B,$05
2296+ 8E5A              ESCANEAR_FILAS_TECLADO:
2297+ 8E5A CD 7D 8E         CALL   COMPROBAR_TECLA_MSX              ; lee un puerto de la matriz (tabla[IX])
2298+ 8E5D 20 06            JR     NZ,.TECLA_NO_PULSADA        ; tecla no pulsada -> mete un 0 en E (abajo)
2299+ 8E5F 37               SCF
2300+ 8E60 CB 13            RL     E                            ; tecla pulsada -> mete un 1 en E (desplazando)
2301+ 8E62 C3 68 8E         JP     .CONTINUAR_BUCLE_TECLAS
2302+ 8E65              .TECLA_NO_PULSADA:
2303+ 8E65 A7               AND    A
2304+ 8E66 CB 13            RL     E
2305+ 8E68              .CONTINUAR_BUCLE_TECLAS:
2306+ 8E68 DD 23            INC    IX
2307+ 8E6A DD 23            INC    IX
2308+ 8E6C 10 EC            DJNZ   ESCANEAR_FILAS_TECLADO
2309+ 8E6E              COMPROBAR_PAUSA:
2310+ 8E6E DD 21 92 8E      LD     IX,TABLA_TECLAS_MSX+10        ; 6a prueba de puerto: tecla PAUSA (mismo mecanismo, entrada final de la tabla)
2311+ 8E72 CD 7D 8E         CALL   COMPROBAR_TECLA_MSX
2312+ 8E75 20 02            JR     NZ,.FINALIZAR_LECTURA
2313+ 8E77 CB EB            SET    5,E
2314+ 8E79              .FINALIZAR_LECTURA:
2315+ 8E79 7B               LD     A,E
2316+ 8E7A B6               OR     (HL)                        ; funde (OR) los 6 bits leidos con ACUMULADOR_ENTRADA
2317+ 8E7B 77               LD     (HL),A
2318+ 8E7C C9               RET
2319+ 8E7D              COMPROBAR_TECLA_MSX:                            ; IX+0=numero de fila/puerto, IX+1=mascara de bit -- lee y enmascara
2320+ 8E7D DD 7E 00         LD     A,(IX+$00)
2321+ 8E80 D3 AA            OUT    ($AA),A
2322+ 8E82 DB A9            IN     A,($A9)
2323+ 8E84 DD A6 01         AND    (IX+$01)
2324+ 8E87 C9               RET
2325+ 8E88
2326+ 8E88              ; 0x8E88-0x8E93 (12 bytes): NO es codigo -- tabla de datos real
2327+ 8E88              ; (5 pares puerto/mascara para el bucle de LEER_TECLADO -- arriba/
2328+ 8E88              ; abajo/izquierda/derecha/disparo -- + 1 par para la tecla de PAUSA de
2329+ 8E88              ; COMPROBAR_PAUSA, todos leidos via COMPROBAR_TECLA_MSX con IX
2330+ 8E88              ; indexado). El desensamblado lineal se desincroniza aqui igual
2331+ 8E88              ; que en el bloque BESTIA/DEMO de mas arriba -- confirmado
2332+ 8E88              ; realineando el desensamblado a partir de 0x8E94 (siguiente
2333+ 8E88              ; instruccion real), que ya NO coincide con lo que parecia salir
2334+ 8E88              ; de seguir leyendo en linea recta.
2335+ 8E88              TABLA_TECLAS_MSX:
2336+ 8E88 F8 01            DB $F8,$01                 ; offset 0: arriba
2337+ 8E8A F4 40            DB $F4,$40                 ; offset 2: abajo
2338+ 8E8C F2 40            DB $F2,$40                 ; offset 4: izquierda
2339+ 8E8E F4 10            DB $F4,$10                 ; offset 6: derecha
2340+ 8E90 F4 20            DB $F4,$20                 ; offset 8: disparo
2341+ 8E92 F3 20            DB $F3,$20                 ; offset 10: pausa (COMPROBAR_PAUSA)
2342+ 8E94              LEER_JOYSTICK:
2343+ 8E94 3E 07            LD     A,$07
2344+ 8E96 D3 A0            OUT    ($A0),A
2345+ 8E98 DB A2            IN     A,($A2)
2346+ 8E9A F6 C0            OR     $C0
2347+ 8E9C F5               PUSH   AF
2348+ 8E9D 3E 07            LD     A,$07
2349+ 8E9F D3 A0            OUT    ($A0),A
2350+ 8EA1 F1               POP    AF
2351+ 8EA2 CD 8A DD         CALL   CONFIGURAR_Y_LEER_JOYSTICK_PSG  ; termina de poner el mezclador en modo entrada y lee el registro 14 (joystick 1)
2352+ 8EA5 00               NOP
2353+ 8EA6 1E 00            LD     E,$00
2354+ 8EA8 1F               RRA                            ; bit0 = arriba
2355+ 8EA9 38 02            JR     C,.COMPROBAR_ABAJO
2356+ 8EAB CB DB            SET    3,E
2357+ 8EAD              .COMPROBAR_ABAJO:
2358+ 8EAD 1F               RRA                            ; bit1 = abajo
2359+ 8EAE 38 02            JR     C,.COMPROBAR_IZQUIERDA
2360+ 8EB0 CB D3            SET    2,E
2361+ 8EB2              .COMPROBAR_IZQUIERDA:
2362+ 8EB2 1F               RRA                            ; bit2 = izquierda
2363+ 8EB3 38 02            JR     C,.COMPROBAR_DERECHA
2364+ 8EB5 CB CB            SET    1,E
2365+ 8EB7              .COMPROBAR_DERECHA:
2366+ 8EB7 1F               RRA                            ; bit3 = derecha
2367+ 8EB8 38 02            JR     C,.COMPROBAR_DISPARO
2368+ 8EBA CB C3            SET    0,E
2369+ 8EBC              .COMPROBAR_DISPARO:
