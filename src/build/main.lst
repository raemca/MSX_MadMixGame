 517+ 2D2B 3A 0F 2C         LD A, (MODO_ESPECIAL_ACTIVO)                     ; vuelve a comprobar el temporizador de modo especial...
 518+ 2D2E A7               AND A
 519+ 2D2F 3A 2D 2C         LD A, (MODO_ESPECIAL)                       ; ...pero carga en A el ID de modo especial (($2C2D)) para lo
 520+ 2D32 20 03            JR NZ, TICK_MODO_ESPECIAL                       ; que sigue -- si el temporizador esta activo, salta a tratar
 521+ 2D34 A7               AND A                                  ; el modo especial en si (TICK_MODO_ESPECIAL); si no, despacha derecho
 522+ 2D35 DD E9            JP (IX)                                 ; al manejador de tipo de loseta normal
 523+ 2D37              ; --- Con un modo especial en curso ($2C0F!=0): decrementa su
 524+ 2D37              ; temporizador de duracion ($2C0E) y, distinguiendo modo 1 (bola de
 525+ 2D37              ; poder) de modo 2 (hipopotamo) via el ID en E, actualiza el icono de
 526+ 2D37              ; HUD correspondiente; al llegar el temporizador a 0 vacia el gestor
 527+ 2D37              ; de recursos y apaga los flags de modo (($2C0D)/($2C2D)). Para
 528+ 2D37              ; cualquier otro modo (3/8/9...) esto no hace nada y cae directo a
 529+ 2D37              ; OBTENER_SUBTABLA_DIRECCION. ---
 530+ 2D37              TICK_MODO_ESPECIAL:
 531+ 2D37 E6 07            AND $07
 532+ 2D39 5F               LD E, A
 533+ 2D3A FE 01            CP 1                      ; modo especial 1 = bola de poder
 534+ 2D3C 20 23            JR NZ, TICK_MODO_HIPOPOTAMO
 535+ 2D3E 21 0E 2C         LD HL, MODO_ESPECIAL_CUENTA_ATRAS                ; contador de duracion del modo (decrementado cada frame)
 536+ 2D41 35               DEC (HL)
 537+ 2D42 28 13            JR Z, FIN_MODO_BOLA_PODER                 ; llega a 0 justo ahora -> termina el modo
 538+ 2D44 7E               LD A, (HL)
 539+ 2D45 FE 3C            CP 60
 540+ 2D47 30 18            JR NC, TICK_MODO_HIPOPOTAMO                  ; todavia queda tiempo de sobra -> nada mas que hacer
 541+ 2D49 E6 01            AND $01
 542+ 2D4B 3E 30            LD A, $30
 543+ 2D4D 28 03            JR Z, PARPADEO_COLOR_BOLA_PODER                     ; parpadeo del icono de HUD en los ultimos instantes del modo
 544+ 2D4F 3A 18 2C         LD A, (COLOR_GUARDADO)
 545+ 2D52              PARPADEO_COLOR_BOLA_PODER:
 546+ 2D52 32 24 2C         LD (COLOR_ACTUAL), A
 547+ 2D55 18 0A            JR TICK_MODO_HIPOPOTAMO
 548+ 2D57              FIN_MODO_BOLA_PODER:
 549+ 2D57 CD 8B CF         CALL VACIAR_CANALES_SONIDO                ; "vacia" ranuras de recurso (gestor de recursos)
 550+ 2D5A AF               XOR A
 551+ 2D5B 32 0D 2C         LD (MODO_ESPECIAL_FLAG), A               ; apaga los flags de modo especial -- vuelve al juego normal
 552+ 2D5E 32 2D 2C         LD (MODO_ESPECIAL), A
 553+ 2D61              ; --- Mismo patron que arriba pero para el modo especial 2
 554+ 2D61              ; (hipopotamo): decrementa ($2C0E), y en los ultimos instantes
 555+ 2D61              ; alterna el bit 6 del icono de HUD (TABLA_POSICIONES_HUD+17) por XOR en vez de elegir
 556+ 2D61              ; entre dos valores fijos -- parpadeo equivalente, implementado
 557+ 2D61              ; distinto. Al agotarse el temporizador (FIN_MODO_HIPOPOTAMO), igual que el modo
 558+ 2D61              ; 1: vacia flags y sale por OBTENER_SUBTABLA_DIRECCION. ---
 559+ 2D61              TICK_MODO_HIPOPOTAMO:
 560+ 2D61 FE 02            CP 2                      ; modo especial 2 = hipopotamo
 561+ 2D63 20 29            JR NZ, OBTENER_SUBTABLA_DIRECCION
