4247+ 6045              ; --- Motor de "ciclado de niveles de muestra": recorre una tabla de
4248+ 6045              ; 4 entradas [nivel,puntero] en $60D0 (corregido: el bucle compara
4249+ 6045              ; contra $04, no 6), fija $2C07 al nivel indicado y llama a
4250+ 6045              ; CARGAR_NIVEL/INICIALIZAR_ITEMS_NIVEL/JT_REDIBUJAR_PANTALLA_COMPLETA_BUFFER_VRAM/JT_LEER_ENTRADA para dibujarlo, esperando
4251+ 6045              ; entrada antes de pasar al siguiente (o volver al 0). Cada puntero
4252+ 6045              ; apunta a uno de los 10 guiones de reproduccion automatica en
4253+ 6045              ; madmix1.asm (DEMO_SCRIPT_NIVEL1/2/4/5, 0xD500 en adelante): pares
4254+ 6045              ; [duracion en fotogramas, direccion simulada] terminados en
4255+ 6045              ; direccion $FF -- .REPRODUCIR_GUION_DEMO/.COMPROBAR_FIN_GUION mas abajo son quienes leen y
4256+ 6045              ; reproducen ese guion byte a byte. Los otros 6 guiones de esa tabla
4257+ 6045              ; (DEMO_SCRIPT_SINREF_1..6) no estan referenciados por ningun
4258+ 6045              ; puntero de aqui -- ver FINDINGS.md. ---
4259+ 6045              GESTIONAR_CICLO_NIVELES:                ; $6045
4260+ 6045 AF               XOR A
4261+ 6046 32 CA 60         LD (INDICE_CICLO_NIVELES), A
4262+ 6049 32 01 FC         LD ($FC01), A
4263+ 604C 32 00 FC         LD ($FC00), A
4264+ 604F              .BUCLE_NIVEL_DEMO:
4265+ 604F 21 CA 60         LD HL, INDICE_CICLO_NIVELES
4266+ 6052 7E               LD A, (HL)
4267+ 6053 34               INC (HL)
4268+ 6054 FE 04            CP $04
4269+ 6056 CA C5 60         JP Z, .FIN_CICLO_NIVELES
4270+ 6059 6F               LD L, A
4271+ 605A 87               ADD A, A
4272+ 605B 85               ADD A, L
4273+ 605C 21 D0 60         LD HL, TABLA_CICLO_NIVELES
4274+ 605F 85               ADD A, L
4275+ 6060 6F               LD L, A
4276+ 6061 7C               LD A, H
4277+ 6062 CE 00            ADC A, $00
4278+ 6064 67               LD H, A
4279+ 6065 7E               LD A, (HL)
4280+ 6066 32 07 2C         LD (NIVEL_ACTUAL), A
4281+ 6069 23               INC HL
4282+ 606A 4E               LD C, (HL)
4283+ 606B 23               INC HL
4284+ 606C 46               LD B, (HL)
4285+ 606D ED 43 CB 60      LD (PUNTERO_GUION_DEMO), BC
4286+ 6071 AF               XOR A
4287+ 6072 32 27 2C         LD (VIDAS_RESTANTES), A
4288+ 6075 32 0F 2C         LD (MODO_ESPECIAL_ACTIVO), A
4289+ 6078 CD 04 59         CALL CARGAR_NIVEL
4290+ 607B CD 85 58         CALL INICIALIZAR_ITEMS_NIVEL
4291+ 607E CD 34 8C         CALL REDIBUJAR_PANTALLA_COMPLETA_BUFFER_VRAM
4292+ 6081 CD 54 64         CALL APLICAR_COLOR_PANTALLA
4293+ 6084 AF               XOR A
4294+ 6085 32 CD 60         LD (CONTADOR_FRAME_GUION_DEMO), A
4295+ 6088              .REPRODUCIR_GUION_DEMO:
4296+ 6088 CD 3C 8E         CALL LEER_ENTRADA
4297+ 608B AF               XOR A
4298+ 608C 32 0F 2C         LD (MODO_ESPECIAL_ACTIVO), A
4299+ 608F DD 2A CB 60      LD IX, (PUNTERO_GUION_DEMO)
4300+ 6093 21 CD 60         LD HL, CONTADOR_FRAME_GUION_DEMO
4301+ 6096 34               INC (HL)
4302+ 6097 7E               LD A, (HL)
4303+ 6098 DD BE 00         CP (IX+0)
4304+ 609B DD 7E 01         LD A, (IX+1)
4305+ 609E 38 0D            JR C, .COMPROBAR_FIN_GUION
4306+ 60A0 DD 23            INC IX
4307+ 60A2 DD 23            INC IX
4308+ 60A4 36 00            LD (HL), $00
4309+ 60A6 DD 7E 01         LD A, (IX+1)
4310+ 60A9 DD 22 CB 60      LD (PUNTERO_GUION_DEMO), IX
4311+ 60AD              .COMPROBAR_FIN_GUION:
4312+ 60AD FE FF            CP $FF
4313+ 60AF CA 4F 60         JP Z, .BUCLE_NIVEL_DEMO
4314+ 60B2 E6 1F            AND $1F
4315+ 60B4 57               LD D, A
4316+ 60B5 CD 36 2C         CALL ENLACE_MOTOR_MOVIMIENTO_COLISION
4317+ 60B8 CD A0 89         CALL WAIT_VBLANK               ; WAIT_VBLANK (madmix1.asm)
4318+ 60BB CD 06 91         CALL ACTUALIZAR_LOSETA_BOLA_ESPECIAL
4319+ 60BE CD 0A 5D         CALL COMPROBAR_PULSACION
4320+ 60C1 20 02            JR NZ, .FIN_CICLO_NIVELES
4321+ 60C3 18 C3            JR .REPRODUCIR_GUION_DEMO
4322+ 60C5              .FIN_CICLO_NIVELES:
4323+ 60C5 AF               XOR A
4324+ 60C6 32 CA 60         LD (INDICE_CICLO_NIVELES), A
4325+ 60C9 C9               RET
4326+ 60CA
4327+ 60CA                  ; $60CA-$60CF: NO es cola inerte -- es el estado real del ciclador
4328+ 60CA                  ; de niveles de muestra (compila con los valores de fabrica de
4329+ 60CA                  ; abajo, se reinicializa en GESTIONAR_CICLO_NIVELES/.FIN_CICLO_NIVELES).
4330+ 60CA              INDICE_CICLO_NIVELES:                  ; $60CA -- indice 0-3 del nivel de muestra en curso (0 = ciclador inactivo)
4331+ 60CA 00               DB $00
4332+ 60CB              PUNTERO_GUION_DEMO:                    ; $60CB-$60CC -- cursor dentro del guion de demo activo
4333+ 60CB 00 00            DW $00
4334+ 60CD              CONTADOR_FRAME_GUION_DEMO:             ; $60CD -- fotogramas transcurridos en la entrada actual del guion
4335+ 60CD 01               DB $01
4336+ 60CE 00 FC            DB $00,$FC          ; $60CE-$60CF: cola/alineacion antes de la tabla, sin consumidor confirmado
4337+ 60D0
4338+ 60D0                  ; $60D0-$60DB (12 bytes): tabla de 4 entradas [nivel, puntero
4339+ 60D0                  ; 2 bytes] para el ciclador de arriba. Los punteros caen dentro de
4340+ 60D0                  ; MADMIX1.BIN -- son GUION_DEMO_NIVEL1 ($D524, el arranque real
4341+ 60D0                  ; del guion, ver FINDINGS.md/madmix1_body.asm sobre $D500-$D524 --
4342+ 60D0                  ; nunca fue guion, siempre cola del cuerpo del nivel 14),
4343+ 60D0                  ; GUION_DEMO_NIVEL2 ($D564), GUION_DEMO_NIVEL4 ($D5D4) y
4344+ 60D0                  ; GUION_DEMO_NIVEL5 ($D644) -- ver madmix1_body.asm y FINDINGS.md.
4345+ 60D0              TABLA_CICLO_NIVELES:
4346+ 60D0 01               DB 1
4347+ 60D1 24 D5            DW GUION_DEMO_NIVEL1
4348+ 60D3 02               DB 2
4349+ 60D4 64 D5            DW GUION_DEMO_NIVEL2
4350+ 60D6 04               DB 4
4351+ 60D7 D4 D5            DW GUION_DEMO_NIVEL4
4352+ 60D9 05               DB 5
4353+ 60DA 44 D6            DW GUION_DEMO_NIVEL5
4354+ 60DC
4355+ 60DC              ; --- RESUELTO -- esta es la pieza que confirma que EVENTO_SONIDO_PENDIENTE es el
4356+ 60DC              ; INDICE DE EFECTO DE SONIDO (ver FINDINGS.md): llamada desde ENTRADA_INTERRUPCION_VBLANK
4357+ 60DC              ; en CADA VBLANK. Si EVENTO_SONIDO_PENDIENTE != $FF (hay un evento pendiente), lo marca
4358+ 60DC              ; consumido y lo usa como indice (x3) en TABLA_RECURSOS_SONIDO_EVENTO
4359+ 60DC              ; [canal, puntero] para instalar ese script en el reproductor PSG
4360+ 60DC              ; ($C4A0 = INSTALAR_RECURSO_SONIDO); en cualquier caso, SIEMPRE llama
4361+ 60DC              ; a $C4EB (TICK_REPRODUCTOR_PSG en madmix1.asm, el "tick" real del
4362+ 60DC              ; reproductor). ---
4363+ 60DC              DESPACHAR_EFECTO_SONIDO:              ; $60DC
4364+ 60DC 21 28 61         LD HL, EVENTO_SONIDO_PENDIENTE
4365+ 60DF 7E               LD A, (HL)
4366+ 60E0 FE FF            CP $FF
4367+ 60E2 28 16            JR Z, .TICK_SIEMPRE             ; $FF = nada pendiente -- salta directo al tick
4368+ 60E4 36 FF            LD (HL), $FF                ; marca el evento como consumido
4369+ 60E6 21 FE 60         LD HL, TABLA_RECURSOS_SONIDO_EVENTO
4370+ 60E9 47               LD B, A
4371+ 60EA 87               ADD A, A
4372+ 60EB 80               ADD A, B
4373+ 60EC 85               ADD A, L
4374+ 60ED 6F               LD L, A
4375+ 60EE 7C               LD A, H
4376+ 60EF CE 00            ADC A, $00
4377+ 60F1 67               LD H, A
4378+ 60F2 7E               LD A, (HL)
4379+ 60F3 23               INC HL
4380+ 60F4 5E               LD E, (HL)
4381+ 60F5 23               INC HL
4382+ 60F6 56               LD D, (HL)
4383+ 60F7 CD A0 C4         CALL INSTALAR_RECURSO_SONIDO
4384+ 60FA              .TICK_SIEMPRE:
4385+ 60FA CD EB C4         CALL TICK_REPRODUCTOR_PSG                ; TICK_REPRODUCTOR_PSG (madmix1.asm): tick del reproductor, siempre
4386+ 60FD C9               RET
4387+ 60FE
4388+ 60FE                  ; $60FE en adelante: tabla de recursos [id,puntero] indexada por
4389+ 60FE                  ; el helper anterior, seguida de un bloque grande (~810 bytes)
4390+ 60FE                  ; con forma de patron grafico (silueta monocroma al estilo de
4391+ 60FE                  ; las losetas del juego) -- probablemente el logo/decoracion de
4392+ 60FE                  ; estas pantallas. Verificado byte a byte, sin decodificar campo
4393+ 60FE                  ; a campo.
4394+ 60FE              TABLA_RECURSOS_SONIDO_EVENTO:
4395+ 60FE 00 E2 CE 00      DB $00,$E2,$CE,$00,$8B,$CE,$00,$62,$CF,$01,$70,$CF,$00,$72,$CE,$01
4395+ 6102 8B CE 00 62
4395+ 6106 CF 01 70 CF
4395+ 610A 00 72 CE 01
4396+ 610E 44 CF 01 AC      DB $44,$CF,$01,$AC,$CE,$01,$7E,$CE,$00,$07,$CF,$00,$5A,$CE,$00,$F0
4396+ 6112 CE 01 7E CE
4396+ 6116 00 07 CF 00
4396+ 611A 5A CE 00 F0
4397+ 611E CE 02 9C CE      DB $CE,$02,$9C,$CE,$00,$CB,$CD,$02,$27,$CF
4397+ 6122 00 CB CD 02
4397+ 6126 27 CF
4398+ 6128                  ; ultimo byte de la fila: NO es parte de la tabla (14 entradas x 3
4399+ 6128                  ; bytes = 42, terminan en el $CF de arriba) -- es EVENTO_SONIDO_PENDIENTE,
4400+ 6128                  ; el marcador de evento/indice de efecto de sonido a disparar,
4401+ 6128                  ; leido/escrito por DESPACHAR_EFECTO_SONIDO en cada VBLANK.
4402+ 6128              EVENTO_SONIDO_PENDIENTE:
4403+ 6128 00               DB $00
4404+ 6129              ; --- 0x6129-0x6429 (768 bytes): color real del marco de caramelo,
4405+ 6129              ; extraido a data/img/marco_caramelo_color.img (ver FINDINGS.md --
4406+ 6129              ; APLICAR_COLOR_PANTALLA lo traduce con OBTENER_COLOR_VDP y rellena la
4407+ 6129              ; tabla de color de VRAM, verificado exacto contra un volcado de
4408+ 6129              ; VRAM real). ---
4409+ 6129              TABLA_COLOR_MARCO_CARAMELO:
4410+ 6129                  INCBIN "data/img/marco_caramelo_color.img"
4411+ 6429
4412+ 6429              ; --- CORREGIDO: el comentario anterior aqui describia en realidad
4413+ 6429              ; APLICAR_COLOR_PANTALLA (el bloque de "TABLA_COLOR_MARCO_CARAMELO, id+8 bytes") y
4414+ 6429              ; APLICAR_COLOR_CICLO_NIVELES ($647C, una funcion DISTINTA, no un
4415+ 6429              ; segundo punto de entrada de esta). Lo que esta funcion hace de
4416+ 6429              ; verdad: limpia la tabla de color de VRAM ($2000, FILVRM con $01) y
4417+ 6429              ; luego descomprime TABLA_RLE_MARCO_CARAMELO (870 bytes, pares [valor,contador])
4418+ 6429              ; volcando el resultado con FILVRM directo a la tabla de patrones de
4419+ 6429              ; VRAM (destino arranca en 0) -- dibuja la FORMA del marco de
4420+ 6429              ; caramelo. Su "hermana" es APLICAR_COLOR_PANTALLA, que aplica el COLOR de
4421+ 6429              ; ese mismo marco leyendo TABLA_RECURSOS_SONIDO_EVENTO/TABLA_COLOR_MARCO_CARAMELO. ---
4422+ 6429              DIBUJAR_MARCO_CARAMELO_VRAM:              ; $6429
4423+ 6429 F3               DI
4424+ 642A 21 00 20         LD HL, $2000
4425+ 642D 01 F8 17         LD BC, $17F8
4426+ 6430 3E 01            LD A, $01
4427+ 6432 CD 31 89         CALL FILVRM              ; equivalente a la rutina FILVRM del BIOS de MSX
4428+ 6435 11 00 00         LD DE, $0000
4429+ 6438 21 B6 D6         LD HL, TABLA_RLE_MARCO_CARAMELO
4430+ 643B 01 66 03         LD BC, $0366
4431+ 643E              .BUCLE_DESCOMPRIMIR_MARCO:
4432+ 643E C5               PUSH BC
4433+ 643F 7E               LD A, (HL)
4434+ 6440 23               INC HL
4435+ 6441 4E               LD C, (HL)
4436+ 6442 06 00            LD B, $00
4437+ 6444 23               INC HL
4438+ 6445 EB               EX DE, HL
4439+ 6446 C5               PUSH BC
4440+ 6447 CD 31 89         CALL FILVRM              ; equivalente a la rutina FILVRM del BIOS de MSX
4441+ 644A C1               POP BC
4442+ 644B 09               ADD HL, BC
4443+ 644C EB               EX DE, HL
4444+ 644D C1               POP BC
4445+ 644E 0B               DEC BC
4446+ 644F 78               LD A, B
4447+ 6450 B1               OR C
4448+ 6451 20 EB            JR NZ, .BUCLE_DESCOMPRIMIR_MARCO
4449+ 6453 C9               RET
4450+ 6454              ; --- CONFIRMADO (ver FINDINGS.md): pese a su nombre, esta es la
4451+ 6454              ; rutina que aplica el COLOR REAL del marco de caramelo (y del
4452+ 6454              ; resto de la pantalla). Traduce cada uno de los 768 bytes de
4453+ 6454              ; TABLA_RECURSOS_SONIDO_EVENTO (desde TABLA_COLOR_MARCO_CARAMELO) con OBTENER_COLOR_VDP y
4454+ 6454              ; rellena con el resultado la tabla de color de VRAM ($2000, 768
4455+ 6454              ; celdas x 8 bytes) via FILVRM. Verificado exacto contra un volcado
4456+ 6454              ; de VRAM real: fila 0 = $E1,$E1,$E1,$F1,$F1,$E1,$6E(x20),$E1,$F1,
4457+ 6454              ; $F1,$E1,$E1,$E1 -- las esquinas gris/blanco y el tramo recto rojo
4458+ 6454              ; oscuro/gris del marco (TABLA_RLE_MARCO_CARAMELO, en madmix1.asm, da la
4459+ 6454              ; FORMA; esta rutina da el COLOR). ---
4460+ 6454              APLICAR_COLOR_PANTALLA:                    ; $6454
4461+ 6454 01 00 03         LD BC, $0300
4462+ 6457              APLICAR_COLOR_DESDE_TABLA:                            ; $6457 -- segundo punto de entrada
4463+ 6457 11 00 20         LD DE, $2000                       ; (usado por APLICAR_COLOR_CICLO_NIVELES,
4464+ 645A 21 29 61         LD HL, TABLA_COLOR_MARCO_CARAMELO                       ; que fija su propio BC antes de saltar aqui)
4465+ 645D AF               XOR A
4466+ 645E 32 88 88         LD (ULTIMO_ICONO_HUD_CACHEADO), A
4467+ 6461              .BUCLE_APLICAR_COLOR:
4468+ 6461 C5               PUSH BC
4469+ 6462 7E               LD A, (HL)
4470+ 6463 CD 84 64         CALL OBTENER_COLOR_VDP
4471+ 6466 23               INC HL
4472+ 6467 01 08 00         LD BC, $0008
4473+ 646A EB               EX DE, HL
4474+ 646B C5               PUSH BC
4475+ 646C CD 31 89         CALL FILVRM              ; equivalente a la rutina FILVRM del BIOS de MSX
4476+ 646F C1               POP BC
4477+ 6470 09               ADD HL, BC
4478+ 6471 EB               EX DE, HL
4479+ 6472 C1               POP BC
4480+ 6473 0B               DEC BC
4481+ 6474 78               LD A, B
4482+ 6475 B1               OR C
4483+ 6476 20 E9            JR NZ, .BUCLE_APLICAR_COLOR
4484+ 6478 CD DE 10         CALL PROGRAMAR_ENCENDIDO_PANTALLA                 ; vuelve a encender la pantalla
4485+ 647B C9               RET
4486+ 647C              ; --- Variante de APLICAR_COLOR_PANTALLA para el ciclador de niveles de
4487+ 647C              ; muestra: apaga pantalla, fija BC=$02C0 (704 -- CORREGIDO: recorrido
4488+ 647C              ; mas CORTO que el de creditos/HUD, $0300=768, no mas largo como decia
4489+ 647C              ; el comentario anterior) y entra directo en APLICAR_COLOR_DESDE_TABLA -- mismo bucle
4490+ 647C              ; de dibujado, con el numero de losetas a procesar (BC) como unica
4491+ 647C              ; diferencia real entre los dos usos. ---
4492+ 647C              APLICAR_COLOR_CICLO_NIVELES:            ; $647C
4493+ 647C CD D8 10         CALL PROGRAMAR_APAGADO_PANTALLA               ; la apaga antes de redibujar
4494+ 647F 01 C0 02         LD BC, $02C0
4495+ 6482 18 D3            JR APLICAR_COLOR_DESDE_TABLA
4496+ 6484
4497+ 6484              ; --- Traduce un byte de entrada (A) a un byte de COLOR VDP (nibble
4498+ 6484              ; alto = tinta, nibble bajo = fondo, formato de la tabla de color de
4499+ 6484              ; SCREEN2) via la tabla ya conocida CONSULTAR_COLOR_VDP/TABLA_COLORES_VDP
4500+ 6484              ; ($8978 en madmix1_body.asm), combinando nibble alto/bajo -- misma
4501+ 6484              ; idea que CONSULTAR_COLOR_VDP pero componiendo dos consultas en vez
4502+ 6484              ; de una. Uso
4503+ 6484              ; confirmado en APLICAR_COLOR_PANTALLA (A = indice de loseta del
4504+ 6484              ; laberinto) y en BUSCAR_COLUMNA_HUD (madmix1_body.asm; A = valor derivado de
4505+ 6484              ; la columna objetivo, para el color del HUD/READY?). ---
4506+ 6484              OBTENER_COLOR_VDP:                    ; $6484
4507+ 6484 E5               PUSH HL
4508+ 6485 C5               PUSH BC
4509+ 6486 47               LD B, A
4510+ 6487 E6 07            AND $07
4511+ 6489 4F               LD C, A
4512+ 648A 78               LD A, B
4513+ 648B E6 78            AND $78
4514+ 648D 0F               RRCA
4515+ 648E 0F               RRCA
4516+ 648F 0F               RRCA
4517+ 6490 6F               LD L, A
4518+ 6491 E6 08            AND $08
4519+ 6493 B1               OR C
4520+ 6494 4F               LD C, A
4521+ 6495 7D               LD A, L
4522+ 6496 21 78 89         LD HL, TABLA_COLORES_VDP
4523+ 6499 85               ADD A, L
4524+ 649A 6F               LD L, A
4525+ 649B 46               LD B, (HL)
4526+ 649C 21 78 89         LD HL, TABLA_COLORES_VDP
4527+ 649F 79               LD A, C
4528+ 64A0 85               ADD A, L
4529+ 64A1 6F               LD L, A
4530+ 64A2 7E               LD A, (HL)
4531+ 64A3 07               RLCA
4532+ 64A4 07               RLCA
4533+ 64A5 07               RLCA
4534+ 64A6 07               RLCA
4535+ 64A7 B0               OR B
4536+ 64A8 C1               POP BC
4537+ 64A9 E1               POP HL
4538+ 64AA C9               RET
4539+ 64AB
4540+ 64AB              ; --- Segunda rutina de reubicacion, gemela a la de MADMIX0.BIN:
4541+ 64AB              ; conmuta slots (valor fijo $55/$50, no calculado como en
4542+ 64AB              ; MADMIX0.BIN), copia 0x54AB bytes desde $8400 (el motor ya
4543+ 64AB              ; cargado) a $1000, y lo ejecuta -- candidato fuerte a "volver al
4544+ 64AB              ; menu/reiniciar" en caliente desde dentro del juego. ---
4545+ 64AB              REUBICADOR_REINICIO_JUEGO:                      ; $64AB
4546+ 64AB F3               DI
4547+ 64AC 3E 55            LD A, $55
4548+ 64AE D3 A8            OUT ($A8), A
4549+ 64B0 21 00 84         LD HL, START
4550+ 64B3 11 00 10         LD DE, DIBUJAR_PORTADA
4551+ 64B6 01 AB 54         LD BC, $54AB
4552+ 64B9 ED B0            LDIR
4553+ 64BB CD 00 10         CALL DIBUJAR_PORTADA
4554+ 64BE 3E 50            LD A, $50
4555+ 64C0 D3 A8            OUT ($A8), A
4556+ 64C2 FB               EI
4557+ 64C3 C9               RET
4558+ 64C4
4559+ 64C4                  ; $64C4-$64FF: relleno final hasta el limite de los 0x5500 bytes
4560+ 64C4                  ; reubicados. Patron "FF 00 00" repetido con alguna excepcion
4561+ 64C4                  ; puntual -- verificado byte a byte, sin significado funcional
4562+ 64C4                  ; aparente (misma pinta que el relleno de vectores RST sin usar
4563+ 64C4                  ; visto en otras zonas del juego).
4564+ 64C4 FF FF 00 00      DB $FF,$FF,$00,$00,$00,$FF,$00,$00,$FF,$00,$00,$FF,$00,$00,$FF,$00
4564+ 64C8 00 FF 00 00
4564+ 64CC FF 00 00 FF
4564+ 64D0 00 00 FF 00
4565+ 64D4 00 FF 00 00      DB $00,$FF,$00,$00,$FF,$00,$00,$FF,$8C,$00,$FF,$00,$00,$FF,$00,$00
4565+ 64D8 FF 00 00 FF
4565+ 64DC 8C 00 FF 00
4565+ 64E0 00 FF 00 00
4566+ 64E4 FF 00 00 FF      DB $FF,$00,$00,$FF,$00,$00,$FF,$00,$D3,$FF,$00,$00,$FF,$00,$00,$FF
4566+ 64E8 00 00 FF 00
4566+ 64EC D3 FF 00 00
4566+ 64F0 FF 00 00 FF
4567+ 64F4 00 00 FF 00      DB $00,$00,$FF,$00,$00,$FF,$00,$00,$FF,$00,$00,$FF
4567+ 64F8 00 FF 00 00
4567+ 64FC FF 00 00 FF
