1841+ 51FE              ; --- Rutina llamada desde el bucle principal (JT_GESTIONAR_SCROLL/scroll, ver
1842+ 51FE              ; FINDINGS.md main loop) como "HNDLR_PELMAZOIDE". Calcula una posicion relativa
1843+ 51FE              ; a la camara (+-8), la guarda en $2C1F, y si ($2BFB) (otro offset
1844+ 51FE              ; del registro de nivel en RAM de trabajo, candidato: contador de un
1845+ 51FE              ; tercer tipo de entidad) es distinto de cero, recorre esa cantidad
1846+ 51FE              ; de entradas de TABLA_ITEMS_PELMAZOIDE llamando a MOTOR_MOVIMIENTO_ITEM para
1847+ 51FE              ; cada una. ---
1848+ 51FE              HNDLR_PELMAZOIDE:                         ; $51FE
1849+ 51FE 2A 02 2C         LD HL, (REGISTRO_NIVEL_POSICION_COMECOCOS)             ; posicion de camara +8,+16 (mod 128) -> "punto de mira" guardado
1850+ 5201 3E 10            LD A, $10                    ; en ($2C1F), usado por MOTOR_MOVIMIENTO_ITEM para decidir "detras de camara"
1851+ 5203 84               ADD A, H
1852+ 5204 E6 7F            AND $7F
1853+ 5206 67               LD H, A
1854+ 5207 3E 18            LD A, $18
1855+ 5209 85               ADD A, L
1856+ 520A E6 7F            AND $7F
1857+ 520C 6F               LD L, A
1858+ 520D 22 1F 2C         LD (PUNTO_REFERENCIA_CAMARA), HL
1859+ 5210 3A FB 2B         LD A, (REGISTRO_NIVEL_CONTADOR_PELMAZOIDES)              ; offset del registro de nivel: cuantas entradas de
1860+ 5213 A7               AND A                        ; TABLA_ITEMS_PELMAZOIDE hay activas este nivel
1861+ 5214 CA 77 52         JP Z, FIN_PELMAZOIDE
1862+ 5217 47               LD B, A
1863+ 5218 DD 21 1C 51      LD IX, TABLA_ITEMS_PELMAZOIDE
1864+ 521C              BUCLE_PELMAZOIDE:
1865+ 521C C5               PUSH BC
1866+ 521D CD 78 52         CALL MOTOR_MOVIMIENTO_ITEM          ; valida posicion + calcula direccion de acercamiento (D)
1867+ 5220 38 4B            JR C, SIGUIENTE_PELMAZOIDE             ; no valida (fuera de rango/detras de camara) -> siguiente entrada
1868+ 5222 D5               PUSH DE
1869+ 5223 DD 7E 02         LD A, (IX+2)
1870+ 5226 E6 0F            AND $0F
1871+ 5228 87               ADD A, A
1872+ 5229 21 54 51         LD HL, TABLA_ANIMACION_PELMAZOIDE       ; tabla de 16 palabras (ver cabecera de seccion)
1873+ 522C 85               ADD A, L
1874+ 522D 6F               LD L, A
1875+ 522E 5E               LD E, (HL)
1876+ 522F 23               INC HL
1877+ 5230 56               LD D, (HL)
1878+ 5231 3A 0D 2C         LD A, (MODO_ESPECIAL_FLAG)              ; modo especial de "camara invertida" activo (ver MOTOR_MOVIMIENTO_ITEM)?
1879+ 5234 A7               AND A
1880+ 5235 28 11            JR Z, DIBUJAR_PELMAZOIDE
1881+ 5237 3A 0E 2C         LD A, (MODO_ESPECIAL_CUENTA_ATRAS)                ; temporizador de duracion del modo
1882+ 523A FE 32            CP $32
1883+ 523C 30 04            JR NC, AJUSTAR_SPRITE_MODO_ESPECIAL              ; todavia por encima de 50 -> ajuste siempre activo
1884+ 523E CB 47            BIT 0, A                         ; por debajo de 50 -> solo en frames alternos (parpadeo)
1885+ 5240 28 06            JR Z, DIBUJAR_PELMAZOIDE
1886+ 5242              AJUSTAR_SPRITE_MODO_ESPECIAL:
1887+ 5242 EB               EX DE, HL
1888+ 5243 11 14 00         LD DE, $0014                  ; +20 bytes: usa la SEGUNDA mitad de cada grupo de la tabla
1889+ 5246 19               ADD HL, DE                      ; (variante del sub-tipo mientras dura el modo especial)
1890+ 5247 EB               EX DE, HL
1891+ 5248              DIBUJAR_PELMAZOIDE:
1892+ 5248 DD 7E 06         LD A, (IX+6)                ; indice rotativo 0-3 de esta entrada (fase de animacion)
1893+ 524B 3C               INC A
1894+ 524C E6 03            AND $03
1895+ 524E DD 77 06         LD (IX+6), A
1896+ 5251 6F               LD L, A
1897+ 5252 79               LD A, C                        ; C = codigo compacto de direccion 1-4 (derecha/izquierda/
1898+ 5253 87               ADD A, A                         ; abajo/arriba), devuelto por MOTOR_MOVIMIENTO_ITEM (ver su cabecera)
1899+ 5254 87               ADD A, A
1900+ 5255 85               ADD A, L
1901+ 5256 6F               LD L, A
1902+ 5257 26 00            LD H, $00
1903+ 5259 19               ADD HL, DE                  ; indice = direccion(1-4)*4 + fase(0-3) -> RESUELTO, ver
1904+ 525A                                               ; TABLA_ANIMACION_PELMAZOIDE: offsets 6-9/10-13/14-17/18-21 (relativos
1905+ 525A                                               ; a la tabla) son las 4 direcciones (offset 0-5 nunca se alcanza,
1906+ 525A                                               ; la direccion nunca vale 0)
1907+ 525A 7E               LD A, (HL)
1908+ 525B 57               LD D, A
1909+ 525C E6 7F            AND $7F
1910+ 525E 47               LD B, A                       ; B = sprite/frame a dibujar
1911+ 525F 7A               LD A, D
1912+ 5260 E6 80            AND $80                         ; bit7 = volteo horizontal -- CONFIRMADO aqui (ver
1913+ 5262                                                   ; TABLA_ANIMACION_PELMAZOIDE: "izquierda" reutiliza el sprite
1914+ 5262                                                   ; de "derecha" con este bit puesto, nunca tiene sprite propio)
1915+ 5262 D1               POP DE
1916+ 5263 DD E5            PUSH IX
1917+ 5265 CD 40 84         CALL MOTOR_ACTORES                        ; MOTOR_ACTORES -- dibuja el actor en (IX+0/1)
1918+ 5268 DD E1            POP IX
1919+ 526A CD D8 57         CALL ACTIVAR_EFECTO_ITEM              ; comprueba colision con el comecocos en esta posicion
1920+ 526D              SIGUIENTE_PELMAZOIDE:
1921+ 526D 01 07 00         LD BC, $0007               ; 7 bytes por entrada de TABLA_ITEMS_PELMAZOIDE
1922+ 5270 DD 09            ADD IX, BC
1923+ 5272 C1               POP BC
1924+ 5273 05               DEC B
1925+ 5274 C2 1C 52         JP NZ, BUCLE_PELMAZOIDE
1926+ 5277              FIN_PELMAZOIDE:
1927+ 5277 C9               RET
1928+ 5278
1929+ 5278              ; --- Helper $5278 (el que faltaba de ambos manejadores de items):
1930+ 5278              ; comprueba si la posicion candidata (IX+0/1) esta "detras" de la
1931+ 5278              ; camara segun la direccion actual, y si esta lo bastante lejos en
1932+ 5278              ; el eje correspondiente. Devuelve con carry si NO es valida.
1933+ 5278              ; Segundo punto de entrada en $53A2 (llamado directo desde
1934+ 5278              ; ACTUALIZAR_DESTELLO_ITEMS): calcula una direccion de aproximacion (D/E) sin
1935+ 5278              ; repetir las comprobaciones de arriba. ---
1936+ 5278              MOTOR_MOVIMIENTO_ITEM:                        ; $5278
1937+ 5278 16 00            LD D, $00                 ; D = direccion de acercamiento hacia ($2C1F) (0 = ninguna
1938+ 527A                                              ; calculada); valores $01/$02/$04/$08 = derecha/izquierda/
1939+ 527A                                              ; abajo/arriba (convenio de CONSULTAR_LOSETA_LIBRE_DIRECCION/CONSULTAR_PROXIMA_LOSETA_EN_ESTA_DIRECCION,
1940+ 527A                                              ; DISTINTO del bit-indice que usan las flechas del despachador)
1941+ 527A DD 4E 00         LD C, (IX+0)               ; BC = posicion de este item (X,Y)
1942+ 527D DD 46 01         LD B, (IX+1)
1943+ 5280 2A 1F 2C         LD HL, (PUNTO_REFERENCIA_CAMARA)              ; punto de referencia (camara+8,+16, ver HNDLR_PELMAZOIDE)
1944+ 5283 3A 0D 2C         LD A, (MODO_ESPECIAL_FLAG)
1945+ 5286 A7               AND A
1946+ 5287 28 0A            JR Z, .COMPROBAR_ESTADO_ITEM              ; sin modo especial "invertido" -> comprobaciones de abajo
1947+ 5289 7C               LD A, H                          ; con modo activo: usa el punto de referencia NEGADO
1948+ 528A ED 44            NEG
1949+ 528C 67               LD H, A
1950+ 528D 7D               LD A, L
1951+ 528E ED 44            NEG
1952+ 5290 6F               LD L, A
1953+ 5291 18 0C            JR .CALCULAR_DIRECCION_ACERCAMIENTO                     ; y calcula la direccion igualmente, sin mas filtros
1954+ 5293              .COMPROBAR_ESTADO_ITEM:
1955+ 5293 DD 7E 02         LD A, (IX+2)              ; flag propio de este item (candidato: "inactivo/congelado")
1956+ 5296 A7               AND A
1957+ 5297 20 2C            JR NZ, .COMPROBAR_ALINEAMIENTO_LOSETA           ; activo -> no calcula direccion (D se queda a 0)
1958+ 5299 3A 0F 2C         LD A, (MODO_ESPECIAL_ACTIVO)              ; temporizador de modo especial (ver MOTOR_MOVIMIENTO_COLISION)
1959+ 529C A7               AND A
1960+ 529D 20 26            JR NZ, .COMPROBAR_ALINEAMIENTO_LOSETA           ; modo especial en curso -> tampoco calcula direccion
1961+ 529F              .CALCULAR_DIRECCION_ACERCAMIENTO:
1962+ 529F              ; --- Compara la posicion (BC) contra el punto de referencia (HL)
1963+ 529F              ; alineados a multiplos de 4: si coinciden en columna, la direccion es
1964+ 529F              ; vertical ($08=arriba o $04=abajo segun el signo de B-H); si no
1965+ 529F              ; coinciden en columna pero si en fila, es horizontal ($02=izquierda o
1966+ 529F              ; $01=derecha segun C-L); si no coincide ninguno de los dos ejes, D se
1967+ 529F              ; queda a 0 (sin direccion clara). Convenio de valores CONFIRMADO
1968+ 529F              ; cruzando con CONSULTAR_LOSETA_LIBRE_DIRECCION (mismo $01/$02/$04/$08 -> derecha/
1969+ 529F              ; izquierda/abajo/arriba, ver su cabecera) -- OJO, es distinto del
1970+ 529F              ; convenio de bit-INDICE que usan las flechas del despachador
1971+ 529F              ; (BIT 0-3 de un byte de "direcciones bloqueadas", no confundir). ---
1972+ 529F 7D               LD A, L
1973+ 52A0 E6 FC            AND $FC
1974+ 52A2 6F               LD L, A
1975+ 52A3 79               LD A, C
1976+ 52A4 E6 FC            AND $FC
1977+ 52A6 BD               CP L
1978+ 52A7 20 0A            JR NZ, .COMPROBAR_FILA            ; columna distinta -> prueba la fila
1979+ 52A9 78               LD A, B
1980+ 52AA BC               CP H
1981+ 52AB 16 08            LD D, $08                     ; misma columna: arriba si B>=H...
1982+ 52AD 30 16            JR NC, .COMPROBAR_ALINEAMIENTO_LOSETA
1983+ 52AF 16 04            LD D, $04                      ; ...abajo si B<H
1984+ 52B1 18 12            JR .COMPROBAR_ALINEAMIENTO_LOSETA
1985+ 52B3              .COMPROBAR_FILA:
1986+ 52B3 7C               LD A, H
1987+ 52B4 E6 FC            AND $FC
1988+ 52B6 67               LD H, A
1989+ 52B7 78               LD A, B
1990+ 52B8 E6 FC            AND $FC
1991+ 52BA BC               CP H
1992+ 52BB 20 08            JR NZ, .COMPROBAR_ALINEAMIENTO_LOSETA            ; tampoco coincide la fila -> D se queda a 0
1993+ 52BD 79               LD A, C
1994+ 52BE BD               CP L
1995+ 52BF 16 02            LD D, $02                     ; misma fila: izquierda si C>=L...
1996+ 52C1 30 02            JR NC, .COMPROBAR_ALINEAMIENTO_LOSETA
1997+ 52C3 16 01            LD D, $01                      ; ...derecha si C<L
1998+ 52C5              .COMPROBAR_ALINEAMIENTO_LOSETA:
1999+ 52C5 DD 7E 00         LD A, (IX+0)              ; posicion sub-loseta (bits bajos de X/Y): 0 = tile-aligned
2000+ 52C8 DD B6 01         OR (IX+1)
2001+ 52CB E6 03            AND $03
2002+ 52CD DD 7E 03         LD A, (IX+3)                ; A = direccion/animacion ya en curso (frame anterior)
2003+ 52D0 20 6E            JR NZ, .FIJAR_DIRECCION_Y_PASO              ; no alineado a loseta -> sigue con la misma sin recalcular
2004+ 52D2 42               LD B, D                          ; B = direccion de acercamiento deseada (calculada arriba)
2005+ 52D3 16 00            LD D, $00
2006+ 52D5 3E 01            LD A, $01                          ; prueba las 4 direcciones con CONSULTAR_LOSETA_LIBRE_DIRECCION (¿hay loseta
2007+ 52D7 CD 14 54         CALL CONSULTAR_LOSETA_LIBRE_DIRECCION                    ; libre un paso mas alla?) y acumula en D el bitmask de
2008+ 52DA B2               OR D                                  ; TODAS las direcciones libres desde aqui
2009+ 52DB 57               LD D, A
2010+ 52DC 3E 02            LD A, $02
2011+ 52DE CD 14 54         CALL CONSULTAR_LOSETA_LIBRE_DIRECCION
2012+ 52E1 B2               OR D
2013+ 52E2 57               LD D, A
2014+ 52E3 3E 04            LD A, $04
2015+ 52E5 CD 14 54         CALL CONSULTAR_LOSETA_LIBRE_DIRECCION
2016+ 52E8 B2               OR D
2017+ 52E9 57               LD D, A
2018+ 52EA 3E 08            LD A, $08
2019+ 52EC CD 14 54         CALL CONSULTAR_LOSETA_LIBRE_DIRECCION
2020+ 52EF B2               OR D
2021+ 52F0 57               LD D, A
2022+ 52F1 A0               AND B                     ; ¿la direccion deseada (B) es una de las libres?
2023+ 52F2 28 0F            JR Z, .ELEGIR_ENTRE_LIBRES             ; no lo es -> elige entre TODAS las libres (rama de abajo)
2024+ 52F4 3A 0D 2C         LD A, (MODO_ESPECIAL_FLAG)
2025+ 52F7 A7               AND A
2026+ 52F8 78               LD A, B
2027+ 52F9 20 45            JR NZ, .FIJAR_DIRECCION_Y_PASO              ; modo especial activo -> usa siempre la direccion deseada
2028+ 52FB CD 78 54         CALL GENERAR_ALEATORIO
2029+ 52FE E6 01            AND $01
2030+ 5300 78               LD A, B
2031+ 5301 28 3D            JR Z, .FIJAR_DIRECCION_Y_PASO              ; 50% de las veces (tirada aleatoria) -> usa la deseada igualmente
2032+ 5303              .ELEGIR_ENTRE_LIBRES:
2033+ 5303 7A               LD A, D                  ; sin poder ir hacia el objetivo (o no tocaba per el azar):
2034+ 5304 87               ADD A, A                    ; D<<3, prepara el bitmask de direcciones libres para indexar
2035+ 5305 87               ADD A, A                      ; la tabla de eleccion aleatoria de mas abajo
2036+ 5306 87               ADD A, A
2037+ 5307 57               LD D, A
2038+ 5308 DD 7E 02         LD A, (IX+2)              ; flag propio del item (mismo que arriba, "inactivo/congelado"?)
2039+ 530B A7               AND A
2040+ 530C DD 7E 03         LD A, (IX+3)
2041+ 530F 28 0D            JR Z, .ELEGIR_DIRECCION_ALEATORIA             ; inactivo -> elige nueva direccion al azar entre las libres
2042+ 5311 DD 7E 04         LD A, (IX+4)                  ; activo: CORREGIDO (comentario anterior decia lo contrario) --
2043+ 5314 DD B6 05         OR (IX+5)                       ; si la posicion fraccional (IX+4/5) tiene el bit alto puesto
2044+ 5317 CB 7F            BIT 7, A                          ; (candidato: "ha llegado justo a un cruce") MANTIENE la
2045+ 5319 DD 7E 03         LD A, (IX+3)                        ; direccion actual; solo elige al azar si el bit esta a 0
2046+ 531C 20 22            JR NZ, .FIJAR_DIRECCION_Y_PASO
2047+ 531E              .ELEGIR_DIRECCION_ALEATORIA:
2048+ 531E 21 38 2C         LD HL, TABLA_CLASE_ALINEAMIENTO ; misma tabla de 16 bytes que en MOTOR_MOVIMIENTO_COLISION, aqui indexada por A=(IX+3)
2049+ 5321                                             ; (direccion previa: 0/1/2/4/8) para categorizarla en solo 4 grupos
2050+ 5321 85               ADD A, L
2051+ 5322 6F               LD L, A
2052+ 5323 7C               LD A, H
2053+ 5324 CE 00            ADC A, $00
2054+ 5326 67               LD H, A
2055+ 5327 7E               LD A, (HL)
2056+ 5328 D6 01            SUB $01
2057+ 532A 30 01            JR NC, .CONTINUAR_INDICE_DIRECCION_PREVIA
2058+ 532C AF               XOR A
2059+ 532D              .CONTINUAR_INDICE_DIRECCION_PREVIA:
