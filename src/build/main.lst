2523+ 5574              ; --- TABLA_ANIMACION_REGPUNANTOSO: mismo mecanismo que TABLA_ANIMACION_MARICOCO
2524+ 5574              ; (indexada por HNDLR_REGPUNANTOSO como direccion(1-4)*4+fase(0-3), sin
2525+ 5574              ; autorreferencia). A diferencia de TABLA_ITEMS_MARICOCO/TABLA_ANIMACION_PELMAZOIDE
2526+ 5574              ; (2 sprites repetidos por pareja), aqui cada direccion SI anima en
2527+ 5574              ; ciclo de 4 fotogramas reales (fase 0,1,2,3 -> sprites distintos):
2528+ 5574              ; derecha=$2F,$2E,$2D,$2E; izquierda=$AF,$AE,$AD,$AE (los mismos 3
2529+ 5574              ; sprites de la derecha con bit7, volteo horizontal); abajo=$32,$31,
2530+ 5574              ; $30,$31; arriba=$33,$34,$35,$34. ---
2531+ 5574              TABLA_ANIMACION_REGPUNANTOSO:                  ; $5574
2532+ 5574 2F 2E 2D 2E      DB $2F,$2E,$2D,$2E               ; offset 0-3: nunca se lee (direccion nunca vale 0)
2533+ 5578 2F 2E 2D 2E      DB $2F,$2E,$2D,$2E               ; offset 4-7: DERECHA (direccion=1), 4 fotogramas reales
2534+ 557C AF AE AD AE      DB $AF,$AE,$AD,$AE               ; offset 8-11: IZQUIERDA (direccion=2) -- misma animacion con bit7
2535+ 5580 32 31 30 31      DB $32,$31,$30,$31               ; offset 12-15: ABAJO (direccion=3)
2536+ 5584 33 34 35 34      DB $33,$34,$35,$34               ; offset 16-19: ARRIBA (direccion=4)
