2098+ 5364 28 03            JR Z, .CONTINUAR_TRAS_MODO_INVERTIDO
2099+ 5366 11 80 00         LD DE, $0080                ; ...o mitad de paso con el modo especial "invertido" activo
2100+ 5369              .CONTINUAR_TRAS_MODO_INVERTIDO:
2101+ 5369              ; --- Aplica el movimiento de eje X o Y segun el codigo de direccion
2102+ 5369              ; final en C (los 4 valores comprobados aqui, sin confirmar si
2103+ 5369              ; coinciden 1:1 con el bitmask 1/2/4/8 usado mas arriba para
2104+ 5369              ; "direccion deseada"/CONSULTAR_LOSETA_LIBRE_DIRECCION o si es una codificacion secuencial
2105+ 5369              ; propia de este tramo): dos valores mueven X (suma/resta), los otros
2106+ 5369              ; dos mueven Y. ---
2107+ 5369 79               LD A, C
2108+ 536A FE 01            CP $01
2109+ 536C 20 05            JR NZ, .COMPROBAR_CODIGO_IZQUIERDA
2110+ 536E DD 36 05 00      LD (IX+5), $00
2111+ 5372 19               ADD HL, DE                ; codigo 1: X += paso
2112+ 5373              .COMPROBAR_CODIGO_IZQUIERDA:
