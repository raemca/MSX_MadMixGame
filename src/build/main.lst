   4+ 1000              ; --- Punto de entrada real (CALL $1000 desde RELOCATOR en
   5+ 1000              ; madmix0.asm): dibuja la portada. Apaga pantalla, escribe la tabla
   6+ 1000              ; de nombres identidad (768 bytes, nombre=indice de patron), vuelca
   7+ 1000              ; el bitmap sin comprimir (PORTADA_PATRON, 6144 bytes) a la tabla de
   8+ 1000              ; patrones VRAM, reconstruye el color desde el formato comprimido a
   9+ 1000              ; nibble (ver BUCLE_DESCOMPRIMIR_COLOR_PORTADA mas abajo) y enciende pantalla. ---
  10+ 1000              DIBUJAR_PORTADA:
  11+ 1000 F3               DI
  12+ 1001 CD BC 10         CALL APAGAR_PANTALLA_VDP         ; $10BC
  13+ 1004 21 00 18         LD HL, $1800                ; tabla de nombres (VRAM)
  14+ 1007 7D               LD A, L
  15+ 1008 D3 99            OUT ($99), A                 ; byte bajo de la direccion VRAM
  16+ 100A 7C               LD A, H
  17+ 100B E6 3F            AND $3F                      ; descarta los 2 bits altos (direccion VRAM de 14 bits)
  18+ 100D F6 40            OR $40                       ; comando "fijar puntero de escritura" del VDP
  19+ 100F D3 99            OUT ($99), A                 ; byte alto + comando
  20+ 1011 E3               EX (SP), HL                 ; x2 = retardo VDP tras fijar direccion
  21+ 1012 E3               EX (SP), HL
  22+ 1013 01 00 00         LD BC, $0000                 ; C = byte de nombre a escribir (0, 1, 2...), B = contador de paginas de 256
  23+ 1016              .BUCLE_TABLA_IDENTIDAD:
  24+ 1016 79               LD A, C
  25+ 1017 D3 98            OUT ($98), A                 ; nombre = C (nombre = indice de patron, el truco "identidad")
  26+ 1019 03               INC BC
  27+ 101A 78               LD A, B
  28+ 101B FE 03            CP 3                         ; 3 paginas de 256 = 768 bytes: tabla de nombres IDENTIDAD
  29+ 101D 20 F7            JR NZ, .BUCLE_TABLA_IDENTIDAD        ; 768 bytes: tabla de nombres IDENTIDAD
  30+ 101F                                               ; (nombre = indice de patron), truco ya
  31+ 101F                                               ; conocido del motor principal
  32+ 101F 21 ED 10         LD HL, PORTADA_PATRON        ; origen: bitmap sin comprimir de la portada
  33+ 1022 11 00 00         LD DE, $0000                 ; VRAM $0000 = tabla de patrones (destino)
  34+ 1025 01 00 18         LD BC, 6144                  ; 6144 bytes = tamano completo de la tabla de patrones de SCREEN2
  35+ 1028 EB               EX DE, HL                    ; HL = destino VRAM, DE = origen (para fijar la direccion VRAM primero)
  36+ 1029 7D               LD A, L
  37+ 102A D3 99            OUT ($99), A
  38+ 102C 7C               LD A, H
  39+ 102D E6 3F            AND $3F
  40+ 102F F6 40            OR $40
  41+ 1031 D3 99            OUT ($99), A
  42+ 1033 E3               EX (SP), HL
  43+ 1034 E3               EX (SP), HL
