2801+ 56F5              ; --- $56F5-$5772 (126 bytes): 3 secuencias de animacion "extra" para
2802+ 56F5              ; ACTUALIZAR_DESTELLO_ITEMS, cada una terminada en centinela $FF. Mecanismo
2803+ 56F5              ; RESUELTO: cada llamador de ARMAR_AVISO_DESTELLO pasa en C un valor
2804+ 56F5              ; cuyos 7 bits bajos (AND $7F) son el OFFSET DE ENTRADA dentro de esta
2805+ 56F5              ; tabla -- no un contador generico. Eso permite que cada evento entre
2806+ 56F5              ; en un punto distinto de la MISMA secuencia: bien desde el principio
2807+ 56F5              ; (animacion larga) o saltando directo a la cola comun de cierre
2808+ 56F5              ; (`$28,$28,$29,$29,$2A,$2B[,$2C]` -- esquinas/uniones de muro de
2809+ 56F5              ; ladrillo, losetas 40-44 del catalogo, compartidas por las 3
2810+ 56F5              ; secuencias) para un "flash" corto. ACTUALIZAR_DESTELLO_ITEMS dibuja con
2811+ 56F5              ; MOTOR_ACTORES (motor de sprites, no el sistema de losetas del mapa)
2812+ 56F5              ; la loseta en la posicion de entrada actual, y si la SIGUIENTE
2813+ 56F5              ; posicion es $FF, reinicia la entrada a offset 0.
2814+ 56F5              ;
2815+ 56F5              ; IDENTIDAD DE LAS LOSETAS (cruzadas contra data/tiles/*.til):
2816+ 56F5              ; secuencia A = flecha_derecha(54)+cierre+linea_electrica_puerta_
2817+ 56F5              ; fantasmas(56); secuencia B = (tramo sin descifrar)+ciclo pista_
2818+ 56F5              ; avion(58)/item_suelo(59)/bola_poder(60)/hipopotamo(61)+cierre;
2819+ 56F5              ; secuencia C = item_herramienta(62)+cierre+pista_tanque(55).
2820+ 56F5              ; HIPOTESIS FUERTE (no confirmada visualmente): parece un "flash" de
2821+ 56F5              ; celebracion que dibuja iconos reales del catalogo con el motor de
2822+ 56F5              ; sprites en vez de una animacion decorativa inventada -- la
2823+ 56F5              ; secuencia B en concreto cicla justo por los 4 iconos de item/power-
2824+ 56F5              ; up al activarse un modo especial (ver EFECTOS_DESTELLO_SEQ_B_MAIN, llamada
2825+ 56F5              ; desde ACTIVAR_EFECTO_ITEM.INICIAR_MODO_ESPECIAL).
2826+ 56F5              ;
2827+ 56F5              ; Puntos de entrada reales (valor de C en cada CALL ARMAR_AVISO_DESTELLO
2828+ 56F5              ; encontrado en el codigo, ver las etiquetas mas abajo):
2829+ 56F5              ;   $01 -> EFECTOS_DESTELLO_SEQ_A       (ACTIVAR_EFECTO_ITEM.SUMAR_PUNTOS_MODO2, secuencia A casi completa)
2830+ 56F5              ;   $17 -> EFECTOS_DESTELLO_SEQ_A_TAIL  (ACTIVAR_EFECTO_ITEM.SUMAR_PUNTOS_MODO1/.SUMAR_PUNTOS_MODO2, solo el cierre de A)
2831+ 56F5              ;   $A7 -> EFECTOS_DESTELLO_SEQ_B_ENTRY (ACTIVAR_EFECTO_ITEM.INICIAR_MODO_ESPECIAL, item=hipopotamo -- ver dualidad abajo)
2832+ 56F5              ;   $AD -> EFECTOS_DESTELLO_SEQ_B_MAIN  (ACTIVAR_EFECTO_ITEM.INICIAR_MODO_ESPECIAL, resto de items -- secuencia B desde el ciclo de iconos)
2833+ 56F5              ;   $4D -> EFECTOS_DESTELLO_SEQ_B_TAIL  (AVISAR_PROXIMIDAD_PISTA, solo el cierre de B -- el flash mas corto)
2834+ 56F5              ;   $55 -> EFECTOS_DESTELLO_SEQ_C       (ACTIVAR_EFECTO_ITEM.SUMAR_PUNTOS_MODO2, secuencia C completa)
2835+ 56F5              ;   $6D -> EFECTOS_DESTELLO_SEQ_C_TAIL  (ACTIVAR_EFECTO_ITEM.SUMAR_PUNTOS_MODO1/.SUMAR_PUNTOS_MODO2, solo el cierre de C)
