2133+ 539F DD 74 01         LD (IX+1), H
2134+ 53A2              ; --- Segundo punto de entrada de MOTOR_MOVIMIENTO_ITEM, llamado directo desde
2135+ 53A2              ; ACTUALIZAR_DESTELLO_ITEMS (sin pasar por las comprobaciones de "detras de
2136+ 53A2              ; camara" de arriba): calcula la direccion VRAM (D/E) de la posicion
2137+ 53A2              ; (IX+0/1) relativa a la camara actual y la comprueba contra los
2138+ 53A2              ; limites visibles de pantalla (CP $2C / CP $38). Devuelve con carry
2139+ 53A2              ; si la posicion cae fuera de rango (nada que dibujar); sin carry y
2140+ 53A2              ; DE=direccion VRAM si es visible. ---
2141+ 53A2              CALCULAR_POSICION_VRAM_ITEM:                        ; $53A2
2142+ 53A2 C5               PUSH BC
2143+ 53A3 01 00 00         LD BC, $0000
2144+ 53A6 ED 5B 02 2C      LD DE, (REGISTRO_NIVEL_POSICION_COMECOCOS)
2145+ 53AA CB BB            RES 7, E                     ; limpia el bit7 (flag de direccion de scroll en .H/.L, ver SCROLL_ARRIBA/SCROLL_ABAJO)
2146+ 53AC CB BA            RES 7, D                     ; -- aqui la posicion de camara se trata como coordenada pura, sin el flag
2147+ 53AE 7B               LD A, E
2148+ 53AF D6 08            SUB 8                        ; 8 = offset de referencia respecto a la camara (mismo valor que PUNTO_REFERENCIA_CAMARA, restado en vez de sumado)
2149+ 53B1 CB BF            RES 7, A
2150+ 53B3 FE 40            CP 64                        ; 64 = mitad del rango de columna (limite de wrap)
2151+ 53B5 38 03            JR C, .CONTINUAR_AJUSTE_COLUMNA
2152+ 53B7 0E 40            LD C, 64                     ; 64 = ajuste de wrap para la columna (tambien reutilizado mas abajo como sumando)
2153+ 53B9 91               SUB C
2154+ 53BA              .CONTINUAR_AJUSTE_COLUMNA:
2155+ 53BA 5F               LD E, A                      ; E = columna de camara ajustada, en rango 0-63
2156+ 53BB 7A               LD A, D
2157+ 53BC D6 08            SUB 8                        ; mismo ajuste de -8 que arriba, mismo patron
2158+ 53BE CB BF            RES 7, A
2159+ 53C0 FE 40            CP 64
2160+ 53C2 38 03            JR C, .CONTINUAR_AJUSTE_FILA
2161+ 53C4 06 40            LD B, 64                     ; 64 = ajuste de wrap para la fila (tambien reutilizado mas abajo como sumando)
2162+ 53C6 90               SUB B
2163+ 53C7              .CONTINUAR_AJUSTE_FILA:
2164+ 53C7 57               LD D, A                      ; D = fila de camara ajustada, en rango 0-63
2165+ 53C8 DD 7E 01         LD A, (IX+1)                 ; A = posicion Y del item
2166+ 53CB CB BF            RES 7, A
2167+ 53CD 80               ADD A, B                     ; compensa el ajuste de wrap de la fila (B=0 o 64, segun arriba)
2168+ 53CE CB BF            RES 7, A
2169+ 53D0 92               SUB D                        ; delta = posicion Y del item - fila de camara ajustada
2170+ 53D1 CB BF            RES 7, A
2171+ 53D3 38 3C            JR C, .SALIR_FUERA_DE_RANGO             ; delta negativo -> fuera de la ventana visible
2172+ 53D5 FE 2C            CP 44                        ; 44 = limite superior de fila visible
2173+ 53D7 30 38            JR NC, .SALIR_FUERA_DE_RANGO
2174+ 53D9 D6 08            SUB 8                        ; mismo ajuste de -8 de nuevo, sobre el delta de fila
2175+ 53DB CB BF            RES 7, A
2176+ 53DD 67               LD H, A                      ; H = delta de fila final (candidato a fila de tile 0-31)
2177+ 53DE DD 7E 00         LD A, (IX+0)                 ; A = posicion X del item
2178+ 53E1 CB BF            RES 7, A
2179+ 53E3 81               ADD A, C                     ; compensa el ajuste de wrap de la columna (C=0 o 64)
2180+ 53E4 CB BF            RES 7, A
2181+ 53E6 93               SUB E                        ; delta = posicion X del item - columna de camara ajustada
2182+ 53E7 CB BF            RES 7, A
2183+ 53E9 38 26            JR C, .SALIR_FUERA_DE_RANGO             ; delta negativo -> fuera de la ventana visible
2184+ 53EB FE 38            CP 56                        ; 56 = limite superior de columna visible
2185+ 53ED 30 22            JR NC, .SALIR_FUERA_DE_RANGO
2186+ 53EF D6 08            SUB 8                        ; mismo ajuste de -8 de nuevo, sobre el delta de columna
2187+ 53F1 CB BF            RES 7, A
2188+ 53F3 6F               LD L, A                      ; L = delta de columna final (candidato a columna de tile 0-31)
2189+ 53F4 87               ADD A, A                     ; x2: construye el byte bajo de la direccion VRAM final
2190+ 53F5 C6 0E            ADD A, 14                    ; +14 = offset base de la construccion de direccion (candidato, sin confirmar del todo)
2191+ 53F7 5F               LD E, A
2192+ 53F8 7C               LD A, H
2193+ 53F9 87               ADD A, A                     ; x4 (2 dobles): construye el byte alto de la direccion VRAM final
2194+ 53FA 87               ADD A, A
2195+ 53FB C6 F8            ADD A, $F8                   ; $F8 = -8 (delta con signo), completa el calculo de direccion
2196+ 53FD 57               LD D, A
2197+ 53FE DD 7E 04         LD A, (IX+4)                 ; bit de orientacion/animacion del item (candidato, ver cabecera de la seccion)
2198+ 5401 07               RLCA
2199+ 5402 7B               LD A, E
2200+ 5403 CE 00            ADC A, $00                   ; propaga el acarreo del RLCA anterior al byte bajo
2201+ 5405 5F               LD E, A
2202+ 5406 DD 7E 05         LD A, (IX+5)                 ; mismo patron con el otro bit, sobre el byte alto
2203+ 5409 07               RLCA
2204+ 540A 7A               LD A, D
2205+ 540B CE 00            ADC A, $00
2206+ 540D 57               LD D, A
2207+ 540E C1               POP BC
2208+ 540F A7               AND A                        ; NC = posicion visible, DE = direccion VRAM final
2209+ 5410 C9               RET
2210+ 5411              .SALIR_FUERA_DE_RANGO:
2211+ 5411 C1               POP BC
2212+ 5412 37               SCF                          ; C = posicion fuera de rango, nada que dibujar
2213+ 5413 C9               RET
2214+ 5414
2215+ 5414              ; --- Helper local: calcula, para cada uno de los 4 bits de
2216+ 5414              ; direccion (A=1/2/4/8), si la posicion (IX+0/1) tiene loseta libre
2217+ 5414              ; un paso en esa direccion (via MAPEAR_COORDENADA_A_DIRECCION + CONSULTAR_TIPO_LOSETA).
2218+ 5414              ; Llamado 4 veces seguidas desde MOTOR_MOVIMIENTO_ITEM (bitmask acumulado). ---
2219+ 5414              CONSULTAR_LOSETA_LIBRE_DIRECCION:                        ; $5414
2220+ 5414 C5               PUSH BC
2221+ 5415 D5               PUSH DE
2222+ 5416 DD 4E 00         LD C, (IX+0)              ; BC = posicion de este item
2223+ 5419 DD 46 01         LD B, (IX+1)
2224+ 541C 1F               RRA                       ; bit0 de A (entrada, $01/$02/$04/$08) -> derecha
2225+ 541D 30 08            JR NC, .COMPROBAR_IZQUIERDA
2226+ 541F 0C               INC C
2227+ 5420 0C               INC C
2228+ 5421 0C               INC C
2229+ 5422 0C               INC C                       ; +1 columna
2230+ 5423 3E 01            LD A, $01                  ; guarda el codigo de direccion "derecha" para el resultado (D mas abajo)
2231+ 5425 18 19            JR .CONSULTAR_LOSETA_DESPLAZADA
2232+ 5427              .COMPROBAR_IZQUIERDA:
2233+ 5427 1F               RRA                       ; bit1 -> izquierda
2234+ 5428 30 05            JR NC, .COMPROBAR_ABAJO
2235+ 542A 0D               DEC C                        ; -1 columna
2236+ 542B 3E 02            LD A, $02                  ; codigo de direccion "izquierda"
2237+ 542D 18 11            JR .CONSULTAR_LOSETA_DESPLAZADA
2238+ 542F              .COMPROBAR_ABAJO:
2239+ 542F 1F               RRA                       ; bit2 -> abajo
2240+ 5430 30 08            JR NC, .COMPROBAR_ARRIBA
2241+ 5432 04               INC B
2242+ 5433 04               INC B
2243+ 5434 04               INC B
2244+ 5435 04               INC B                       ; +1 fila
2245+ 5436 3E 04            LD A, $04                  ; codigo de direccion "abajo"
2246+ 5438 18 06            JR .CONSULTAR_LOSETA_DESPLAZADA
2247+ 543A              .COMPROBAR_ARRIBA:
2248+ 543A 1F               RRA                       ; bit3 -> arriba
2249+ 543B 30 03            JR NC, .CONSULTAR_LOSETA_DESPLAZADA
2250+ 543D 05               DEC B                        ; -1 fila
2251+ 543E 3E 08            LD A, $08                  ; codigo de direccion "arriba"
2252+ 5440              .CONSULTAR_LOSETA_DESPLAZADA:
2253+ 5440 57               LD D, A                  ; D = la direccion que se esta probando (para el resultado)
2254+ 5441 CD 5F 54         CALL MAPEAR_COORDENADA_A_DIRECCION
2255+ 5444 CD DA 8C         CALL CONSULTAR_TIPO_LOSETA                        ; CONSULTAR_TIPO_LOSETA: tipo de la loseta desplazada
2256+ 5447              ; --- Tipos 0 (pared/suelo normal), 7 (pista tanque), 8 (linea
2257+ 5447              ; electrica puerta fantasmas) y 10 (pista avion) se consideran NO
2258+ 5447              ; transitables para este item -- cualquier otro tipo (bolita, bola
2259+ 5447              ; clavada, flechas, items especiales, trampillas...) SI lo es. Nota:
2260+ 5447              ; type 0 incluye tanto paredes como suelo normal sin distinguir, asi
2261+ 5447              ; que este item en concreto solo puede moverse por losetas "con
2262+ 5447              ; decoracion especial", nunca por pasillo llano -- coherente con ser
2263+ 5447              ; una entidad ligada al subsistema de items, no el comecocos/fantasma
2264+ 5447              ; normal. ---
2265+ 5447 A7               AND A
2266+ 5448 28 0C            JR Z, .LOSETA_BLOQUEADA             ; tipo 0 -> bloqueado
2267+ 544A FE 08            CP 8
2268+ 544C 28 08            JR Z, .LOSETA_BLOQUEADA               ; tipo 8 -> bloqueado
2269+ 544E FE 07            CP 7
2270+ 5450 28 04            JR Z, .LOSETA_BLOQUEADA                 ; tipo 7 -> bloqueado
2271+ 5452 FE 0A            CP 10
2272+ 5454 20 04            JR NZ, .LOSETA_LIBRE                  ; ningun otro tipo -> libre
2273+ 5456              .LOSETA_BLOQUEADA:
2274+ 5456 AF               XOR A
2275+ 5457 37               SCF                       ; tipo 10 (cae aqui) o cualquiera de los de arriba -> carry=bloqueado
2276+ 5458 18 02            JR .FIN_CONSULTA_LOSETA
2277+ 545A              .LOSETA_LIBRE:
2278+ 545A 7A               LD A, D                  ; libre: A=D (la direccion probada)
2279+ 545B A7               AND A                       ; y carry=0 (AND siempre limpia el acarreo)
2280+ 545C              .FIN_CONSULTA_LOSETA:
2281+ 545C D1               POP DE
2282+ 545D C1               POP BC
2283+ 545E C9               RET
