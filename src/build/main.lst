1830+ 51B2 04 04 02 02
1831+ 51B6 01 04 02 04      DB $01,$04,$02,$04,$01,$02,$01,$02  ; libres=derecha+izquierda+abajo (0111)
1831+ 51BA 01 02 01 02
1832+ 51BE 08 08 08 08      DB $08,$08,$08,$08,$08,$08,$08,$08  ; libres=arriba (1000)
1832+ 51C2 08 08 08 08
1833+ 51C6 01 01 08 08      DB $01,$01,$08,$08,$01,$01,$08,$08  ; libres=derecha+arriba (1001)
1833+ 51CA 01 01 08 08
1834+ 51CE 08 08 02 02      DB $08,$08,$02,$02,$02,$02,$08,$08  ; libres=izquierda+arriba (1010)
1834+ 51D2 02 02 08 08
1835+ 51D6 01 08 02 08      DB $01,$08,$02,$08,$01,$02,$08,$08  ; libres=derecha+izquierda+arriba (1011)
1835+ 51DA 01 02 08 08
1836+ 51DE 08 04 08 04      DB $08,$04,$08,$04,$04,$04,$08,$08  ; libres=abajo+arriba (1100)
1836+ 51E2 04 04 08 08
1837+ 51E6 01 01 08 04      DB $01,$01,$08,$04,$04,$01,$08,$01  ; libres=derecha+abajo+arriba (1101)
1837+ 51EA 04 01 08 01
1838+ 51EE 08 04 02 02      DB $08,$04,$02,$02,$04,$02,$08,$02  ; libres=izquierda+abajo+arriba (1110)
1838+ 51F2 04 02 08 02
1839+ 51F6 01 01 02 02      DB $01,$01,$02,$02,$04,$04,$08,$08  ; libres=derecha+izquierda+abajo+arriba (1111) -- mantiene la direccion previa en cada caso
1839+ 51FA 04 04 08 08
