4139+ 5F2B C9               RET
4140+ 5F2C
4141+ 5F2C              ; --- CORREGIDO (no es una fuente/bitmap): mapa de 72 posiciones de
4142+ 5F2C              ; escaneo de teclado (fila x8+bit, mismo orden que ESPERAR_TECLA_NUEVA)
4143+ 5F2C              ; -> identidad de esa tecla. Filas $F0-$F5: glifo ASCII imprimible
4144+ 5F2C              ; real, pasable tal cual a ESCRIBIR_PATRON_VRAM. Filas $F6-$F8: codigo
4145+ 5F2C              ; especial 1-24, indice a TEXTO_MENU_REDEFINIR_TECLAS para teclas no
4146+ 5F2C              ; imprimibles (de ahi el CP $24 de DIBUJAR_MENU_REDEFINIR_TECLAS). El
4147+ 5F2C              ; bit 7 de cada entrada se reutiliza como marca "tecla usada" durante
4148+ 5F2C              ; la redefinicion (ver REINICIAR_TECLAS_USADAS/ESPERAR_TECLA_NUEVA);
4149+ 5F2C              ; los 3 bytes finales son relleno, nunca alcanzados (el escaneo real
4150+ 5F2C              ; solo cubre 72 posiciones). ---
4151+ 5F2C              TABLA_CODIGOS_TECLA:
4152+ 5F2C 30 31 32 33      DB "01234567"              ; fila $F0: digitos
4152+ 5F30 34 35 36 37
4153+ 5F34 38 39 2D 3D      DB "89-=", $5C, "{};"      ; fila $F1
4153+ 5F38 5C 7B 7D 3B
4154+ 5F3C 3A 20 2C 2E      DB ":", $20, ",./^AB"      ; fila $F2
4154+ 5F40 2F 5E 41 42
4155+ 5F44 43 44 45 46      DB "CDEFGHIJ"              ; fila $F3
4155+ 5F48 47 48 49 4A
4156+ 5F4C 4B 4C 4D 4E      DB "KLMNOPQR"              ; fila $F4
4156+ 5F50 4F 50 51 52
4157+ 5F54 53 54 55 56      DB "STUVWXYZ"              ; fila $F5
4157+ 5F58 57 58 59 5A
4158+ 5F5C 01 02 03 04      DB 1,2,3,4,5,6,7,8          ; fila $F6: codigos especiales 1-8 (indices a TEXTO_MENU_REDEFINIR_TECLAS)
4158+ 5F60 05 06 07 08
4159+ 5F64 09 0A 0B 0C      DB 9,10,11,12,13,14,15,16   ; fila $F7: codigos especiales 9-16
4159+ 5F68 0D 0E 0F 10
4160+ 5F6C 11 12 13 14      DB 17,18,19,20,21,22,23,24  ; fila $F8: codigos especiales 17-24
4160+ 5F70 15 16 17 18
4161+ 5F74                  ; CORREGIDO: estos 3 bytes NO son relleno inerte -- $5F74 (justo
4162+ 5F74                  ; despues de las 72 entradas reales de la tabla, $5F2C-$5F73) es
4163+ 5F74                  ; el puntero de escritura hacia TABLA_TECLAS_MSX y $5F76 el codigo
4164+ 5F74                  ; de la tecla actual, ambos usados por REINICIAR_TECLAS_USADAS/
4165+ 5F74                  ; ESPERAR_TECLA_NUEVA/DIBUJAR_MENU_REDEFINIR_TECLAS. Su valor
4166+ 5F74                  ; inicial en el .BIN es 0 porque no se usan hasta entrar al
4167+ 5F74                  ; submenu de redefinicion. Confirmado por aritmetica exacta:
4168+ 5F74                  ; DIBUJAR_CREDITOS empieza en $5F77 = $5F74+3.
4169+ 5F74              PUNTERO_ESCRITURA_TECLA:
4170+ 5F74 00 00            DW 0
4171+ 5F76              CODIGO_TECLA_ACTUAL:
4172+ 5F76 00               DB 0
4173+ 5F77
4174+ 5F77              ; --- Dibuja la pantalla de creditos: 8 registros de texto via
4175+ 5F77              ; DIBUJAR_TEXTO_VRAM (CORREGIDO: son 8, no 7 -- el comentario historico
4176+ 5F77              ; contaba mal antes de tener las 8 direcciones identificadas),
4177+ 5F77              ; direcciones/tamanos hardcoded (analogo a DIBUJAR_MENU_PRINCIPAL). ---
4178+ 5F77              DIBUJAR_CREDITOS:                   ; $5F77
4179+ 5F77 CD A0 5C         CALL LIMPIAR_VRAM_AREA_JUEGO
4180+ 5F7A 11 35 60         LD DE, TEXTO_CREDITOS_TITULO
4181+ 5F7D 21 48 02         LD HL, $0248
