3453+ 5AE9
3454+ 5AE9              ; ==============================================================
3455+ 5AE9              ;  ZONA FINAL $5AE9-$6500: pantalla de REDEFINICION DE TECLAS +
3456+ 5AE9              ;  CREDITOS + un ciclador de "niveles de muestra". Desensamblado
3457+ 5AE9              ;  completo con Z80Dasm. Incluye codigo automodificable de verdad
3458+ 5AE9              ;  (el juego escribe opcodes literales sobre direcciones de codigo
3459+ 5AE9              ;  en tiempo de ejecucion) y una segunda rutina de reubicacion
3460+ 5AE9              ;  gemela a la de MADMIX0.BIN. HALLAZGO: la tabla de creditos reales
3461+ 5AE9              ;  del juego -- texto real, sin "corregir" ortografia: "POGRAMADO
3462+ 5AE9              ;  BY: RAPHAEL GOMEZZZ..", "GRAPHICOS BY : ROBERTO P.ACEBES",
3463+ 5AE9              ;  "MUSIC-A BY: COMILONAS", "TOPOSHOW -1988-" (ver TEXTO_CREDITOS_PROGRAMADO_POR
3464+ 5AE9              ;  mas abajo para el detalle byte a byte).
3465+ 5AE9              ; ==============================================================
3466+ 5AE9
3467+ 5AE9              ; --- Bucle de introduccion: copia (a si misma, ver comentario) un
3468+ 5AE9              ; bloque de VRAM/RAM en $4000 hasta 0x46 veces o hasta detectar
3469+ 5AE9              ; pulsacion de tecla/joystick (COMPROBAR_PULSACION), luego dibuja portada,
3470+ 5AE9              ; llama al gestor de recursos 3 veces (ids 0/1/2) y espera con timeout.
3471+ 5AE9              ; RESUELTO: si la tecla es ESC (codigo $EB fila 7), activa un TRUCO
3472+ 5AE9              ; OCULTO de vidas infinitas (ver .COMPROBAR_TRUCO_VIDAS_INFINITAS mas abajo), no un simple
3473+ 5AE9              ; reinicio de sonido/pantalla. ---
3474+ 5AE9              GESTIONAR_INTRODUCCION:                          ; $5AE9
3475+ 5AE9 CD D8 10         CALL PROGRAMAR_APAGADO_PANTALLA               ; apaga pantalla mientras redibuja
3476+ 5AEC CD 77 5F         CALL DIBUJAR_CREDITOS
3477+ 5AEF CD DE 10         CALL PROGRAMAR_ENCENDIDO_PANTALLA                  ; vuelve a encenderla
3478+ 5AF2 06 46            LD B, 70                     ; 70 iteraciones del bucle de espera (antes de rendirse y mostrar la portada)
3479+ 5AF4              .BUCLE_ESPERA_INTRO:
3480+ 5AF4 C5               PUSH BC
3481+ 5AF5 21 00 40         LD HL, $4000
3482+ 5AF8 5D               LD E, L
3483+ 5AF9 54               LD D, H
3484+ 5AFA 4D               LD C, L
3485+ 5AFB 44               LD B, H
3486+ 5AFC ED B0            LDIR                          ; copia el bloque $4000 sobre si mismo (sin efecto real) -- solo quema tiempo
3487+ 5AFE C1               POP BC
3488+ 5AFF AF               XOR A
3489+ 5B00 CD 0A 5D         CALL COMPROBAR_PULSACION
3490+ 5B03 20 30            JR NZ, .COMPROBAR_TRUCO_VIDAS_INFINITAS
3491+ 5B05 10 ED            DJNZ .BUCLE_ESPERA_INTRO
3492+ 5B07 CD 00 10         CALL DIBUJAR_PORTADA          ; = $1000 (reubicada, ver cabecera de DIBUJAR_PORTADA)
3493+ 5B0A CD 8B CF         CALL VACIAR_CANALES_SONIDO
3494+ 5B0D AF               XOR A
3495+ 5B0E 11 CB CD         LD DE, GUION_MELODIA_CANAL_0
3496+ 5B11 CD A0 C4         CALL INSTALAR_RECURSO_SONIDO   ; indice A=0
3497+ 5B14 3E 01            LD A, 1
3498+ 5B16 11 FF CD         LD DE, GUION_MELODIA_CANAL_1
3499+ 5B19 CD A0 C4         CALL INSTALAR_RECURSO_SONIDO   ; indice A=1
3500+ 5B1C 3E 02            LD A, 2
3501+ 5B1E 11 0C CE         LD DE, GUION_MELODIA_CANAL_2
3502+ 5B21 CD A0 C4         CALL INSTALAR_RECURSO_SONIDO   ; indice A=2
3503+ 5B24 01 10 27         LD BC, 10000                  ; 10000 frames de timeout antes de volver a la intro
3504+ 5B27              .BUCLE_ESPERA_TIMEOUT:
3505+ 5B27 C5               PUSH BC
3506+ 5B28 CD 0A 5D         CALL COMPROBAR_PULSACION
3507+ 5B2B C1               POP BC
3508+ 5B2C 20 22            JR NZ, .CONTINUAR_INTRO
3509+ 5B2E 0B               DEC BC
3510+ 5B2F FB               EI
3511+ 5B30 76               HALT
3512+ 5B31 78               LD A, B
3513+ 5B32 B1               OR C
3514+ 5B33 20 F2            JR NZ, .BUCLE_ESPERA_TIMEOUT
3515+ 5B35              ; RESUELTO -- truco oculto de VIDAS INFINITAS. $909A es el byte
3516+ 5B35              ; operando literal de la instruccion "SUB $01" dentro de la rutina de
3517+ 5B35              ; perdida de vida en madmix1.asm (BUCLE_PRINCIPAL_JUEGO: "LD HL,$2C27 / LD A,(HL) /
3518+ 5B35              ; SUB $01 / LD (HL),A / JP NC,PREPARAR_INICIO_NIVEL"): escribir 0 ahi la
3519+ 5B35              ; convierte en "SUB $00", con lo que perder una vida ya no resta nada
3520+ 5B35              ; (ni siquiera activa el acarreo que dispara GAME OVER). El parpadeo
3521+ 5B35              ; de borde (color 6, espera, color 1) es solo la confirmacion visual
3522+ 5B35              ; de que el codigo se activo -- despues cae en .CONTINUAR_INTRO y el juego
3523+ 5B35              ; sigue con normalidad hasta el menu principal.
3524+ 5B35              .COMPROBAR_TRUCO_VIDAS_INFINITAS:
3525+ 5B35 FE EB            CP $EB                  ; tecla ESC...
3526+ 5B37 20 17            JR NZ, .CONTINUAR_INTRO
3527+ 5B39 79               LD A, C
3528+ 5B3A FE 07            CP 7                     ; ...en la fila 7 de la matriz
3529+ 5B3C 20 12            JR NZ, .CONTINUAR_INTRO
3530+ 5B3E AF               XOR A
3531+ 5B3F 32 9A 90         LD ($909A), A             ; parchea "SUB $01" (BUCLE_PRINCIPAL_JUEGO) a "SUB $00"
3532+ 5B42 3E 06            LD A, $06
3533+ 5B44 CD 8A 88         CALL FIJAR_COLOR_BORDE_VDP
3534+ 5B47 76               HALT
3535+ 5B48 76               HALT
3536+ 5B49 76               HALT
3537+ 5B4A 76               HALT
3538+ 5B4B 3E 01            LD A, $01
3539+ 5B4D CD 8A 88         CALL FIJAR_COLOR_BORDE_VDP
3540+ 5B50              .CONTINUAR_INTRO:
3541+ 5B50 CD 04 5D         CALL ESPERAR_TECLA_SOLTADA
3542+ 5B53 CD 29 64         CALL DIBUJAR_MARCO_CARAMELO_VRAM
3543+ 5B56              MOSTRAR_MENU_PRINCIPAL:                            ; segundo punto de entrada a .CONTINUAR_INTRO,
3544+ 5B56                                                   ; saltandose ESPERAR_TECLA_SOLTADA/
3545+ 5B56                                                   ; DIBUJAR_MARCO_CARAMELO_VRAM (no aplican al
3546+ 5B56                                                   ; arranque real) -- llamado desde
3547+ 5B56                                                   ; REINICIAR_PARTIDA en madmix1.asm para
3548+ 5B56                                                   ; mostrar el menu principal al arrancar
3549+ 5B56                                                   ; una partida real
3550+ 5B56 CD 8B CF         CALL VACIAR_CANALES_SONIDO
3551+ 5B59 CD D8 10         CALL PROGRAMAR_APAGADO_PANTALLA              ; apaga pantalla mientras redibuja el menu
3552+ 5B5C CD A0 5C         CALL LIMPIAR_VRAM_AREA_JUEGO
3553+ 5B5F CD 7C 64         CALL APLICAR_COLOR_CICLO_NIVELES
3554+ 5B62              REINICIAR_TIMEOUT_MENU:
3555+ 5B62 01 F4 01         LD BC, $01F4
3556+ 5B65              ACTUALIZAR_MENU_PRINCIPAL:
3557+ 5B65 ED 43 43 60      LD ($6043), BC
3558+ 5B69 CD CC 5B         CALL DIBUJAR_MENU_PRINCIPAL
3559+ 5B6C CD DE 10         CALL PROGRAMAR_ENCENDIDO_PANTALLA                 ; vuelve a encenderla
3560+ 5B6F CD 80 5C         CALL LEER_TECLAS_MENU_PRINCIPAL
3561+ 5B72 7B               LD A, E
3562+ 5B73 F5               PUSH AF
3563+ 5B74 21 BC 5B         LD HL, GESTIONAR_TIMEOUT_MENU.CONTINUAR_TRAS_OPCION
3564+ 5B77 E5               PUSH HL
3565+ 5B78 CB 47            BIT 0, A
3566+ 5B7A 28 2B            JR Z, DESPACHAR_ACCION_MENU
3567+ 5B7C E1               POP HL
3568+ 5B7D F1               POP AF
3569+ 5B7E CD 8C 5B         CALL RELLENAR_SOLIDO_AREA_JUEGO_BUFFER_VRAM
3570+ 5B81 AF               XOR A
3571+ 5B82 32 04 2C         LD (REGISTRO_NIVEL_ICONO_HUD), A
3572+ 5B85 32 24 2C         LD (COLOR_ACTUAL), A
3573+ 5B88 CD A0 89         CALL WAIT_VBLANK               ; WAIT_VBLANK (madmix1.asm)
3574+ 5B8B C9               RET
3575+ 5B8C
3576+ 5B8C              ; --- CORREGIDO: pese al nombre, esto NO toca la VRAM -- rellena con
3577+ 5B8C              ; $FF, en RAM normal, 0x17 (23) de cada 0x20 (32) bytes por fila, en
3578+ 5B8C              ; 0x90 (144) filas del buffer BUFFER_LOSETAS_TRABAJO (deja 8 bytes/fila sin tocar).
3579+ 5B8C              ; Es la preparacion del "lienzo" de bitmap en RAM que luego vuelca a
3580+ 5B8C              ; VRAM ACTUALIZAR_VRAM_FRAME -- ver hallazgo "el buffer BUFFER_LOSETAS_TRABAJO es un
3581+ 5B8C              ; lienzo de pixeles, no un buffer de tipos de loseta" en FINDINGS.md:
3582+ 5B8C              ; 144 filas = 9 filas de losetas visibles x 16px, 32 bytes/fila = 256px
3583+ 5B8C              ; (ancho total de pantalla = 16 losetas), de las cuales 23+1=24 bytes
3584+ 5B8C              ; (12 losetas) son el area jugable y 8 bytes (4 losetas) quedan bajo
3585+ 5B8C              ; el marco de caramelo. Llamada solo desde LIMPIAR_VRAM_AREA_JUEGO, en el
3586+ 5B8C              ; flujo de menu/demo -- este buffer se reutiliza entre menu y
3587+ 5B8C              ; partida real, no es exclusivo del nivel activo. ---
3588+ 5B8C              RELLENAR_SOLIDO_AREA_JUEGO_BUFFER_VRAM:                       ; $5B8C
3589+ 5B8C 11 04 DE         LD DE, BUFFER_LOSETAS_TRABAJO
3590+ 5B8F 06 90            LD B, 144                    ; 144 filas del buffer
3591+ 5B91              .BUCLE_RELLENAR_FILA:
3592+ 5B91 C5               PUSH BC
3593+ 5B92 D5               PUSH DE
3594+ 5B93 62               LD H, D
3595+ 5B94 6B               LD L, E
3596+ 5B95 13               INC DE
3597+ 5B96 36 FF            LD (HL), $FF                 ; byte de relleno solido
3598+ 5B98 01 17 00         LD BC, 23                    ; 23 de los 32 bytes/fila (area jugable, deja 8 sin tocar)
3599+ 5B9B ED B0            LDIR
3600+ 5B9D E1               POP HL
3601+ 5B9E 01 20 00         LD BC, 32                    ; 32 bytes/fila (avanza a la siguiente fila)
3602+ 5BA1 09               ADD HL, BC
3603+ 5BA2 EB               EX DE, HL
3604+ 5BA3 C1               POP BC
3605+ 5BA4 10 EB            DJNZ .BUCLE_RELLENAR_FILA
3606+ 5BA6 C9               RET
3607+ 5BA7
3608+ 5BA7              ; --- Dispatch por bit de A (bits 1/3/4/5) hacia las 4 variantes del
