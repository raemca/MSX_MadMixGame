4187+ 5F8F 21 60 07         LD HL, $0760
4188+ 5F92 CD D1 5C         CALL DIBUJAR_TEXTO_VRAM
4189+ 5F95 11 E8 5F         LD DE, TEXTO_CREDITOS_GRAFICOS_POR
4190+ 5F98 21 20 09         LD HL, $0920
4191+ 5F9B CD D1 5C         CALL DIBUJAR_TEXTO_VRAM
4192+ 5F9E 11 FA 5F         LD DE, TEXTO_CREDITOS_NOMBRE_GRAFICOS
4193+ 5FA1 21 60 0B         LD HL, $0B60
4194+ 5FA4 CD D1 5C         CALL DIBUJAR_TEXTO_VRAM
4195+ 5FA7 11 0C 60         LD DE, TEXTO_CREDITOS_MUSICA_POR
4196+ 5FAA 21 20 0D         LD HL, $0D20
4197+ 5FAD CD D1 5C         CALL DIBUJAR_TEXTO_VRAM
