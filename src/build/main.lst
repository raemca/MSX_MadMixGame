4232+ C99E              ; del bytecode de sonido (byte de comando = $80 + numero). Mecanica de cada uno verificada
4233+ C99E              ; leyendo el codigo real (ver FINDINGS.md, "Los 15 comandos"); los nombres son interpretacion
4234+ C99E              ; razonada, no verificacion en vivo. Mismo lenguaje que usan .snd/.spt (ver OPS en mmsnd_tool.py). ---
4235+ C99E E5 C6            DW $C6E5    ; comando 0  ($80) SET_VOLUME -- guarda el byte tal cual en (IX+$09), volumen base
4236+ C9A0 03 C7            DW $C703    ; comando 1  ($81) SET_MIXER -- AND $09, guarda en (IX+$08), mascara de mezclador
4237+ C9A2 65 C7            DW $C765    ; comando 2  ($82) LOOP -- recarga BC/(IX+$02-03) desde (IX+$00-01), vuelve al principio del script
4238+ C9A4 EE C6            DW $C6EE    ; comando 3  ($83) SET_DURATION -- multiplica el parametro por ($C9BD), guarda en (IX+$06-07)
4239+ C9A6 61 C7            DW $C761    ; comando 4  ($84) HOLD -- salta directo al cierre de nota sin pasar por duracion nueva
4240+ C9A8 33 C7            DW $C733    ; comando 5  ($85) SET_TEMPO -- recalcula ($C9BD), el multiplicador que usa SET_DURATION
