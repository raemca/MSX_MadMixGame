  33+ 9470              ; ============================================================
  34+ 9470
  35+ 9470              ; --- direcciones VRAM (tabla de color de SCREEN2, $2000-$37FF) que
  36+ 9470              ; se repiten identicas en varias rutinas sin tener etiqueta propia --
  37+ 9470              ; relacion semantica exacta entre las 3 zonas todavia sin confirmar
  38+ 9470              ; del todo (ver comentarios de cada rutina que las usa). ---
  39+ 9470              VRAM_TABLA_COLOR:      EQU $2000  ; base completa de la tabla de color (LIMPIAR_TABLA_COLOR_VRAM)
  40+ 9470              VRAM_COLOR_ZONA_TOPO:  EQU $2658  ; zona de color de "Topo" (ANIMAR_COLOR_TOPO)
  41+ 9470              VRAM_COLOR_ZONA_SOFT:  EQU $2F78  ; zona de color de "Soft" (ANIMAR_PUNTO_LUZ_SOFT/RELLENAR_COLOR_TOPO)
  42+ 9470
  43+ 9470              ENTRADA_LOGOTOPO:
  44+ 9470 C3 D1 95         JP DIBUJAR_LOGO_TOPOSOFT                   ; $9470  C3 D1 95
  45+ 9473
  46+ 9473              ; --- ANIMAR_PUNTO_LUZ_SOFT: CONFIRMADO VISUALMENTE por el usuario --
  47+ 9473              ; el punto de luz que recorre la palabra "Soft" por su linea superior
  48+ 9473              ; tras terminar de rotar, acabando junto a la estrella (coincide en
  49+ 9473              ; posicion exacta en DIBUJAR_LOGO_TOPOSOFT: justo despues de las 3
  50+ 9473              ; llamadas a DIBUJAR_SOFT_ROTANDO y justo antes de
  51+ 9473              ; DIBUJAR_ESTRELLA_ANIMADA). Recorre un rango de direcciones VRAM
  52+ 9473              ; ($2F78->$2FB8) escribiendo con ESCRIBIR_8_BYTES_VRAM (A=$81/$F1 en
  53+ 9473              ; las 2 orientaciones), con HALT como temporizador (3 frames) entre
  54+ 9473              ; posiciones -- crea el efecto de movimiento. ---
  55+ 9473              ANIMAR_PUNTO_LUZ_SOFT:
  56+ 9473 21 78 2F         LD HL, VRAM_COLOR_ZONA_SOFT  ; $9473  21 78 2F
  57+ 9476 11 B8 2F         LD DE, $2FB8                ; $9476  11 B8 2F  ; VRAM color, fin del rango (comparado, no escrito)
  58+ 9479 01 F7 00         LD BC, $00F7                ; $9479  01 F7 00  ; paso VRAM entre las 2 escrituras por posicion
  59+ 947C              .BUCLE_AVANZAR_PUNTO:
  60+ 947C A7               AND A                       ; $947C  A7
  61+ 947D ED 52            SBC HL, DE                  ; $947D  ED 52
  62+ 947F C8               RET Z                       ; $947F  C8
  63+ 9480 19               ADD HL, DE                  ; $9480  19
  64+ 9481 3E 81            LD A, $81                   ; $9481  3E 81  ; byte de color VRAM (orientacion 1)
  65+ 9483 CD A6 94         CALL ESCRIBIR_8_BYTES_VRAM                 ; $9483  CD A6 94
  66+ 9486 E5               PUSH HL                     ; $9486  E5
  67+ 9487 09               ADD HL, BC                  ; $9487  09
  68+ 9488 3E 81            LD A, $81                   ; $9488  3E 81  ; byte de color VRAM (orientacion 1)
  69+ 948A CD A6 94         CALL ESCRIBIR_8_BYTES_VRAM                 ; $948A  CD A6 94
  70+ 948D E1               POP HL                      ; $948D  E1
  71+ 948E E5               PUSH HL                     ; $948E  E5
  72+ 948F 3E F1            LD A, $F1                   ; $948F  3E F1  ; byte de color VRAM (orientacion 2)
  73+ 9491 CD A6 94         CALL ESCRIBIR_8_BYTES_VRAM                 ; $9491  CD A6 94
  74+ 9494 09               ADD HL, BC                  ; $9494  09
  75+ 9495 3E F1            LD A, $F1                   ; $9495  3E F1  ; byte de color VRAM (orientacion 2)
  76+ 9497 CD A6 94         CALL ESCRIBIR_8_BYTES_VRAM                 ; $9497  CD A6 94
  77+ 949A E1               POP HL                      ; $949A  E1
  78+ 949B FB               EI                          ; $949B  FB
  79+ 949C C5               PUSH BC                     ; $949C  C5
  80+ 949D 06 03            LD B, 3                     ; $949D  06 03  ; 3 frames de pausa por posicion
  81+ 949F              .BUCLE_ESPERA_3_FRAMES:
  82+ 949F 76               HALT                        ; $949F  76
  83+ 94A0 10 FD            DJNZ .BUCLE_ESPERA_3_FRAMES                 ; $94A0  10 FD
  84+ 94A2 C1               POP BC                      ; $94A2  C1
  85+ 94A3 F3               DI                          ; $94A3  F3
  86+ 94A4 18 D6            JR .BUCLE_AVANZAR_PUNTO                   ; $94A4  18 D6
  87+ 94A6
  88+ 94A6              ; --- ESCRIBIR_8_BYTES_VRAM: escribe 8 bytes consecutivos en VRAM (HL) con el valor
  89+ 94A6              ; de A, via el hook ROM en $004D -- patron de uso (A=byte, HL=destino
  90+ 94A6              ; VRAM antes del CALL) coincide con la convencion estandar de WRTVRM,
  91+ 94A6              ; probable identidad aunque no confirmada al 100% contra una tabla de
  92+ 94A6              ; hooks de referencia. ---
  93+ 94A6              ESCRIBIR_8_BYTES_VRAM:
  94+ 94A6 C5               PUSH BC                     ; $94A6  C5
  95+ 94A7 06 08            LD B, 8                     ; $94A7  06 08  ; 8 bytes a escribir
  96+ 94A9              .BUCLE_8_BYTES:
  97+ 94A9 CD 4D 00         CALL $004D                  ; $94A9  CD 4D 00  ; probable WRTVRM (hook ROM MSX)
  98+ 94AC 23               INC HL                      ; $94AC  23
  99+ 94AD 10 FA            DJNZ .BUCLE_8_BYTES                 ; $94AD  10 FA
 100+ 94AF C1               POP BC                      ; $94AF  C1
 101+ 94B0 C9               RET                         ; $94B0  C9
 102+ 94B1
 103+ 94B1              ; --- DIBUJAR_FORMA_ANIMADA: motor generico de dibujado de "formas"
 104+ 94B1              ; (las letras T/O/P/O de "Topo", los 7 fotogramas de "Soft" rotando,
 105+ 94B1              ; los 4 fotogramas de la estrella -- CONFIRMADO VISUALMENTE por el
 106+ 94B1              ; usuario). Recibe el indice de forma en $94BD (automodificado por el
 107+ 94B1              ; llamador): lo dobla, lo busca en la tabla de punteros $9694 (15
 108+ 94B1              ; formas validas, indices 0-14), suma el offset a $9728 para llegar a
 109+ 94B1              ; los datos reales. Cabecera de 2 bytes por forma: 1er byte = bytes
 110+ 94B1              ; por segmento (automodifica "LD B,n" en $94F0), 2o byte = numero de
 111+ 94B1              ; segmentos (automodifica "LD C,n" en $94DC). $94B2 (tambien
 112+ 94B1              ; automodificado) indexa una segunda tabla en $96F8 que solo da un
 113+ 94B1              ; delta de posicion/fila (no aporta contenido visual). $94F1/$94DD/
 114+ 94B1              ; $94B2/$94BD/$94E9 son TODOS operandos automodificados por el
 115+ 94B1              ; llamador antes de cada CALL -- $94F3 es directamente el OPCODE de
 116+ 94B1              ; "OR (HL)" en .BUCLE_BYTE (interruptor combinar-con-VRAM-si/no, tambien
 117+ 94B1              ; automodificado). Ver recursos/logotopo_formas.html para las 15
 118+ 94B1              ; formas ya renderizadas. ---
 119+ 94B1              DIBUJAR_FORMA_ANIMADA:
 120+ 94B1 21 00 00         LD HL, $0000                ; $94B1  21 00 00
 121+ 94B4 29               ADD HL, HL                  ; $94B4  29
 122+ 94B5 11 F8 96         LD DE, TABLA_DELTA_POSICION  ; $94B5  11 F8 96
 123+ 94B8 19               ADD HL, DE                  ; $94B8  19
 124+ 94B9 22 F6 96         LD ($96F6), HL              ; $94B9  22 F6 96
 125+ 94BC 21 00 00         LD HL, $0000                ; $94BC  21 00 00
 126+ 94BF 29               ADD HL, HL                  ; $94BF  29
 127+ 94C0 11 94 96         LD DE, TABLA_PUNTEROS_FORMAS ; $94C0  11 94 96
 128+ 94C3 19               ADD HL, DE                  ; $94C3  19
 129+ 94C4 5E               LD E, (HL)                  ; $94C4  5E
 130+ 94C5 23               INC HL                      ; $94C5  23
 131+ 94C6 56               LD D, (HL)                  ; $94C6  56
 132+ 94C7 21 28 97         LD HL, TABLA_FORMAS          ; $94C7  21 28 97
 133+ 94CA 19               ADD HL, DE                  ; $94CA  19
 134+ 94CB 7E               LD A, (HL)                  ; $94CB  7E
 135+ 94CC 32 F1 94         LD ($94F1), A               ; $94CC  32 F1 94  ; automodifica el operando de "LD B,n" en $94F0
 136+ 94CF 23               INC HL                      ; $94CF  23
 137+ 94D0 7E               LD A, (HL)                  ; $94D0  7E
 138+ 94D1 32 DD 94         LD ($94DD), A               ; $94D1  32 DD 94  ; automodifica el operando de "LD C,n" en $94DC
 139+ 94D4 23               INC HL                      ; $94D4  23
 140+ 94D5 22 F4 96         LD ($96F4), HL              ; $94D5  22 F4 96
 141+ 94D8 DD 2A F6 96      LD IX, ($96F6)              ; $94D8  DD 2A F6 96
 142+ 94DC 0E 0A            LD C, 10                    ; $94DC  0E 0A  ; placeholder, automodificado con el nº real de segmentos (ver arriba)
 143+ 94DE              .BUCLE_SEGMENTO:
 144+ 94DE DD 5E 00         LD E, (IX+$00)               ; $94DE  DD 5E 00
 145+ 94E1 DD 23            INC IX                      ; $94E1  DD 23
 146+ 94E3 DD 56 00         LD D, (IX+$00)               ; $94E3  DD 56 00
 147+ 94E6 DD 23            INC IX                      ; $94E6  DD 23
 148+ 94E8 21 00 00         LD HL, $0000                ; $94E8  21 00 00
 149+ 94EB 19               ADD HL, DE                  ; $94EB  19
 150+ 94EC ED 5B F4 96      LD DE, ($96F4)              ; $94EC  ED 5B F4 96
 151+ 94F0 06 00            LD B, 0                     ; $94F0  06 00  ; placeholder, automodificado con el ancho real del segmento (ver arriba)
 152+ 94F2              .BUCLE_BYTE:
 153+ 94F2 1A               LD A, (DE)                  ; $94F2  1A
 154+ 94F3 B6               OR (HL)                     ; $94F3  B6
 155+ 94F4 13               INC DE                      ; $94F4  13
 156+ 94F5 CB BC            RES 7, H                    ; $94F5  CB BC
 157+ 94F7 CB B4            RES 6, H                    ; $94F7  CB B4
 158+ 94F9 CD 4D 00         CALL $004D                  ; $94F9  CD 4D 00  ; probable WRTVRM (hook ROM MSX)
 159+ 94FC 23               INC HL                      ; $94FC  23
 160+ 94FD CB F4            SET 6, H                    ; $94FD  CB F4
 161+ 94FF CB FC            SET 7, H                    ; $94FF  CB FC
 162+ 9501 10 EF            DJNZ .BUCLE_BYTE                 ; $9501  10 EF
 163+ 9503 ED 53 F4 96      LD ($96F4), DE              ; $9503  ED 53 F4 96
 164+ 9507 0D               DEC C                       ; $9507  0D
 165+ 9508 20 D4            JR NZ, .BUCLE_SEGMENTO               ; $9508  20 D4
 166+ 950A C9               RET                         ; $950A  C9
