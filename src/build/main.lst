2089+ 5351 79               LD A, C
2090+ 5352 DD 66 00         LD H, (IX+0)               ; HL = posicion:subposicion del eje X (IX+0:IX+4)
2091+ 5355 DD 6E 04         LD L, (IX+4)
2092+ 5358 11 00 01         LD DE, $0100              ; DE = incremento de movimiento (paso normal)...
2093+ 535B 28 03            JR Z, .CONTINUAR_TRAS_ELEGIR_PASO
2094+ 535D 11 80 00         LD DE, $0080                ; ...o mitad de paso si (IX+2) esta activo
2095+ 5360              .CONTINUAR_TRAS_ELEGIR_PASO:
2096+ 5360 3A 0D 2C         LD A, (MODO_ESPECIAL_FLAG)
