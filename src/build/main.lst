 200+ C416              ; --- Analogo a MASCARA_SLOT_PRIMARIO pero para el registro de subslot
 201+ C416              ; (EXPTBL, via puerto $A8 + $FFFF) -- misma tecnica de replicacion por
 202+ C416              ; suma modular de $55. Tampoco verificado bit a bit al 100%. ---
 203+ C416              ENASLT_EXTENDIDO_MASCARA_SUBSLOT:
 204+ C416 F5               PUSH AF
 205+ C417 7A               LD A, D
 206+ C418 E6 C0            AND $C0                     ; conserva los 2 bits ya calculados por
 207+ C41A                                            ; MASCARA_SLOT_PRIMARIO (parte alta de D)
 208+ C41A 4F               LD C, A
 209+ C41B F1               POP AF
 210+ C41C F5               PUSH AF
 211+ C41D 57               LD D, A
 212+ C41E DB A8            IN A, ($A8)                 ; lee el slot primario actual
 213+ C420 47               LD B, A
 214+ C421 E6 3F            AND $3F                     ; limpia los 2 bits superiores (pagina
 215+ C423                                            ; objetivo) antes de insertar el subslot
 216+ C423 B1               OR C
 217+ C424 D3 A8            OUT ($A8), A                ; selecciona temporalmente el subslot a
 218+ C426                                            ; consultar/modificar
 219+ C426 7A               LD A, D
 220+ C427 0F               RRCA
 221+ C428 0F               RRCA
 222+ C429 E6 03            AND $03                     ; aisla de nuevo el numero de pagina (0-3)
 223+ C42B 57               LD D, A
