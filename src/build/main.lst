 741+ 2E3C              ; --- tabla de despacho por tipo de loseta (0x2E3C-0x2E64, 20
 742+ 2E3C              ; punteros -- CORREGIDO: se penso que eran 16 hasta que
 743+ 2E3C              ; CONSULTAR_PROXIMA_LOSETA_EN_ESTA_DIRECCION no cuadraba con su direccion real 0x2E64;
 744+ 2E3C              ; 0x2E64-0x2E3C=40 bytes=20 entradas, no 32/16). Las ultimas 3
 745+ 2E3C              ; entradas (tipos 17-19) son HNDLR_TRAMPILLA_ABIERTA_DERECHA/HNDLR_TRAMPILLA_ABIERTA_IZQUIERDA/
 746+ 2E3C              ; HNDLR_TRAMPILLA_CERRADA -- resuelve de paso la duda de "quien llama a
 747+ 2E3C              ; esos bloques". OJO al leer los nombres: son el nombre de la
 748+ 2E3C              ; ETIQUETA de destino, no el INDICE/tipo de loseta que la usa (p.ej.
 749+ 2E3C              ; HNDLR_TRAMPILLA_CERRADA es la entrada de tipo 19, no la "A" de nada) --
 750+ 2E3C              ; confusion real que ya paso una vez al transcribir esto en su momento
 751+ 2E3C              ; (cuando las etiquetas eran solo direccion hex), ver FINDINGS.md.
 752+ 2E3C              TABLA_MANEJADORES_LOSETA:
 753+ 2E3C B7 2E C7 2E      DW HNDLR_SUELO_NORMAL, HNDLR_BOLITA_NORMAL, HNDLR_BOLITA_CLAVADA, HNDLR_AUTOCOCO_ARRIBA
 753+ 2E40 FC 2E 18 2F
 754+ 2E44 50 2F 88 2F      DW HNDLR_AUTOCOCO_ABAJO, HNDLR_AUTOCOCO_IZQUIERDA, HNDLR_AUTOCOCO_DERECHA, HNDLR_PISTA_COCOTANQUE
 754+ 2E48 C0 2F F8 2F
 755+ 2E4C B7 2E B7 2E      DW HNDLR_SUELO_NORMAL, HNDLR_SUELO_NORMAL, HNDLR_PISTA_COCONAVE, HNDLR_ITEM_SUELO
 755+ 2E50 67 30 F3 30
 756+ 2E54 1B 31 5D 31      DW HNDLR_BOLA_PODER, HNDLR_HIPODOSO, HNDLR_EXCAVATOFONO, HNDLR_SUELO_SIN_BOLA
 756+ 2E58 8E 31 B7 31
 757+ 2E5C B7 31 52 32      DW HNDLR_SUELO_SIN_BOLA, HNDLR_TRAMPILLA_ABIERTA_DERECHA, HNDLR_TRAMPILLA_ABIERTA_IZQUIERDA, HNDLR_TRAMPILLA_CERRADA
 757+ 2E60 99 32 E2 32
 758+ 2E64
 759+ 2E64              ; --- CONSULTAR_PROXIMA_LOSETA_EN_ESTA_DIRECCION (0x2E64) -- aplica un desplazamiento de 1
 760+ 2E64              ; loseta en una direccion (rotando A bit a bit sobre BC) y consulta
 761+ 2E64              ; MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA + CONSULTAR_TIPO_LOSETA en esa posicion. ---
 762+ 2E64              ; PENDIENTE: asimetria sin explicar entre pares de direccion opuestos
 763+ 2E64              ; -- derecha/abajo suman $04 (un paso de loseta completo, sobrevive
 764+ 2E64              ; siempre al AND $7C de MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA), pero
 765+ 2E64              ; izquierda/arriba solo restan 1 (puede que NI SIQUIERA cruce un
 766+ 2E64              ; limite de loseta, segun la sub-posicion actual). Sin confirmar si
 767+ 2E64              ; es un comportamiento deliberado del juego original o un caso sin
 768+ 2E64              ; explorar del todo -- pendiente de verificar en vivo (emulador) si
 769+ 2E64              ; detectar loseta a la izquierda/arriba se comporta distinto a
 770+ 2E64              ; derecha/abajo. Ver FINDINGS.md.
 771+ 2E64              CONSULTAR_PROXIMA_LOSETA_EN_ESTA_DIRECCION:
 772+ 2E64 C5               PUSH BC
 773+ 2E65 ED 4B 16 2C      LD BC, (POSICION_ACTUAL_CAMARA)            ; BC = posicion de camara actual (columna,fila)
 774+ 2E69 1F               RRA
 775+ 2E6A 30 06            JR NC, COMPROBAR_LOSETA_IZQUIERDA              ; bit0 de la direccion (derecha) no activo -> sigue probando
 776+ 2E6C 79               LD A, C
 777+ 2E6D C6 04            ADD A, $04                    ; derecha: +1 columna (4 = paso de una loseta en esta unidad)
 778+ 2E6F 4F               LD C, A
 779+ 2E70 18 13            JR IDENTIFICAR_PROXIMA_LOSETA
 780+ 2E72              COMPROBAR_LOSETA_IZQUIERDA:
 781+ 2E72 1F               RRA
 782+ 2E73 30 03            JR NC, COMPROBAR_LOSETA_ABAJO              ; bit1 (izquierda) no activo -> sigue probando
 783+ 2E75 0D               DEC C                         ; izquierda: -1 columna
 784+ 2E76 18 0D            JR IDENTIFICAR_PROXIMA_LOSETA
 785+ 2E78              COMPROBAR_LOSETA_ABAJO:
 786+ 2E78 1F               RRA
 787+ 2E79 30 06            JR NC, COMPROBAR_LOSETA_ARRIBA              ; bit2 (abajo) no activo -> sigue probando
 788+ 2E7B 78               LD A, B
 789+ 2E7C C6 04            ADD A, $04                    ; abajo: +1 fila
 790+ 2E7E 47               LD B, A
 791+ 2E7F 18 04            JR IDENTIFICAR_PROXIMA_LOSETA
 792+ 2E81              COMPROBAR_LOSETA_ARRIBA:
 793+ 2E81 1F               RRA
 794+ 2E82 30 01            JR NC, IDENTIFICAR_PROXIMA_LOSETA              ; bit3 (arriba) no activo -> ninguna direccion (BC sin cambios)
 795+ 2E84 05               DEC B                         ; arriba: -1 fila
 796+ 2E85              IDENTIFICAR_PROXIMA_LOSETA:
 797+ 2E85 CD B6 8C         CALL MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA                ; MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA: HL=direccion de la loseta desplazada
 798+ 2E88 3A 13 2C         LD A, (CACHE_COLUMNA_LOSETA)              ; cache de la ultima columna consultada (evita repetir
 799+ 2E8B BD               CP L                          ; CONSULTAR_TIPO_LOSETA para la misma loseta en llamadas seguidas)
 800+ 2E8C 3A 12 2C         LD A, (CACHE_TIPO_LOSETA)                  ; valor de tipo cacheado
 801+ 2E8F 28 0A            JR Z, ENMASCARAR_TIPO_LOSETA                    ; misma columna que la ultima vez -> reusa el cache
 802+ 2E91 7D               LD A, L
 803+ 2E92 32 13 2C         LD (CACHE_COLUMNA_LOSETA), A
 804+ 2E95 CD DA 8C         CALL CONSULTAR_TIPO_LOSETA                ; CONSULTAR_TIPO_LOSETA (columna distinta -> consulta real)
 805+ 2E98 32 12 2C         LD (CACHE_TIPO_LOSETA), A
