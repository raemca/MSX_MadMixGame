 121+ 1098 C2 95 10         JP NZ, .BUCLE_RELLENAR_COLOR             ; repite el mismo color 8 veces (una
 122+ 109B                                                  ; columna de 8 lineas de un caracter)
 123+ 109B 05               DEC B
 124+ 109C C2 95 10         JP NZ, .BUCLE_RELLENAR_COLOR
 125+ 109F C1               POP BC                         ; recupera el 8 (bytes escritos) para avanzar el destino
 126+ 10A0 09               ADD HL, BC                     ; HL (destino VRAM) += 8, avanza a la siguiente columna
 127+ 10A1 EB               EX DE, HL                      ; HL = origen actualizado, DE = destino
 128+ 10A2 C1               POP BC                         ; recupera el contador de grupos restantes (guardado al entrar al bucle)
