  61  DD08                  SAVEBIN "build/disk/MADMIX.SCR", $8800, END_OF_FILE_SCR_DISK-$8800
  62  DD08
  63  DD08              ; --- Fichero para la version .cas: mismo contenido logico ya
  64  DD08              ; ensamblado arriba (DIBUJAR_PORTADA en adelante), SIN cabecera BLOAD y
  65  DD08              ; SIN el offset fisico $8800 -- la cinta carga esto directo en $1000,
  66  DD08              ; sin paso de reubicacion. build/MADMIX1.BIN (arriba) sirve tal cual
  67  DD08              ; como la pieza "motor" de la version de cinta -- identico en ambas
  68  DD08              ; ediciones, no hace falta un SAVEBIN aparte para eso. Tamano = el
  69  DD08              ; fisico total menos cabecera (7) y menos el byte suelto final (1). ---
  70  DD08                  SAVEBIN "build/cas/madmix_cas_scr.bin", SCR_BODY_START_PHYS, (END_OF_FILE_SCR_DISK-1)-SCR_BODY_START_PHYS
  71  DD08
  72  DD08              ; --- MADMIX0.BIN: el "relocador" de disco, 58 bytes. Este bloque va
  73  DD08              ; DESPUES del de MADMIX1.BIN (arriba) a proposito: su SAVEBIN ya
  74  DD08              ; capturo el contenido real del driver de sonido en $C350 antes de
  75  DD08              ; que un futuro bloque de TEST.BIN (cinta) reutilice esa misma
  76  DD08              ; direccion fisica -- verificado con una prueba minima que SAVEBIN
  77  DD08              ; recupera una foto del buffer en el momento de su propia llamada,
  78  DD08              ; en orden de fuente, no "el ultimo que escribe gana". ---
  79  DD08                  ORG $FA00
  80  FA00              MADMIX0_HEADER_START:
  81  FA00 FE               DB $FE                     ; cabecera de fichero .BIN de MSX
  82  FA01                  ; Constantes literales (no etiquetas): la cabecera BLOAD declara la
  83  FA01                  ; direccion de carga REAL en la maquina, que NO incluye los 7 bytes
  84  FA01                  ; de la propia cabecera -- BLOAD los descarta antes de situar los
  85  FA01                  ; datos en RAM. En nuestro ensamblado, en cambio, la cabecera SI
  86  FA01                  ; ocupa espacio fisico antes de RELOCATOR (que por eso cae en $FA07,
  87  FA01                  ; no en $FA00). Usar la etiqueta aqui produciria valores erroneos.
  88  FA01 00 FA 32 FA      DW $FA00, $FA32, $FA00
  88  FA05 00 FA
  89  FA07
  90  FA07                  INCLUDE "load_disk/madmix0_body.asm"
# file opened: madmix0_body.asm
   1+ FA07              ; ============================================================
   2+ FA07              ;  MADMIX0.BIN (Topo Soft, 1987) - MSX1
   3+ FA07              ;  El "relocador" -- 58 bytes, desensamblado completo y verificado
   4+ FA07              ;  directamente con Z80Dasm (offset de cabecera correcto), sin
   5+ FA07              ;  ambiguedad. Confirma y AMPLIA lo que decia FINDINGS.md: tiene
   6+ FA07              ;  DOS puntos de entrada, no uno.
   7+ FA07              ;
   8+ FA07              ;  - 0xFA00 (RELOCATOR, la direccion "exec" de su propia cabecera
   9+ FA07              ;    BLOAD): guarda la configuracion de slot primario (puerto
  10+ FA07              ;    $A8) en $FFFD, la retuerce (SRL x4 + OR con el valor original)
  11+ FA07              ;    y guarda ESE resultado en $FFFE tambien, conmuta a RAM en la
  12+ FA07              ;    pagina 0, hace el LDIR de 0x5500 bytes desde 0x8800 (donde
  13+ FA07              ;    acaba de aterrizar MADMIX.SCR) a 0x1000, llama a 0x1000
  14+ FA07              ;    (arranca el dibujado de portada -- ver madmix_scr_body.asm,
  15+ FA07              ;    DIBUJAR_PORTADA), restaura el slot desde $FFFD, EI, RET. Es el
  16+ FA07              ;    que se ejecuta automaticamente via "BLOAD MADMIX0.BIN,R"
  17+ FA07              ;    justo despues de cargar MADMIX.SCR.
  18+ FA07              ;
  19+ FA07              ;  - 0xFA2A (JUMP_TO_ENGINE): un SEGUNDO punto de entrada,
  20+ FA07              ;    independiente del primero (no se llega aqui por caida, el RET
  21+ FA07              ;    de arriba ya ha devuelto el control antes). Restaura la OTRA
  22+ FA07              ;    configuracion de slot guardada (desde $FFFE, no $FFFD) y salta
  23+ FA07              ;    directo a 0x8400 (JT_INICIO de MADMIX1.BIN). Candidato fuerte a
  24+ FA07              ;    ser invocado por un CALL/USR explicito desde el BASIC
  25+ FA07              ;    orquestador, DESPUES de haber cargado tambien MADMIX1.BIN (que
  26+ FA07              ;    en su propio BLOAD no lleva ",R" -- alguien tiene que arrancarlo
  27+ FA07              ;    a mano, y esta es la pieza que falta para ese hilo).
  28+ FA07              ; Ingeniería inversa, herramientas y documentación de este proyecto: Rafael Eduardo Martín Candial (raemca@hotmail.com)
  29+ FA07              ; ============================================================
  30+ FA07
  31+ FA07              RELOCATOR:
  32+ FA07 F3               DI
  33+ FA08 DB A8            IN A, ($A8)          ; lee configuracion de slot primario
  34+ FA0A 47               LD B, A
  35+ FA0B 32 FD FF         LD ($FFFD), A         ; guarda config actual (para restaurarla luego)
  36+ FA0E CB 3F            SRL A
  37+ FA10 CB 3F            SRL A
  38+ FA12 CB 3F            SRL A
  39+ FA14 CB 3F            SRL A
  40+ FA16 B0               OR B
  41+ FA17 32 FE FF         LD ($FFFE), A          ; guarda una SEGUNDA config (retorcida), para
  42+ FA1A                                          ; el otro punto de entrada de mas abajo
  43+ FA1A D3 A8            OUT ($A8), A            ; conmuta slots (RAM en pagina 0)
  44+ FA1C 21 00 88         LD HL, $8800
  45+ FA1F 11 00 10         LD DE, $1000
  46+ FA22 01 00 55         LD BC, $5500
  47+ FA25 ED B0            LDIR                      ; copia 0x5500 bytes de 0x8800 a 0x1000
  48+ FA27 CD 00 10         CALL DIBUJAR_PORTADA          ; ejecuta el bloque reubicado (portada)
  49+ FA2A 3A FD FF         LD A, ($FFFD)
  50+ FA2D D3 A8            OUT ($A8), A                ; restaura slots
  51+ FA2F FB               EI
  52+ FA30 C9               RET
  53+ FA31
  54+ FA31              JUMP_TO_ENGINE:
  55+ FA31 F3               DI
  56+ FA32 3A FE FF         LD A, ($FFFE)
  57+ FA35 D3 A8            OUT ($A8), A                ; restaura la OTRA configuracion de slot
  58+ FA37 C3 00 84         JP START                     ; salta directo a JT_INICIO (MADMIX1.BIN)
  59+ FA3A
  60+ FA3A              END_OF_FILE_M0:
  61+ FA3A
# file closed: madmix0_body.asm
