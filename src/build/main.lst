1826+ 5192 02 02 02 02
1827+ 5196 01 01 02 02      DB $01,$01,$02,$02,$01,$01,$01,$01  ; libres=derecha+izquierda (0011) -- prev.derecha->derecha, prev.izquierda->izquierda, resto->derecha
1827+ 519A 01 01 01 01
1828+ 519E 04 04 04 04      DB $04,$04,$04,$04,$04,$04,$04,$04  ; libres=abajo (0100)
1828+ 51A2 04 04 04 04
1829+ 51A6 01 01 04 04      DB $01,$01,$04,$04,$04,$04,$01,$01  ; libres=derecha+abajo (0101)
1829+ 51AA 04 04 01 01
