 220+ 10E5 02               DB $02                     ; R0: modo grafico 2
 221+ 10E6 E2               DB $E2                     ; R1: pantalla encendida, sprites grandes (16x16 x2)
 222+ 10E7 06               DB $06                     ; R2: tabla de nombres en $1800 ($1800/$400=6) -- coincide con DIBUJAR_PORTADA
 223+ 10E8 80               DB $80                     ; R3: tabla de color en $2000 (bit7=bloque alto) -- coincide con BUCLE_DESCOMPRIMIR_COLOR_PORTADA
 224+ 10E9 00               DB $00                     ; R4: tabla de patrones en $0000 -- coincide con el volcado del bitmap
 225+ 10EA 36               DB $36                     ; R5: tabla de atributos de sprite en $1B00 (sin sprites en esta pantalla, sin contraste posible)
 226+ 10EB 07               DB $07                     ; R6: tabla de patrones de sprite en $3800 (idem, sin contraste posible)
 227+ 10EC 11               DB $11                     ; R7: color de borde/texto
