2582+ 55DE 20 14            JR NZ, .SIN_PLANTAR_REGPUNANTOSO
2583+ 55E0 CD 59 55         CALL MAPEAR_COORDENADA_A_DIRECCION_LOCAL
2584+ 55E3 7E               LD A, (HL)
2585+ 55E4 CB 7F            BIT 7, A                 ; bit7 = loseta ya "comida" -- aqui se exige LO CONTRARIO que en
2586+ 55E6 20 0C            JR NZ, .SIN_PLANTAR_REGPUNANTOSO             ; la instancia 1: debe estar SIN comer
2587+ 55E8 D6 2D            SUB $2D                  ; indice de loseta - $2D(45)...
