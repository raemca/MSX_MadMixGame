2068+ 533A 6F               LD L, A                               ; bit aleatorio) -> devuelve la direccion final elegida
2069+ 533B 7C               LD A, H
2070+ 533C CE 00            ADC A, $00
2071+ 533E 67               LD H, A
2072+ 533F 7E               LD A, (HL)
2073+ 5340              .FIJAR_DIRECCION_Y_PASO:
2074+ 5340 DD 77 03         LD (IX+3), A
2075+ 5343 4F               LD C, A
2076+ 5344 79               LD A, C
2077+ 5345 E6 0F            AND $0F
2078+ 5347 21 38 2C         LD HL, TABLA_CLASE_ALINEAMIENTO
2079+ 534A 85               ADD A, L
2080+ 534B 6F               LD L, A
2081+ 534C 4E               LD C, (HL)                ; CORREGIDO: NO es velocidad -- TABLA_CLASE_ALINEAMIENTO aqui convierte
2082+ 534D                                             ; la direccion bitmask ($01/$02/$04/$08) en un codigo COMPACTO
2083+ 534D                                             ; 1-4 (derecha/izquierda/abajo/arriba), reutilizado por el
2084+ 534D                                             ; llamador para indexar tablas de sprite (ver HNDLR_PELMAZOIDE/
2085+ 534D                                             ; HNDLR_MARICOCO/HNDLR_REGPUNANTOSO e TABLA_ANIMACION_PELMAZOIDE/
2086+ 534D                                             ; TABLA_ANIMACION_MARICOCO/TABLA_ANIMACION_REGPUNANTOSO)
