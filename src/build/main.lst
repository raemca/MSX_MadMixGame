2676+ 566A              ; --- Manejador de "pista" (tanque/avion, ver graficos.html) --
2677+ 566A              ; comprueba 3 entradas de una tabla en $2C2E (fuera de este fichero,
2678+ 566A              ; RAM de trabajo) contra la posicion del comecocos con margenes
2679+ 566A              ; asimetricos (+-4/+-12 filas, +-8/+-20 columnas segun un flag). Si
2680+ 566A              ; coincide, llama a ARMAR_AVISO_DESTELLO con C=$4D y anota EVENTO_SONIDO_PENDIENTE=$07. --
2681+ 566A              AVISAR_PROXIMIDAD_PISTA:                 ; $566A
2682+ 566A DD E5            PUSH IX
2683+ 566C D5               PUSH DE
2684+ 566D D9               EXX                       ; DE' = posicion del comecocos (pasada por el llamador en DE)
2685+ 566E D1               POP DE
2686+ 566F D9               EXX
2687+ 5670 06 03            LD B, $03
2688+ 5672 21 2E 2C         LD HL, TABLA_PISTA_TANQUE_AVION
2689+ 5675              .BUCLE_PISTA:
2690+ 5675              ; --- Decodifica la entrada de $2C2E igual que el bucle de pista
2691+ 5675              ; de MOTOR_MOVIMIENTO_COLISION (BUCLE_PISTA_TANQUE_AVION): byte0=activa, byte1 bit0/bit7 seleccionan
2692+ 5675              ; el mismo formato de posicion de dos sub-tipos -- aqui solo para
2693+ 5675              ; CALCULAR la posicion (D/E), no para dibujar nada todavia. ---
2694+ 5675 C5               PUSH BC
2695+ 5676 7E               LD A, (HL)
2696+ 5677 A7               AND A
2697+ 5678 28 48            JR Z, .SIGUIENTE_PISTA              ; entrada vacia -> siguiente
2698+ 567A 23               INC HL
2699+ 567B 56               LD D, (HL)
2700+ 567C CB 42            BIT 0, D
2701+ 567E 28 0A            JR Z, .FORMATO_B
2702+ 5680 2B               DEC HL
2703+ 5681 D6 10            SUB $10
2704+ 5683 57               LD D, A
2705+ 5684 1E 40            LD E, $40
2706+ 5686 30 14            JR NC, .COMPROBAR_MARGEN_PISTA
2707+ 5688 18 38            JR .SIGUIENTE_PISTA                   ; fuera de rango -> siguiente (no borra la entrada, a
2708+ 568A                                                  ; diferencia del bucle de pista de dibujado)
2709+ 568A              .FORMATO_B:
2710+ 568A CB 7E            BIT 7, (HL)
2711+ 568C 2B               DEC HL
2712+ 568D 28 05            JR Z, .FORMATO_B_POS
2713+ 568F D6 08            SUB $08
2714+ 5691 5F               LD E, A
2715+ 5692 18 05            JR .FILA_FIJA
