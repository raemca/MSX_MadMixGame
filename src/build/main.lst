2722+ 569A 16 38            LD D, $38
2723+ 569C              .COMPROBAR_MARGEN_PISTA:
2724+ 569C              ; --- Con la posicion de la pista (D,E) ya calculada, comprueba si el
2725+ 569C              ; comecocos (BC, recuperado de DE') esta dentro de un margen
2726+ 569C              ; ASIMETRICO alrededor de ella: columna en [-4,+12), fila en [-8,+20)
2727+ 569C              ; -- una zona de "aviso" mas amplia que la propia loseta, para
2728+ 569C              ; detectar la proximidad ANTES de pisarla de verdad. Si esta dentro,
2729+ 569C              ; llama a ARMAR_AVISO_DESTELLO (arma un aviso/pista en TABLA_RANURAS_AVISO)
2730+ 569C              ; y marca evento EVENTO_SONIDO_PENDIENTE=7. ---
2731+ 569C D9               EXX
2732+ 569D D5               PUSH DE
2733+ 569E D9               EXX
2734+ 569F C1               POP BC
2735+ 56A0 79               LD A, C
2736+ 56A1 C6 FC            ADD A, $FC
2737+ 56A3 BB               CP E
2738+ 56A4 30 1C            JR NC, .SIGUIENTE_PISTA           ; fuera del margen de columna por un lado
