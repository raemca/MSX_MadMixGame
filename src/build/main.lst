3768+ 5CAF              ; --- Escribe un patron de 8 filas (D) en VRAM, offset via A*8+$925B,
3769+ 5CAF              ; con doble llamada a FILVRM/LDIRVM ($8931/$8942) para las dos mitades. ---
3770+ 5CAF              ESCRIBIR_PATRON_VRAM:              ; $5CAF
3771+ 5CAF C5               PUSH BC
3772+ 5CB0 E5               PUSH HL
3773+ 5CB1 6F               LD L, A
3774+ 5CB2 26 00            LD H, 0
3775+ 5CB4 29               ADD HL, HL                 ; HL = A*8 (offset del patron dentro del bloque)
3776+ 5CB5 29               ADD HL, HL
3777+ 5CB6 29               ADD HL, HL
3778+ 5CB7 11 5B 92         LD DE, $925B
3779+ 5CBA 19               ADD HL, DE
3780+ 5CBB D1               POP DE
3781+ 5CBC 01 08 00         LD BC, 8                    ; 8 bytes: mitad "forma" del patron
3782+ 5CBF CD 42 89         CALL LDIRVM
3783+ 5CC2 EB               EX DE, HL
3784+ 5CC3 CB EC            SET 5, H                   ; HL += $2000: salta a la mitad "color/atributo" gemela del mismo bloque
3785+ 5CC5 08               EX AF, AF'                 ; recupera en A el 2o byte de cabecera de DIBUJAR_TEXTO_VRAM (valor de relleno de color)
3786+ 5CC6 F5               PUSH AF
3787+ 5CC7 01 08 00         LD BC, 8                    ; 8 bytes: mitad "color/atributo" del patron
3788+ 5CCA CD 31 89         CALL FILVRM              ; equivalente a la rutina FILVRM del BIOS de MSX
3789+ 5CCD F1               POP AF
3790+ 5CCE 08               EX AF, AF'
3791+ 5CCF C1               POP BC
3792+ 5CD0 C9               RET
3793+ 5CD1
3794+ 5CD1              ; --- Motor de "descompresion"/dibujado de recursos: DE apunta a un
3795+ 5CD1              ; registro [byte,byte,tabla de C bytes] -- C=numero de caracteres,
3796+ 5CD1              ; 2o byte=valor de color/atributo (guardado en AF', usado por
3797+ 5CD1              ; ESCRIBIR_PATRON_VRAM para la mitad "color" de cada patron) -- cada
3798+ 5CD1              ; byte de la tabla (si >=$20) dibuja un patron via ESCRIBIR_PATRON_VRAM,
3799+ 5CD1              ; avanzando HL 8 columnas cada vez; si es <$20, no es un caracter --
3800+ 5CD1              ; es un contador de columnas en blanco a saltar (ver .SALTAR_COLUMNAS). ---
3801+ 5CD1              DIBUJAR_TEXTO_VRAM:                         ; $5CD1
3802+ 5CD1 F3               DI
3803+ 5CD2 1A               LD A, (DE)
3804+ 5CD3 4F               LD C, A                    ; C = numero de caracteres del registro
3805+ 5CD4 13               INC DE
3806+ 5CD5 08               EX AF, AF'
3807+ 5CD6 1A               LD A, (DE)                 ; 2o byte de cabecera: valor de color/atributo (queda en AF' para ESCRIBIR_PATRON_VRAM)
3808+ 5CD7 08               EX AF, AF'
3809+ 5CD8 13               INC DE
3810+ 5CD9              .BUCLE_CARACTER:
3811+ 5CD9 1A               LD A, (DE)
3812+ 5CDA FE 20            CP $20                     ; <$20 -> no es codigo de patron, es contador de salto (ver .SALTAR_COLUMNAS)
3813+ 5CDC 38 15            JR C, .SALTAR_COLUMNAS
3814+ 5CDE E5               PUSH HL
3815+ 5CDF D5               PUSH DE
3816+ 5CE0 CD AF 5C         CALL ESCRIBIR_PATRON_VRAM
3817+ 5CE3 D1               POP DE
3818+ 5CE4 E1               POP HL
3819+ 5CE5 3E 08            LD A, 8                    ; avanza HL 8 columnas (ancho de un caracter)
3820+ 5CE7 85               ADD A, L
3821+ 5CE8 6F               LD L, A
3822+ 5CE9 7C               LD A, H
3823+ 5CEA CE 00            ADC A, 0
3824+ 5CEC 67               LD H, A
3825+ 5CED              .CONTINUAR_CARACTER:
3826+ 5CED 13               INC DE
3827+ 5CEE 0D               DEC C
3828+ 5CEF 20 E8            JR NZ, .BUCLE_CARACTER
3829+ 5CF1 FB               EI
3830+ 5CF2 C9               RET
3831+ 5CF3              .SALTAR_COLUMNAS:
3832+ 5CF3 F5               PUSH AF
3833+ 5CF4 3E 08            LD A, 8                    ; suma 8 columnas por cada unidad del contador de salto
3834+ 5CF6 85               ADD A, L
3835+ 5CF7 6F               LD L, A
3836+ 5CF8 F1               POP AF
3837+ 5CF9 3D               DEC A
3838+ 5CFA 20 F7            JR NZ, .SALTAR_COLUMNAS
3839+ 5CFC 18 EF            JR .CONTINUAR_CARACTER
3840+ 5CFE
3841+ 5CFE              ; --- Espera a que se pulse una tecla (via COMPROBAR_PULSACION). ---
3842+ 5CFE              ESPERAR_TECLA_PULSADA:                ; $5CFE
3843+ 5CFE CD 0A 5D         CALL COMPROBAR_PULSACION
3844+ 5D01 28 FB            JR Z, ESPERAR_TECLA_PULSADA
3845+ 5D03 C9               RET
3846+ 5D04              ; --- Espera a que se suelte la tecla actual (via COMPROBAR_PULSACION). ---
3847+ 5D04              ESPERAR_TECLA_SOLTADA:                     ; $5D04
3848+ 5D04 CD 0A 5D         CALL COMPROBAR_PULSACION
3849+ 5D07 20 FB            JR NZ, ESPERAR_TECLA_SOLTADA
3850+ 5D09 C9               RET
3851+ 5D0A
3852+ 5D0A              ; --- Lectura de teclado por matriz (puerto $AA selecciona fila,
3853+ 5D0A              ; $A9 lee columnas), C = numero de fila (0-8), busca la primera
3854+ 5D0A              ; tecla pulsada. Igual que el estandar del BIOS MSX. ---
3855+ 5D0A              COMPROBAR_PULSACION:                       ; $5D0A
3856+ 5D0A 0E 00            LD C, $00
3857+ 5D0C              .BUCLE_FILA:
3858+ 5D0C DB AA            IN A, ($AA)
3859+ 5D0E E6 F0            AND $F0
3860+ 5D10 81               ADD A, C
3861+ 5D11 D3 AA            OUT ($AA), A
3862+ 5D13 DB A9            IN A, ($A9)
3863+ 5D15 FE FF            CP $FF
3864+ 5D17 C0               RET NZ
3865+ 5D18 0C               INC C
3866+ 5D19 3E 09            LD A, $09
3867+ 5D1B B9               CP C
3868+ 5D1C C8               RET Z
3869+ 5D1D 18 ED            JR .BUCLE_FILA
