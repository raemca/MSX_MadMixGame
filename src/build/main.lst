 591+ 2D8F 87               ADD A, A
 592+ 2D90 21 48 2C         LD HL, PUNTEROS_SUBTABLA_DIRECCION
 593+ 2D93 85               ADD A, L
 594+ 2D94 6F               LD L, A
 595+ 2D95 7C               LD A, H
 596+ 2D96 CE 00            ADC A, $00
 597+ 2D98 67               LD H, A
 598+ 2D99 5E               LD E, (HL)
 599+ 2D9A 23               INC HL
 600+ 2D9B 56               LD D, (HL)
 601+ 2D9C              ; --- Recorre las 4 entradas de 4 bytes de la subtabla de direccion
 602+ 2D9C              ; (DE) usando un indice rotativo ($2C14, 0-3, avanza 1 cada llamada)
 603+ 2D9C              ; combinado con C (el valor de TABLA_CLASE_ALINEAMIENTO, $2C38):
 604+ 2D9C              ; centinela $FF -> prueba la siguiente entrada (bucle); $FE -> hereda
 605+ 2D9C              ; el ultimo valor real de ($2C11) en vez de uno nuevo; cualquier otro
 606+ 2D9C              ; valor se adopta directo y se guarda en ($2C11) (la misma variable
 607+ 2D9C              ; que ajusta PANTALLA_PRESENTACION_NIVEL para el "modo especial 3").
 608+ 2D9C              ; RESUELTO: sus 7 bits bajos viajan (via PREPARAR_SCROLL, registro B)
 609+ 2D9C              ; hasta MOTOR_ACTORES, donde se usan como indice en PTR_TABLA_SPRITES
 610+ 2D9C              ; -- es el SELECTOR DEL FOTOGRAMA DE ANIMACION del comecocos (que fase
 611+ 2D9C              ; de boca + orientacion dibujar), no un parametro de scroll como se
 612+ 2D9C              ; penso en un principio: el bit7 es el volteo horizontal (reutiliza
 613+ 2D9C              ; el sprite de la derecha para la izquierda, igual que en los
 614+ 2D9C              ; fantasmas). Ver FINDINGS.md para el rastreo completo registro a
 615+ 2D9C              ; registro. ---
 616+ 2D9C              BUCLE_SUBTABLA_DIRECCION:
 617+ 2D9C 21 14 2C         LD HL, INDICE_SUBTABLA_DIRECCION
 618+ 2D9F 7E               LD A, (HL)
 619+ 2DA0 3C               INC A
 620+ 2DA1 E6 03            AND $03
 621+ 2DA3 77               LD (HL), A
 622+ 2DA4 6F               LD L, A
 623+ 2DA5 79               LD A, C
 624+ 2DA6 87               ADD A, A
 625+ 2DA7 87               ADD A, A
 626+ 2DA8 85               ADD A, L
 627+ 2DA9 6F               LD L, A
 628+ 2DAA 26 00            LD H, $00
 629+ 2DAC 19               ADD HL, DE
 630+ 2DAD 7E               LD A, (HL)
 631+ 2DAE FE FF            CP $FF
 632+ 2DB0 28 EA            JR Z, BUCLE_SUBTABLA_DIRECCION             ; centinela "vacio" -> reintenta con la siguiente entrada
 633+ 2DB2 FE FE            CP $FE
 634+ 2DB4 20 03            JR NZ, GUARDAR_SELECTOR_SPRITE_COMECOCOS              ; valor real -> se usa tal cual
 635+ 2DB6 3A 11 2C         LD A, (SELECTOR_SPRITE_COMECOCOS)                 ; centinela "hereda anterior" -> mantiene el valor previo
 636+ 2DB9              GUARDAR_SELECTOR_SPRITE_COMECOCOS:
 637+ 2DB9 32 11 2C         LD (SELECTOR_SPRITE_COMECOCOS), A
 638+ 2DBC              ; --- Descompone el valor anterior (bit 7 aparte del resto) y prepara
 639+ 2DBC              ; los parametros de la tanda de llamadas de abajo: dispara el scroll
 640+ 2DBC              ; (GESTIONAR_SCROLL), y si toca ((FLAG_ENTRADA_BLOQUEADA)=0, teclado no bloqueado)
 641+ 2DBC              ; ejecuta los 2 manejadores de item especial + ACTUALIZAR_DESTELLO_ITEMS +
 642+ 2DBC              ; MOTOR_ACTORES para redibujar. Detalle fino de la descomposicion de
 643+ 2DBC              ; bits sin confirmar. ---
 644+ 2DBC              PREPARAR_SCROLL:
 645+ 2DBC 57               LD D, A
 646+ 2DBD E6 7F            AND $7F
 647+ 2DBF 60               LD H, B
 648+ 2DC0 47               LD B, A
 649+ 2DC1 7A               LD A, D
 650+ 2DC2 E6 80            AND $80
 651+ 2DC4 16 38            LD D, $38
 652+ 2DC6              PREPARAR_LLAMADA_SCROLL:
 653+ 2DC6 1E 40            LD E, $40
 654+ 2DC8 6F               LD L, A
 655+ 2DC9 3A 0F 2C         LD A, (MODO_ESPECIAL_ACTIVO)              ; modo especial activo -> variante de H para el disparo de scroll
 656+ 2DCC A7               AND A
 657+ 2DCD 28 02            JR Z, DISPARAR_SCROLL_Y_ITEMS
 658+ 2DCF 26 00            LD H, $00
 659+ 2DD1              DISPARAR_SCROLL_Y_ITEMS:
 660+ 2DD1 7D               LD A, L
 661+ 2DD2 F5               PUSH AF
 662+ 2DD3 E5               PUSH HL
 663+ 2DD4 D5               PUSH DE
 664+ 2DD5 C5               PUSH BC
 665+ 2DD6 7C               LD A, H
 666+ 2DD7 CD AD 89         CALL GESTIONAR_SCROLL               ; JT_GESTIONAR_SCROLL (disparo de scroll)
 667+ 2DDA 3A C6 8E         LD A, (FLAG_ENTRADA_BLOQUEADA)
 668+ 2DDD A7               AND A                     ; (FLAG_ENTRADA_BLOQUEADA)=0 -> teclado no bloqueado (ver BUSCAR_COLUMNA_HUD/INICIALIZAR_ITEMS_NIVEL) -> procesa items
 669+ 2DDE F5               PUSH AF
 670+ 2DDF CC FE 51         CALL Z, HNDLR_PELMAZOIDE            ; manejador de item especial (instancia 1)
 671+ 2DE2 F1               POP AF
 672+ 2DE3 F5               PUSH AF
 673+ 2DE4 CC A9 54         CALL Z, HNDLR_MARICOCO            ; manejador de item especial (instancia 2)
 674+ 2DE7 F1               POP AF
 675+ 2DE8 CC C0 55         CALL Z, HNDLR_REGPUNANTOSO            ; HNDLR_REGPUNANTOSO (misma condicion)
 676+ 2DEB CD 82 57         CALL ACTUALIZAR_DESTELLO_ITEMS               ; ACTUALIZAR_DESTELLO_ITEMS (siempre, sin condicion)
 677+ 2DEE C1               POP BC
 678+ 2DEF D1               POP DE
 679+ 2DF0 E1               POP HL
 680+ 2DF1 F1               POP AF
 681+ 2DF2 CC 40 84         CALL Z, MOTOR_ACTORES            ; MOTOR_ACTORES -- redibuja el comecocos con la nueva posicion/estado
 682+ 2DF5              ; --- Bucle de pista de tanque/avion: recorre las 3 entradas (6 bytes) de la
 683+ 2DF5              ; tabla de posiciones activas $2C2E (ver REGISTRAR_PISTA_TANQUE_AVION/
 684+ 2DF5              ; AVISAR_PROXIMIDAD_PISTA, que la rellenan). Byte 0 de cada entrada = flag
 685+ 2DF5              ; activo (0 = entrada vacia, sigue con la siguiente); byte 1 codifica
 686+ 2DF5              ; en el bit 0 cual de dos sub-formatos de posicion usar y en el bit 7
 687+ 2DF5              ; (rama PISTA_FORMATO_B/PISTA_FORMATO_B_POS) un signo/orientacion adicional -- calcula la
 688+ 2DF5              ; direccion VRAM final (D/E) y llama a MOTOR_ACTORES para dibujar el
 689+ 2DF5              ; efecto en esa posicion; si el calculo se sale de rango, borra la
 690+ 2DF5              ; entrada (queda libre para una futura pista). ---
 691+ 2DF5 06 03            LD B, $03
 692+ 2DF7 21 2E 2C         LD HL, TABLA_PISTA_TANQUE_AVION
 693+ 2DFA              BUCLE_PISTA_TANQUE_AVION:
 694+ 2DFA C5               PUSH BC
 695+ 2DFB 7E               LD A, (HL)
 696+ 2DFC A7               AND A
 697+ 2DFD 28 37            JR Z, SIGUIENTE_PISTA             ; entrada vacia (byte 0 = 0) -> pasa a la siguiente
 698+ 2DFF 23               INC HL
 699+ 2E00 56               LD D, (HL)
 700+ 2E01 CB 42            BIT 0, D
 701+ 2E03 28 0C            JR Z, PISTA_FORMATO_B              ; formato B (bit0=0) -> rama de abajo
 702+ 2E05 2B               DEC HL                       ; formato A (bit0=1): resta $10 directo, columna fija $40
 703+ 2E06 D6 10            SUB $10
 704+ 2E08 57               LD D, A
 705+ 2E09 1E 40            LD E, $40
 706+ 2E0B 30 22            JR NC, DIBUJAR_PISTA                ; dentro de rango -> sigue a dibujar
 707+ 2E0D 36 00            LD (HL), $00                   ; se sale de rango -> libera la entrada (pista ya no valida)
 708+ 2E0F 18 25            JR SIGUIENTE_PISTA
 709+ 2E11              PISTA_FORMATO_B:
 710+ 2E11 CB 7E            BIT 7, (HL)                  ; formato B, sub-caso por el bit 7 (signo/orientacion)
 711+ 2E13 2B               DEC HL
 712+ 2E14 28 0B            JR Z, PISTA_FORMATO_B_POS                  ; bit7=0 -> resta $08 (rama de abajo la usa sumando)
 713+ 2E16 D6 08            SUB $08
 714+ 2E18 5F               LD E, A
 715+ 2E19 FE 08            CP $08
 716+ 2E1B 30 0F            JR NC, PISTA_FILA_FIJA                   ; dentro de rango -> sigue a dibujar
 717+ 2E1D 36 00            LD (HL), $00                      ; fuera de rango -> libera la entrada
 718+ 2E1F 18 15            JR SIGUIENTE_PISTA
 719+ 2E21              PISTA_FORMATO_B_POS:
 720+ 2E21 C6 08            ADD A, $08                    ; bit7=1 -> suma $08 en vez de restar
 721+ 2E23 5F               LD E, A
 722+ 2E24 FE 70            CP $70
 723+ 2E26 38 04            JR C, PISTA_FILA_FIJA                   ; dentro de rango -> sigue a dibujar
 724+ 2E28 36 00            LD (HL), $00                     ; fuera de rango -> libera la entrada
 725+ 2E2A 18 0A            JR SIGUIENTE_PISTA
 726+ 2E2C              PISTA_FILA_FIJA:
 727+ 2E2C 5F               LD E, A
 728+ 2E2D 16 38            LD D, $38                    ; fila fija $38 para los dos sub-casos de formato B
 729+ 2E2F              DIBUJAR_PISTA:
 730+ 2E2F 77               LD (HL), A
 731+ 2E30 06 1A            LD B, $1A
 732+ 2E32 AF               XOR A
 733+ 2E33 CD 40 84         CALL MOTOR_ACTORES               ; MOTOR_ACTORES
 734+ 2E36              SIGUIENTE_PISTA:
 735+ 2E36 23               INC HL
 736+ 2E37 23               INC HL
 737+ 2E38 C1               POP BC
 738+ 2E39 10 BF            DJNZ BUCLE_PISTA_TANQUE_AVION
 739+ 2E3B C9               RET
