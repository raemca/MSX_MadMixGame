3713+ 5C80              ; --- CORREGIDO (nombre historico "helper de fuente/patron" no
3714+ 5C80              ; encajaba): pone (ACUMULADOR_TECLAS_MENU) a 0 y llama a ESCANEAR_FILAS_TECLADO
3715+ 5C80              ; (madmix1_body.asm, $8E5A) con su propia tabla TABLA_TECLAS_MENU_PRINCIPAL (6
3716+ 5C80              ; parejas, todas fila $F0 -- 6 teclas de navegacion del menu
3717+ 5C80              ; principal), devolviendo en E el bitmask de esas 6 teclas. El
3718+ 5C80              ; llamador (REINICIAR_TIMEOUT_MENU/ACTUALIZAR_MENU_PRINCIPAL) comprueba bit a bit el resultado justo
3719+ 5C80              ; despues para mover el cursor del menu -- es el LECTOR DE TECLAS DEL
3720+ 5C80              ; MENU PRINCIPAL, no nada relacionado con fuentes. Candidato a
3721+ 5C80              ; renombrar (p.ej. LEER_TECLAS_MENU_PRINCIPAL) en una futura ronda. ---
3722+ 5C80              LEER_TECLAS_MENU_PRINCIPAL:                   ; $5C80
3723+ 5C80 DD 21 93 5C      LD IX, TABLA_TECLAS_MENU_PRINCIPAL
3724+ 5C84 E5               PUSH HL
3725+ 5C85 21 9F 5C         LD HL, ACUMULADOR_TECLAS_MENU
3726+ 5C88 36 00            LD (HL), $00
3727+ 5C8A 1E 00            LD E, $00
3728+ 5C8C 06 06            LD B, $06
3729+ 5C8E CD 5A 8E         CALL ESCANEAR_FILAS_TECLADO
3730+ 5C91 E1               POP HL
3731+ 5C92 C9               RET
3732+ 5C93
3733+ 5C93                  ; $5C93-$5C9E (12 bytes, tabla IX): 6 parejas fila/mascara para
3734+ 5C93                  ; ESCANEAR_FILAS_TECLADO, todas fila $F0 -- las 6 teclas de
3735+ 5C93                  ; seleccion del menu principal. Cada RL E desplaza los bits ya
3736+ 5C93                  ; leidos (ver ESCANEAR_FILAS_TECLADO en madmix1_body.asm), asi que
3737+ 5C93                  ; la PRIMERA pareja de esta tabla acaba en el bit MAS ALTO del
3738+ 5C93                  ; resultado (E) y la ULTIMA en el bit 0 -- el orden de comprobacion
3739+ 5C93                  ; en ACTUALIZAR_MENU_PRINCIPAL/DESPACHAR_ACCION_MENU va "al reves"
3740+ 5C93                  ; del orden de la tabla. Las parejas 4 y 5 son IDENTICAS (misma
3741+ 5C93                  ; fila/mascara) -- leen la misma tecla dos veces; el bit de la
3742+ 5C93                  ; pareja 4 (bit 2 del resultado) no se comprueba en ningun sitio.
3743+ 5C93              TABLA_TECLAS_MENU_PRINCIPAL:
3744+ 5C93 F0 10            DB $F0,$10                 ; -> bit 5 del resultado: opcion 4 (demo)
3745+ 5C95 F0 02            DB $F0,$02                 ; -> bit 4: opcion 2 (joystick)
3746+ 5C97 F0 04            DB $F0,$04                 ; -> bit 3: opcion 1 (teclado)
3747+ 5C99 F0 08            DB $F0,$08                 ; -> bit 2: sin uso (nunca comprobado)
3748+ 5C9B F0 08            DB $F0,$08                 ; -> bit 1: opcion 3 (redefine teclas) -- misma tecla que la pareja anterior
3749+ 5C9D F0 01            DB $F0,$01                 ; -> bit 0: "0 JUGAR" (reanuda la partida)
3750+ 5C9F
3751+ 5C9F              ; --- Rutina suelta: limpia el area principal de VRAM (patrones,
3752+ 5C9F              ; $2000-$37FF via FILVRM) tras rellenar el borde. Dos puntos de
3753+ 5C9F              ; entrada: caida normal (NOP, no relleno) y LIMPIAR_VRAM_AREA_JUEGO ($5CA0,
3754+ 5C9F              ; el que usan el resto de llamadas -- salta directo al CALL). El
3755+ 5C9F              ; opcode de este NOP ($00) se reutiliza ademas como
3756+ 5C9F              ; ACUMULADOR_TECLAS_MENU (byte de trabajo de LEER_TECLAS_MENU_PRINCIPAL,
3757+ 5C9F              ; direccionado directamente, sin pasar nunca por aqui como codigo). ---
3758+ 5C9F              ACUMULADOR_TECLAS_MENU:                ; $5C9F
3759+ 5C9F 00               NOP
3760+ 5CA0              LIMPIAR_VRAM_AREA_JUEGO:                      ; $5CA0
3761+ 5CA0 CD 8C 5B         CALL RELLENAR_SOLIDO_AREA_JUEGO_BUFFER_VRAM
3762+ 5CA3 21 00 20         LD HL, $2000               ; tabla de patrones de VRAM (inicio)
3763+ 5CA6 01 00 18         LD BC, 6144                 ; $2000-$37FF, tabla de patrones completa
3764+ 5CA9 3E 01            LD A, $01                 ; patron solido: bit 0 activo en cada byte (no es un contador)
3765+ 5CAB CD 31 89         CALL FILVRM              ; equivalente a la rutina FILVRM del BIOS de MSX
3766+ 5CAE C9               RET
