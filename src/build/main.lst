 106  C350                  INCLUDE "load_cas/test_bin_body.asm"
# file opened: test_bin_body.asm
   1+ C350              ; ============================================================
   2+ C350              ;  TEST.BIN (version de cinta, Topo Soft 1987/88) - MSX1
   3+ C350              ;  Motor de deteccion de RAM/slots -- 253 bytes, extraido del
   4+ C350              ;  bloque "TEST  " del .cas de 1988 (start=$C350 end=$C44C exec=$C350)
   5+ C350              ;  y desensamblado byte a byte con Z80Dasm.exe (sin ambiguedad de
   6+ C350              ;  offset, disasm limpio de principio a fin).
   7+ C350              ;
   8+ C350              ;  Invocado por LOAD.BIN (ver load_bin_body.asm) como primer paso,
   9+ C350              ;  antes de tocar la cinta: recorre las combinaciones de slot
  10+ C350              ;  primario/secundario de las paginas $4000 y $8000 (escritura
  11+ C350              ;  complementaria $20/$FA, patron clasico de deteccion de RAM en
  12+ C350              ;  MSX via ENASLT) y guarda dos configuraciones de slot resultantes
  13+ C350              ;  en SLOT_PRIMARIO_A/EXPTBL_COMPLEMENTO_A/SLOT_PRIMARIO_B/
  14+ C350              ;  EXPTBL_COMPLEMENTO_B ($E290-$E293) -- LOAD.BIN las aplica luego con
  15+ C350              ;  las familias APLICAR_SLOT_ORIGINAL_PAGINA_x/APLICAR_SLOT_PAGINA_x
  16+ C350              ;  (ver load_bin_body.asm).
  17+ C350              ;
  18+ C350              ;  Detalle no trivial encontrado al desensamblar: el bloque final
  19+ C350              ;  (ENASLT_EXTENDIDO, $C3D2-$C44C, 122 bytes) es una PLANTILLA que
  20+ C350              ;  nunca se ejecuta en su posicion original -- se copia con LDIR a
  21+ C350              ;  una zona de trabajo transitoria en $AFC8 (fuera del alcance de
  22+ C350              ;  este proyecto, no pertenece al juego) y solo se ejecuta desde
  23+ C350              ;  ahi. Sus saltos CALL/JP absolutos ya estan escritos para la
  24+ C350              ;  direccion FINAL post-reubicacion ($AFxx/$Bxxx) -- se han dejado
  25+ C350              ;  como hex literal (imprescindible para no romper la fidelidad de
  26+ C350              ;  bytes) con un comentario indicando a que punto de este mismo
  27+ C350              ;  bloque equivalen. Sus saltos JR/DJNZ, al ser relativos, SI se
  28+ C350              ;  han convertido a etiquetas reales (funcionan igual reubicados o
  29+ C350              ;  no).
  30+ C350              ; Ingeniería inversa, herramientas y documentación de este proyecto: Rafael Eduardo Martín Candial (raemca@hotmail.com)
  31+ C350              ; ============================================================
  32+ C350
  33+ C350              DETECTAR_SLOTS_RAM:
  34+ C350 F3               DI
  35+ C351 3A 00 80         LD A, ($8000)            ; guarda el byte original de $8000 (se
  36+ C354                                            ; sobreescribe durante el test de RAM, se
  37+ C354                                            ; restaura al final)
  38+ C354 F5               PUSH AF
  39+ C355 CD 95 C3         CALL GUARDAR_CONFIG_SLOT_A
  40+ C358 21 24 00         LD HL, $0024            ; ENASLT (rutina ROM estandar de cambio de slot)
  41+ C35B 22 B3 C3         LD (DETECTAR_RAM_PAGINA.OPERANDO_ENASLT_AUTOMODIFICADO), HL
  42+ C35E 21 00 40         LD HL, $4000              ; pagina 1 ($4000-$7FFF)
  43+ C361 CD A7 C3         CALL DETECTAR_RAM_PAGINA
  44+ C364 21 00 80         LD HL, $8000              ; pagina 2 ($8000-$BFFF)
  45+ C367 CD A7 C3         CALL DETECTAR_RAM_PAGINA
  46+ C36A 21 D2 C3         LD HL, ENASLT_EXTENDIDO     ; plantilla a reubicar (ver cabecera)
  47+ C36D 11 C8 AF         LD DE, $AFC8             ; zona de trabajo transitoria, fuera del juego
  48+ C370 01 7A 00         LD BC, 122                ; bytes (tamano de ENASLT_EXTENDIDO)
  49+ C373 ED B0            LDIR
  50+ C375 21 C8 AF         LD HL, $AFC8               ; misma zona de trabajo transitoria de arriba
  51+ C378 22 B3 C3         LD (DETECTAR_RAM_PAGINA.OPERANDO_ENASLT_AUTOMODIFICADO), HL  ; repunta el CALL
  52+ C37B                                            ; auto-modificado a la copia reubicada
  53+ C37B 21 00 00         LD HL, $0000               ; pagina 0 ($0000-$3FFF)
  54+ C37E CD A7 C3         CALL DETECTAR_RAM_PAGINA            ; ahora vía la copia reubicada
  55+ C381 CD 9A C3         CALL GUARDAR_CONFIG_SLOT_B
  56+ C384 3A 90 E2         LD A, (SLOT_PRIMARIO_A)
  57+ C387 D3 A8            OUT ($A8), A             ; restaura slot primario (puerto de conmutacion MSX)
  58+ C389 3A 91 E2         LD A, (EXPTBL_COMPLEMENTO_A)
  59+ C38C 32 FF FF         LD ($FFFF), A            ; EXPTBL (variable de sistema MSX)
  60+ C38F F1               POP AF
  61+ C390 32 00 80         LD ($8000), A            ; restaura el byte original guardado al principio
  62+ C393 FB               EI
  63+ C394 C9               RET
  64+ C395
  65+ C395              ; --- $E290-$E293: 4 bytes de RAM libre (fuera de cualquier binario del
  66+ C395              ; proyecto) usados como variable de trabajo COMPARTIDA con
  67+ C395              ; load_bin_body.asm -- este fichero las escribe (aqui abajo), aquel las
  68+ C395              ; lee (familias APLICAR_SLOT_ORIGINAL_PAGINA_x/APLICAR_SLOT_PAGINA_x). ---
  69+ C395              SLOT_PRIMARIO_A:         EQU $E290
  70+ C395              EXPTBL_COMPLEMENTO_A:    EQU $E291
  71+ C395              SLOT_PRIMARIO_B:         EQU $E292
  72+ C395              EXPTBL_COMPLEMENTO_B:    EQU $E293
  73+ C395
  74+ C395              GUARDAR_CONFIG_SLOT_A:
  75+ C395 21 90 E2         LD HL, SLOT_PRIMARIO_A
  76+ C398 18 03            JR GUARDAR_SLOT_COMUN
  77+ C39A              GUARDAR_CONFIG_SLOT_B:
  78+ C39A 21 92 E2         LD HL, SLOT_PRIMARIO_B
  79+ C39D              GUARDAR_SLOT_COMUN:
  80+ C39D DB A8            IN A, ($A8)               ; lee el slot primario activo (puerto de
  81+ C39F                                            ; conmutacion MSX)
  82+ C39F 77               LD (HL), A
  83+ C3A0 23               INC HL
  84+ C3A1 3A FF FF         LD A, ($FFFF)            ; EXPTBL
  85+ C3A4 2F               CPL
  86+ C3A5 77               LD (HL), A
  87+ C3A6 C9               RET
  88+ C3A7
  89+ C3A7              DETECTAR_RAM_PAGINA:
  90+ C3A7 3E 80            LD A, $80                 ; byte de configuracion empaquetado para
  91+ C3A9                                            ; ENASLT (formato ROM: slot primario en bits
  92+ C3A9                                            ; 0-1, indicador de subslot en bit 2); $80
  93+ C3A9                                            ; arranca con el bit superior puesto
  94+ C3A9 0E 04            LD C, 4                   ; 4 combinaciones de slot secundario
  95+ C3AB              .BUCLE_SLOT_SECUNDARIO:
  96+ C3AB E6 83            AND $83                   ; conserva el bit superior + los 2 bits de
  97+ C3AD                                            ; slot primario, limpia el resto antes de
  98+ C3AD                                            ; empezar una nueva vuelta del bucle interno
  99+ C3AD 06 04            LD B, 4                   ; 4 combinaciones de slot primario
 100+ C3AF              .BUCLE_SLOT_PRIMARIO:
 101+ C3AF F5               PUSH AF
 102+ C3B0 C5               PUSH BC
 103+ C3B1 E5               PUSH HL
 104+ C3B2 CD               DB $CD                    ; CALL -- opcode fijo, operando de abajo automodificado
 105+ C3B3              .OPERANDO_ENASLT_AUTOMODIFICADO:
 106+ C3B3 24 00            DW $0024                  ; ENASLT al principio, copia reubicada en $AFC8
 107+ C3B5                                             ; despues (ver DETECTAR_SLOTS_RAM)
 108+ C3B5 E1               POP HL
 109+ C3B6 36 20            LD (HL), $20               ; patron de prueba #1 (ver cabecera:
 110+ C3B8                                            ; "escritura complementaria $20/$FA")
 111+ C3B8 7E               LD A, (HL)
 112+ C3B9 FE 20            CP $20                     ; si no se lee lo escrito, no hay RAM real
 113+ C3BB                                            ; en esta combinacion de slot -- siguiente
 114+ C3BB 20 07            JR NZ, .SIGUIENTE_COMBINACION
 115+ C3BD 36 FA            LD (HL), $FA               ; patron de prueba #2
 116+ C3BF 7E               LD A, (HL)
 117+ C3C0 FE FA            CP $FA                     ; los dos patrones cuadran -> RAM confirmada
 118+ C3C2 28 0B            JR Z, .RAM_ENCONTRADA
 119+ C3C4              .SIGUIENTE_COMBINACION:
 120+ C3C4 C1               POP BC
 121+ C3C5 F1               POP AF
 122+ C3C6 C6 04            ADD A, $04                 ; avanza el campo de 2 bits del slot
 123+ C3C8                                            ; primario dentro del byte empaquetado (bit 2)
 124+ C3C8 10 E5            DJNZ .BUCLE_SLOT_PRIMARIO
 125+ C3CA 3C               INC A
 126+ C3CB 0D               DEC C
 127+ C3CC 20 DD            JR NZ, .BUCLE_SLOT_SECUNDARIO
 128+ C3CE C9               RET
 129+ C3CF              .RAM_ENCONTRADA:
 130+ C3CF C1               POP BC
 131+ C3D0 F1               POP AF
 132+ C3D1 C9               RET
 133+ C3D2
 134+ C3D2              ; --- Plantilla reubicable (ver cabecera): 122 bytes, copiada tal
 135+ C3D2              ; cual a $AFC8 en tiempo de ejecucion, nunca ejecutada aqui mismo. ---
 136+ C3D2              ENASLT_EXTENDIDO:
 137+ C3D2 CD E8 AF         CALL $AFE8                ; = ENASLT_EXTENDIDO_MASCARA_SLOT_PRIMARIO tras reubicarse en $AFC8
 138+ C3D5 FA D5 AF         JP M, $AFD5                ; = ENASLT_EXTENDIDO_GESTIONAR_SUBSLOT tras reubicarse en $AFC8
 139+ C3D8 DB A8            IN A, ($A8)                ; caso sin subslot: lee el registro de
 140+ C3DA                                            ; slot primario actual
 141+ C3DA A1               AND C                      ; limpia los 2 bits de la pagina afectada
 142+ C3DB                                            ; (mascara calculada por MASCARA_SLOT_PRIMARIO)
 143+ C3DB B0               OR B                       ; inserta el nuevo valor de slot en esos bits
 144+ C3DC D3 A8            OUT ($A8), A               ; aplica el resultado al puerto de slot primario
 145+ C3DE C9               RET
 146+ C3DF              ENASLT_EXTENDIDO_GESTIONAR_SUBSLOT:
 147+ C3DF E5               PUSH HL
 148+ C3E0 CD 0C B0         CALL $B00C                 ; = ENASLT_EXTENDIDO_MASCARA_SUBSLOT tras reubicarse en $AFC8
 149+ C3E3 4F               LD C, A
 150+ C3E4 06 00            LD B, 0                   ; BC = extension a 16 bits de C (indice en tabla)
 151+ C3E6 7D               LD A, L
 152+ C3E7 A4               AND H
 153+ C3E8 B2               OR D
 154+ C3E9 21 C5 FC         LD HL, $FCC5                ; variable de sistema MSX (zona de trabajo)
 155+ C3EC 09               ADD HL, BC
 156+ C3ED 77               LD (HL), A
 157+ C3EE E1               POP HL
 158+ C3EF 79               LD A, C
 159+ C3F0 18 E0            JR ENASLT_EXTENDIDO
 160+ C3F2              ; --- Calcula la pareja de mascaras AND(C)/OR(B) para escribir el
 161+ C3F2              ; numero de slot primario (2 bits) en la posicion correcta del
 162+ C3F2              ; registro de slot, segun la pagina de memoria en H. No verificado
 163+ C3F2              ; bit a bit al 100%, pero la estructura (aislar num. de pagina,
 164+ C3F2              ; desplazar una mascara base esa cantidad de posiciones, replicar el
 165+ C3F2              ; valor via suma modular de $55) es consistente en toda la funcion. ---
 166+ C3F2              ENASLT_EXTENDIDO_MASCARA_SLOT_PRIMARIO:
 167+ C3F2 F5               PUSH AF
 168+ C3F3 7C               LD A, H
 169+ C3F4 07               RLCA
 170+ C3F5 07               RLCA
 171+ C3F6 E6 03            AND $03                    ; aisla el numero de pagina (0-3) tras
 172+ C3F8                                            ; rotar los bits 7-6 de H a los bits 1-0
 173+ C3F8 5F               LD E, A
 174+ C3F9 3E C0            LD A, $C0                  ; mascara base (bits 7-6), se ira
 175+ C3FB                                            ; desplazando segun la pagina
 176+ C3FB              .BUCLE_DESPLAZAR_MASCARA:
 177+ C3FB 07               RLCA
 178+ C3FC 07               RLCA
 179+ C3FD 1D               DEC E
 180+ C3FE F2 F1 AF         JP P, $AFF1                  ; = ENASLT_EXTENDIDO_MASCARA_SLOT_PRIMARIO.BUCLE_DESPLAZAR_MASCARA tras reubicarse en $AFC8
 181+ C401 5F               LD E, A
 182+ C402 2F               CPL
 183+ C403 4F               LD C, A                     ; mascara AND final (excluye la pagina objetivo)
 184+ C404 F1               POP AF
 185+ C405 F5               PUSH AF
 186+ C406 E6 03            AND $03                     ; numero de slot primario a insertar (0-3)
 187+ C408 3C               INC A
 188+ C409 47               LD B, A
 189+ C40A 3E AB            LD A, $AB                   ; semilla para replicar el valor de slot en
 190+ C40C                                            ; la posicion correcta via suma modular
 191+ C40C              .BUCLE_REPLICAR_MASCARA:
 192+ C40C C6 55            ADD A, $55                  ; paso de replicacion ($55 = 01010101)
 193+ C40E 10 FC            DJNZ .BUCLE_REPLICAR_MASCARA
 194+ C410 57               LD D, A
 195+ C411 A3               AND E
