   3+ 8400              START:
   4+ 8400 31 F0 FF         LD SP, $FFF0
   5+ 8403              ; --- Tabla de saltos (API publica del motor), 12 entradas JP --
   6+ 8403              ; Direcciones ESTATICAS tal cual el binario original (verificado
   7+ 8403              ; byte a byte contra el desensamblado en FISICO\ORI\MADMIX1.ASM).
   8+ 8403              ; La primera entrada es esta misma JP (START cae directamente en
   9+ 8403              ; ella, no hay una JP duplicada como se penso en un borrador
  10+ 8403              ; anterior).
  11+ 8403 C3 24 8F     JT_INICIO:                                     JP INICIO                                     ; arranque real del motor, nunca retorna (confirmado)
  12+ 8406 C3 40 84     JT_MOTOR_ACTORES:                              JP MOTOR_ACTORES                              ; motor de actores/render sub-pixel de personajes (confirmado, ver mas abajo)
  13+ 8409 C3 9B 89     JT_RESET_CONTADOR_ACTORES:                     JP RESET_CONTADOR_ACTORES                     ; XOR A / LD ($8437),A / RET (confirmado)
  14+ 840C C3 A0 89     JT_WAIT_VBLANK:                                JP WAIT_VBLANK                                ; confirmado
  15+ 840F C3 1B 88     JT_ACTIVAR_INTERRUPCION:                       JP ACTIVAR_INTERRUPCION_MODO_1                ; identificado, ver mas abajo; INICIO lo llama directo al empezar
  16+ 8412 C3 3C 8E     JT_LEER_ENTRADA:                               JP LEER_ENTRADA                               ; identificado, ver mas abajo
  17+ 8415 C3 70 8D     JT_DIBUJAR_MARCADOR_PUNTOS:                    JP DIBUJAR_MARCADOR_PUNTOS                    ; identificado, ver mas abajo
  18+ 8418 C3 AD 89     JT_GESTIONAR_SCROLL:                           JP GESTIONAR_SCROLL                           ; identificado, ver mas abajo
  19+ 841B C3 34 8C     JT_REDIBUJAR_PANTALLA_COMPLETA_BUFFER_VRAM:    JP REDIBUJAR_PANTALLA_COMPLETA_BUFFER_VRAM    ; identificado, ver mas abajo
  20+ 841E C3 1B 8D     JT_REDIBUJAR_LOSETA_BUFFER_VRAM:               JP REDIBUJAR_LOSETA_BUFFER_VRAM               ; confirmado
  21+ 8421 C3 B6 8C     JT_MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA:          JP MAPEAR_LOSETA_RELATIVA_A_ABSOLUTA           ; confirmado
  22+ 8424 C3 DA 8C     JT_CONSULTAR_TIPO_LOSETA:                      JP CONSULTAR_TIPO_LOSETA                      ; confirmado
  23+ 8427
  24+ 8427                  ; Hueco $8427-$8430 (9 bytes, no 2 -- corregido tras arreglar el
  25+ 8427                  ; ORG de la cabecera, ver arriba): todo ceros en el original,
  26+ 8427                  ; probablemente relleno. El primer byte (MODO_ENTRADA) se reutiliza
  27+ 8427                  ; en RAM como selector de teclado/joystick para LEER_ENTRADA.
  28+ 8427              MODO_ENTRADA:
  29+ 8427 00 00 00...      DS $8430-$, $00
  30+ 8430
  31+ 8430 00           FRAME_FLAG: DB 0                  ; semaforo real de ENTRADA_INTERRUPCION_VBLANK, direccion confirmada 0x8430
  32+ 8431
  33+ 8431                  ; Hueco $8431-$8440 (15 bytes): CONFIRMADO todo ceros en el
  34+ 8431                  ; original (desensamblado real via Z80Dasm.exe). Es zona de
  35+ 8431                  ; variables en RAM en tiempo de ejecucion (varias direcciones
  36+ 8431                  ; de aqui dentro, como $8437/$843A/$843E/$843F, se usan como
  37+ 8431                  ; scratch en MOTOR_ACTORES mas abajo), no relleno de fichero.
  38+ 8431 00 00 00...      DS $8440-$, $00
  39+ 8440
  40+ 8440              ; ==============================================================
  41+ 8440              ;  JT_MOTOR_ACTORES (0x8440) -- MOTOR DE ACTORES, transcrito byte a byte
  42+ 8440              ;  completo (0x8440-0x87FF) desde el desensamblado fiable de
  43+ 8440              ;  Z80Dasm.exe -begin 7 -offset 8400. Ver FINDINGS.md, seccion
  44+ 8440              ;  "JT_MOTOR_ACTORES (0x8440-0x8800)" para el analisis narrativo completo,
  45+ 8440              ;  y "Estudio... familia JTS2_" para el detalle del renombrado de
  46+ 8440              ;  todas las etiquetas internas (JTS2_xxxx -> nombres reales de abajo).
  47+ 8440              ;  Resumen de lo que SI se entiende:
  48+ 8440              ;   - Entrada: valida un rango de coordenadas (guardas contra
  49+ 8440              ;     10/64/4/116) antes de continuar; si esta fuera de rango,
  50+ 8440              ;     vuelve pronto (posible filtro "esta este actor en pantalla").
  51+ 8440              ;   - $8437 = contador de actores activos (confirmado, ver
  52+ 8440              ;     RESET_CONTADOR_ACTORES y el volcado de RAM en vivo). Aqui se INCREMENTA
  53+ 8440              ;     (0x8529) al crear un actor nuevo.
  54+ 8440              ;   - IX = $92E3 + ($8437_antes_de_incrementar) * 12: el array de
  55+ 8440              ;     actores activos es de verdad esta tabla, con registros de
  56+ 8440              ;     12 bytes. Campos usados: IX+0/1=posicion pantalla (HL),
  57+ 8440              ;     IX+2/3=direccion buffer (resultado de CALCULAR_DIRECCION_MASCARA_ACTOR),
  58+ 8440              ;     IX+4=contador/tamaÃ±o, IX+5/6=puntero CURSOR de salida en RAM
  59+ 8440              ;     baja (ver mas abajo, direccion CORREGIDA -- antes se penso
  60+ 8440              ;     que era "fuente de graficos", es al reves), IX+7/8/9=tres
  61+ 8440              ;     bytes de TABLA_MASCARA_RECORTE_BORDE ($87FB) indexada por
  62+ 8440              ;     posicion horizontal.
  63+ 8440              ;   - CORREGIDO: CAPTURAR_MASCARAS_ACTOR copia DESDE el buffer de
  64+ 8440              ;     CALCULAR_DIRECCION_MASCARA_ACTOR (IX+2/3, calculado a partir de la posicion del
  65+ 8440              ;     actor) HACIA el cursor en RAM baja ($0500 en adelante,
  66+ 8440              ;     IX+5/6/$8438) -- NO al reves. El truco esta en el EX DE,HL
  67+ 8440              ;     justo antes del LDI: LDI copia (HL)->(DE), y tras el EX,
  68+ 8440              ;     HL=buffer y DE=cursor. NUEVO (cruzado con el hallazgo "Zona
  69+ 8440              ;     0xDC00" de TABLA_RLE_MARCO_CARAMELO/madmix1_body.asm:4440): ese buffer en
  70+ 8440              ;     $DC00+ es la MISMA tabla que sostiene el marco decorativo, leida
  71+ 8440              ;     ahi como pares de MASCARAS AND/OR de composicion de sprite
  72+ 8440              ;     contra el fondo -- asi que lo que hace esta rutina es CAPTURAR
  73+ 8440              ;     (prefetch) las mascaras que le tocan a cada actor de este frame
  74+ 8440              ;     hacia el cursor, no "guardar el fondo para restaurarlo" como se
  75+ 8440              ;     penso en un principio. Explica por que buscar sus bytes en la
  76+ 8440              ;     ROM (MADMIX1.BIN, MADMIX.SCR, incluso el .dsk completo) no
  77+ 8440              ;     encontro nada aparte -- no es un recurso estatico propio, reusa
  78+ 8440              ;     la tabla del marco. El cursor ($8438) avanza cada vez que se
  79+ 8440              ;     crea un actor, extrayendo 3 bytes de cada bloque de 32 desde
  80+ 8440              ;     el buffer hasta agotar IX+4 bloques.
  81+ 8440              ;   - CONTINUAR_CAPTURA_MASCARAS_ACTORES (0x86BB) recorre el array de actores hacia atras
  82+ 8440              ;     (paso de -12 bytes) decrementando $8437 como contador de
  83+ 8440              ;     iteracion -- una carga de recursos repartida en varias
  84+ 8440              ;     llamadas (cooperativa), no de una sola vez.
  85+ 8440              ;   - Renderizado: dos rutinas casi identicas (DIBUJAR_FILA_DESPLAZADA_DERECHA en
  86+ 8440              ;     0x85C1 con desplazamiento a la derecha, DIBUJAR_FILA_DESPLAZADA_IZQUIERDA en
  87+ 8440              ;     0x8624 con desplazamiento a la izquierda) hacen scroll de
  88+ 8440              ;     sub-pixel bit a bit sobre franjas de 32 bytes de paso,
  89+ 8440              ;     usando el SP como puntero rapido (intercambiando la pila via
  90+ 8440              ;     EXX) para mezclar con AND/OR contra el fondo. Selecionadas
  91+ 8440              ;     via JP (IY) segun la posicion del actor.
  92+ 8440              ;   - COMPONER_ACTORES_EN_BUFFER (0x8779) es otra pasada distinta sobre
  93+ 8440              ;     el mismo array, con codigo automodificable (escribe los
  94+ 8440              ;     campos IX+7/8/9 directamente en operandos de instrucciones
  95+ 8440              ;     mas adelante) y un patron de mezcla OR mas simple (sin
  96+ 8440              ;     desplazamiento de bits) en 6 iteraciones -- probablemente
  97+ 8440              ;     dibuja SIN el suavizado de sub-pixel. Termina reseteando
  98+ 8440              ;     $8437 a 0. SIN CALL/JP confirmado en el codigo ya transcrito --
  99+ 8440              ;     su llamador real sigue sin identificar (ver FINDINGS.md).
 100+ 8440              ;   - INVERTIR_BITS_PATRON_ACTOR (0x86FA) y INVERTIR_ORDEN_BYTES_PATRON_ACTOR
 101+ 8440              ;     (0x873A): dos rutinas auxiliares llamadas condicionalmente segun
 102+ 8440              ;     bits de un valor D calculado a partir de $8436 y (HL). HIPOTESIS
 103+ 8440              ;     (sin confirmar en vivo): juntas completan un volteo horizontal
 104+ 8440              ;     del patron del actor -- la primera invierte el ORDEN DE LOS BITS
 105+ 8440              ;     de cada byte (RLC/RRA x8, el truco clasico), la segunda invierte
 106+ 8440              ;     el ORDEN DE LOS BYTES de la fila; mismo convenio bit7=volteo
 107+ 8440              ;     horizontal ya confirmado en SELECTOR_SPRITE_COMECOCOS.
 108+ 8440              ;  Direcciones estaticas confirmadas (no se ha necesitado PHASE
 109+ 8440              ;  para nada de esto, ver hallazgo del volcado de RAM en vivo).
